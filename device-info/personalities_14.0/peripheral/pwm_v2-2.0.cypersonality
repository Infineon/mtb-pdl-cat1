      <Member name="pwm_tc_sync_kill_dt" value="`${pwmtcsynckilldt}`" guard="defined (CY_IP_MXS40TCPWM)" />
      <Member name="pwm_sync_kill_dt" value="`${pwmsynckilldt}`" guard="defined (CY_IP_MXS40TCPWM)" />
