    <!-- Periods 1..3 down-leg compare dot gating. Periods 1 and 3 are odd (main period), period 2 is even (Period1). A compare that exceeds its period is clamped to the period for placement, which would otherwise pin the down dot on the boundary (on top of the terminal-count / underflow event); gate each period's down dot with the same in-period test used by the up dots and the slot 4..8 down dots so an out-of-range compare draws no down dot. In-range configurations keep these flags true, so the dots stay shown exactly as before. -->
    <ParamString id="cuw_showC0downP1" name="cuw_showC0downP1" group="General" default="`${cuw_c0inPerDn ? cuw_showC0down : 0.0}`" visible="false" editable="false" desc="" />
