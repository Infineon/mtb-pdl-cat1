    <ParamChoice id="UnderflowMode" name="Underflow Action" group="PWM signal behavior" default="`${(PwmAlignment eq CY_TCPWM_PWM_LEFT_ALIGN) ? CY_TCPWM_PWM_ACTION_NO_CHANGE : (((PwmAlignment eq CY_TCPWM_PWM_CENTER_ALIGN) || (PwmAlignment eq CY_TCPWM_PWM_ASYMMETRIC_ALIGN)) &amp;&amp; SwapUnderflowOverflow) ? CY_TCPWM_PWM_ACTION_SET : CY_TCPWM_PWM_ACTION_CLEAR}`" visible="`${pPwmNePrs}`" editable="`${pPwmNePrs &amp;&amp; (PwmAlignment eq CY_TCPWM_PWM_CUSTOM_ALIGN)}`" desc="Determines the effect of a counter underflow event (COUNTER reaches 0) on the line_out and line_compl_out output signals.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Set:&lt;/b&gt; sets line_out to 1 (line_compl_out to 0).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Clear:&lt;/b&gt; sets line_out to 0 (line_compl_out to 1).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Invert:&lt;/b&gt; toggles line_out and line_compl_out.&lt;/li&gt;&lt;li&gt;&lt;b&gt;No Change:&lt;/b&gt; leaves line_out and line_compl_out unchanged.&lt;/li&gt;&lt;/ul&gt;">
      <Entry name="Set" value="CY_TCPWM_PWM_ACTION_SET" visible="true" />
      <Entry name="Clear" value="CY_TCPWM_PWM_ACTION_CLEAR" visible="true" />
      <Entry name="Invert" value="CY_TCPWM_PWM_ACTION_INVERT" visible="true" />
