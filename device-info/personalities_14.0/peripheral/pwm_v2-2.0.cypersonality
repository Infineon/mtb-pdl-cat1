         high=285/low=310, line_compl high=335/low=360). The reused logical levels (cuw_p1L*/cuw_p2*) are drawn HIGH when
         the line_out level is 1; InvertPwm swaps the line_out high/low coordinate, InvertPwm_n swaps line_compl (whose
         logical level is the complement of line_out, so line_out==1 => line_compl drawn LOW by default). Mirrors the main
         custom SVG's y_line_vis_* / y_line_n_vis_* helpers for this view's own coordinates. dtc_rXo1/dtc_rXo0 = line_out
         Y when the out level is 1 / 0; dtc_rXc1/dtc_rXc0 = line_compl Y when the out level is 1 / 0. -->
    <ParamString id="dtc_r0o1" name="dtc_r0o1" group="General" default="`${InvertPwm ? 140 : 115}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r0o0" name="dtc_r0o0" group="General" default="`${InvertPwm ? 115 : 140}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r0c1" name="dtc_r0c1" group="General" default="`${InvertPwm_n ? 165 : 190}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r0c0" name="dtc_r0c0" group="General" default="`${InvertPwm_n ? 190 : 165}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r1o1" name="dtc_r1o1" group="General" default="`${InvertPwm ? 310 : 285}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r1o0" name="dtc_r1o0" group="General" default="`${InvertPwm ? 285 : 310}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r1c1" name="dtc_r1c1" group="General" default="`${InvertPwm_n ? 335 : 360}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r1c0" name="dtc_r1c0" group="General" default="`${InvertPwm_n ? 360 : 335}`" visible="false" editable="false" desc="" />

    <!-- Source-aware DT-view level->Y helpers (Output Lines Source mux folded into the stacked dead-time rows, mirroring the main custom SVG's y_line_vis_* helpers). dtc_rXoR1 / dtc_rXoR0 = line_out Y for a raw PWM level of 1 / 0; dtc_rXcR1 / dtc_rXcR0 = line_compl_out Y. Row 0 = Period 0 (main source line_out_source / linecompl_out_source); row 1 = Period 1 (effective even source cuw_loSrcE / cuw_lcSrcE). Constant 0 -> displayed-low pixel, Constant 1 -> displayed-high pixel, PWM -> raw level, Inverted PWM -> complemented level (both flow through the invert-aware dtc_rX?1/?0 building blocks); GPIO Port Default and Motif Out pin the line flat to the geometric low pixel (140/310 line_out, 190/360 line_compl). Default PWM / Inverted PWM sources reduce to the plain active/low coordinates, keeping untouched configs byte-identical. -->
    <ParamString id="dtc_r0oR1" name="dtc_r0oR1" group="General" default="`${(line_out_source eq CY_TCPWM_OUTPUT_CONSTANT_0) ? dtc_r0o0 : (line_out_source eq CY_TCPWM_OUTPUT_CONSTANT_1) ? dtc_r0o1 : ((line_out_source eq CY_TCPWM_OUTPUT_PORT_DEFAULT) || (line_out_source eq CY_TCPWM_OUTPUT_SOURCE_MOTIF)) ? 140 : (line_out_source eq CY_TCPWM_OUTPUT_INVERTED_PWM_SIGNAL) ? dtc_r0o0 : dtc_r0o1}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r0oR0" name="dtc_r0oR0" group="General" default="`${(line_out_source eq CY_TCPWM_OUTPUT_CONSTANT_0) ? dtc_r0o0 : (line_out_source eq CY_TCPWM_OUTPUT_CONSTANT_1) ? dtc_r0o1 : ((line_out_source eq CY_TCPWM_OUTPUT_PORT_DEFAULT) || (line_out_source eq CY_TCPWM_OUTPUT_SOURCE_MOTIF)) ? 140 : (line_out_source eq CY_TCPWM_OUTPUT_INVERTED_PWM_SIGNAL) ? dtc_r0o1 : dtc_r0o0}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r0cR1" name="dtc_r0cR1" group="General" default="`${(linecompl_out_source eq CY_TCPWM_OUTPUT_CONSTANT_0) ? dtc_r0c1 : (linecompl_out_source eq CY_TCPWM_OUTPUT_CONSTANT_1) ? dtc_r0c0 : ((linecompl_out_source eq CY_TCPWM_OUTPUT_PORT_DEFAULT) || (linecompl_out_source eq CY_TCPWM_OUTPUT_SOURCE_MOTIF)) ? 190 : (linecompl_out_source eq CY_TCPWM_OUTPUT_INVERTED_PWM_SIGNAL) ? dtc_r0c1 : dtc_r0c0}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r0cR0" name="dtc_r0cR0" group="General" default="`${(linecompl_out_source eq CY_TCPWM_OUTPUT_CONSTANT_0) ? dtc_r0c1 : (linecompl_out_source eq CY_TCPWM_OUTPUT_CONSTANT_1) ? dtc_r0c0 : ((linecompl_out_source eq CY_TCPWM_OUTPUT_PORT_DEFAULT) || (linecompl_out_source eq CY_TCPWM_OUTPUT_SOURCE_MOTIF)) ? 190 : (linecompl_out_source eq CY_TCPWM_OUTPUT_INVERTED_PWM_SIGNAL) ? dtc_r0c0 : dtc_r0c1}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r1oR1" name="dtc_r1oR1" group="General" default="`${(cuw_loSrcE eq CY_TCPWM_OUTPUT_CONSTANT_0) ? dtc_r1o0 : (cuw_loSrcE eq CY_TCPWM_OUTPUT_CONSTANT_1) ? dtc_r1o1 : ((cuw_loSrcE eq CY_TCPWM_OUTPUT_PORT_DEFAULT) || (cuw_loSrcE eq CY_TCPWM_OUTPUT_SOURCE_MOTIF)) ? 310 : (cuw_loSrcE eq CY_TCPWM_OUTPUT_INVERTED_PWM_SIGNAL) ? dtc_r1o0 : dtc_r1o1}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r1oR0" name="dtc_r1oR0" group="General" default="`${(cuw_loSrcE eq CY_TCPWM_OUTPUT_CONSTANT_0) ? dtc_r1o0 : (cuw_loSrcE eq CY_TCPWM_OUTPUT_CONSTANT_1) ? dtc_r1o1 : ((cuw_loSrcE eq CY_TCPWM_OUTPUT_PORT_DEFAULT) || (cuw_loSrcE eq CY_TCPWM_OUTPUT_SOURCE_MOTIF)) ? 310 : (cuw_loSrcE eq CY_TCPWM_OUTPUT_INVERTED_PWM_SIGNAL) ? dtc_r1o1 : dtc_r1o0}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r1cR1" name="dtc_r1cR1" group="General" default="`${(cuw_lcSrcE eq CY_TCPWM_OUTPUT_CONSTANT_0) ? dtc_r1c1 : (cuw_lcSrcE eq CY_TCPWM_OUTPUT_CONSTANT_1) ? dtc_r1c0 : ((cuw_lcSrcE eq CY_TCPWM_OUTPUT_PORT_DEFAULT) || (cuw_lcSrcE eq CY_TCPWM_OUTPUT_SOURCE_MOTIF)) ? 360 : (cuw_lcSrcE eq CY_TCPWM_OUTPUT_INVERTED_PWM_SIGNAL) ? dtc_r1c1 : dtc_r1c0}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_r1cR0" name="dtc_r1cR0" group="General" default="`${(cuw_lcSrcE eq CY_TCPWM_OUTPUT_CONSTANT_0) ? dtc_r1c1 : (cuw_lcSrcE eq CY_TCPWM_OUTPUT_CONSTANT_1) ? dtc_r1c0 : ((cuw_lcSrcE eq CY_TCPWM_OUTPUT_PORT_DEFAULT) || (cuw_lcSrcE eq CY_TCPWM_OUTPUT_SOURCE_MOTIF)) ? 360 : (cuw_lcSrcE eq CY_TCPWM_OUTPUT_INVERTED_PWM_SIGNAL) ? dtc_r1c0 : dtc_r1c1}`" visible="false" editable="false" desc="" />

    <!-- Start-of-period-1 activation dead time (the FIRST TC, boundary period 0 -&gt; period 1). The displayed
         line that ACTIVATES (rises) when crossing into period 1 is held at its inactive level for the buffered
         dead time before it rises. This is the SAME shift term that cuw_b1_Os / cuw_b1_Cs add over cuw_b1, but
         computed directly (no running-max / cap): when the signal only switches on the TC there is no mid-period
         compare vertex to carry the running-max floor into period 1, and the period-1 base vertices collapse onto
         the period end, so the boundary activation delay would otherwise be absorbed and the buffered dead time
         would not appear at the start of period 1. Zero (no hold) when the displayed line does not activate at the
         first TC, so non-activating diagrams are unchanged. -->
    <ParamString id="dtc_stO1px" name="dtc_stO1px" group="General" default="`${loMainIsInv ? ((cuw_p1L4 &gt; cuw_p1end) ? cuw_dtOutPxE : 0) : (loMainIsC0 ? 0 : (loMainIsC1 ? 0 : ((cuw_p1end &gt; cuw_p1L4) ? cuw_dtOutPxE : 0)))}`" visible="false" editable="false" desc="" />
    <ParamString id="dtc_stC1px" name="dtc_stC1px" group="General" default="`${lcMainIsInv ? ((cuw_p1L4 &gt; cuw_p1end) ? cuw_dtComplPxE : 0) : (lcMainIsC0 ? 0 : (lcMainIsC1 ? 0 : ((cuw_p1end &gt; cuw_p1L4) ? cuw_dtComplPxE : 0)))}`" visible="false" editable="false" desc="" />

    <!-- Dead Time PWM Waveform Visualization - CUSTOM MODE ONLY.
         The first two periods are drawn stacked (Period 0 on top, Period 1
         below), each upscaled to the full graph width. This view reuses the
         SAME event model as the main custom-align waveform: the dead-time
         shifted vertices (_O for line_out, _C for line_compl) and the logical
         level sequence (cuw_p1L*/cuw_p2L*) are linearly remapped into each row,
         so every configured event is shown and dead time appears on every
         switching (activating) edge. AMC support: line_compl uses its own dead
         time only when AMC is present (pCntAMC). Shadow copy: Period 1 uses the
         buffered dead time only when Enable Swapping is disabled (pDtP2). -->
    <ParamImage id="pwmDeadtimeCustomAlignImage"
      name="PWM Visualization"
      group="Advanced"
      desc=""
      visible="`${pPwmNePrs &amp;&amp; (PwmMode eq CY_TCPWM_PWM_MODE_DEADTIME)}`"
      position="OUTSET"
      default="`${cy_libs_path()}`/device-info/personalities_14.0/svg/pwm_deadtime_custom_align_v2.svg">

      <!-- ===== Header labels ===== -->
      <Substitution name="P1_PERIOD_VAL" value="`${Period0}`" />
      <Substitution name="P2_NAME"       value="`${EnablePeriodSwap ? &quot;Period Buffered&quot; : &quot;Period&quot;}`" />
      <Substitution name="P2_PERIOD_VAL" value="`${EnablePeriodSwap ? Period1 : Period0}`" />
      <Substitution name="AMC_NOTE"      value="`${pCntAMC ? &quot;AMC: line_out and line_compl have independent dead time&quot; : &quot;line_out dead time applies to both outputs&quot;}`" />
      <!-- One Shot: the counter runs a single period, so only the first period is meaningful -
           hide the second (buffered) period row and word the title/subtitle accordingly. -->
      <Substitution name="SHOW_P1"       value="`${cuw_oneShot ? 0.0 : 1.0}`" />
      <Substitution name="DT_TITLE"      value="`${cuw_oneShot ? &quot;Dead Time PWM (first counter period)&quot; : &quot;Dead Time PWM (first 2 counter periods)&quot;}`" />
      <Substitution name="DT_P0_OUT"     value="`${DeadClocks}`" />
      <Substitution name="DT_P0_CMPL"    value="`${pCntAMC ? DeadClocks_compl : DeadClocks}`" />
      <Substitution name="DT_P1_OUT"     value="`${pDtP2}`" />
      <Substitution name="DT_P1_CMPL"    value="`${pCntAMC ? pDtP2Compl : pDtP2}`" />

      <!-- ===== Period 0 (top): line_out vertex X (dead-time shifted, _O), remapped ===== -->
      <Substitution name="R0_OA" value="`${min(770, max(70, 70 + (cuw_xA1_Os - 80) * dtc_s0))}`" />
      <Substitution name="R0_OB" value="`${min(770, max(70, 70 + (cuw_xB1_Os - 80) * dtc_s0))}`" />
      <Substitution name="R0_OR" value="`${min(770, max(70, 70 + (cuw_rx1_Os - 80) * dtc_s0))}`" />
      <Substitution name="R0_OC" value="`${min(770, max(70, 70 + (cuw_xC1_Os - 80) * dtc_s0))}`" />
      <Substitution name="R0_OD" value="`${min(770, max(70, 70 + (cuw_xD1_Os - 80) * dtc_s0))}`" />
      <Substitution name="R0_OE" value="`${min(770, max(70, 70 + (cuw_b1_Os  - 80) * dtc_s0))}`" />

      <!-- Period 0 start-of-count activation dead time. At count start line_out is inactive and the line that
           actually activates (rises) at the very start is held at its PRE-activation (inactive) level from x=70
           to R0_?DTW - the dead-time window where both outputs are low - then rises to its settled start level.
           R0_?DTY is that pre-activation level = the OPPOSITE of the settled start level R0_YL0 / R0_NYL0, so a
           real count-start toggle produces a visible dip while a constant (non-toggling) source collapses it
           (opposite == settled). The G-flags gate the DT / DT_N start brackets, set only when the count-start
           dead time is wide enough to draw. Widths use the (active) count-start dead-time floors cuw_stOs/cuw_stCs
           remapped into the row. This is the period-0 (count start) counterpart of the period-1 start-hold
           (R1_ODTW/R1_CDTW), e.g. the DT_N delay before line_compl activates on the first counter period. -->
      <Substitution name="R0_ODTW" value="`${min(770, max(70, 70 + (cuw_stOs - 80) * dtc_s0))}`" />
      <Substitution name="R0_CDTW" value="`${min(770, max(70, 70 + (cuw_stCs - 80) * dtc_s0))}`" />
      <Substitution name="R0_GODT" value="`${(((cuw_stOs - 80) * dtc_s0) &gt; 0.5) &amp;&amp; ((cuw_p1L0 eq 1 ? dtc_r0oR0 : dtc_r0oR1) ne (cuw_p1L0 eq 1 ? dtc_r0oR1 : dtc_r0oR0)) ? 1.0 : 0.0}`" />
      <Substitution name="R0_GCDT" value="`${(((cuw_stCs - 80) * dtc_s0) &gt; 0.5) &amp;&amp; ((cuw_p1L0 eq 1 ? dtc_r0cR0 : dtc_r0cR1) ne (cuw_p1L0 eq 1 ? dtc_r0cR1 : dtc_r0cR0)) ? 1.0 : 0.0}`" />
      <Substitution name="R0_ODTY" value="`${((((cuw_stOs - 80) * dtc_s0) &gt; 0.5) &amp;&amp; ((cuw_p1L0 eq 1 ? dtc_r0oR0 : dtc_r0oR1) ne (cuw_p1L0 eq 1 ? dtc_r0oR1 : dtc_r0oR0))) ? (cuw_p1L0 eq 1 ? dtc_r0oR0 : dtc_r0oR1) : (cuw_p1L0 eq 1 ? dtc_r0oR1 : dtc_r0oR0)}`" />
      <Substitution name="R0_CDTY" value="`${((((cuw_stCs - 80) * dtc_s0) &gt; 0.5) &amp;&amp; ((cuw_p1L0 eq 1 ? dtc_r0cR0 : dtc_r0cR1) ne (cuw_p1L0 eq 1 ? dtc_r0cR1 : dtc_r0cR0))) ? (cuw_p1L0 eq 1 ? dtc_r0cR0 : dtc_r0cR1) : (cuw_p1L0 eq 1 ? dtc_r0cR1 : dtc_r0cR0)}`" />

      <!-- Period 0 line_out level Y (115=active/high, 140=low) -->
      <Substitution name="R0_YL0"  value="`${cuw_p1L0   eq 1 ? dtc_r0oR1 : dtc_r0oR0}`" />
      <Substitution name="R0_YL1"  value="`${cuw_p1L1   eq 1 ? dtc_r0oR1 : dtc_r0oR0}`" />
      <Substitution name="R0_YL2"  value="`${cuw_p1L2   eq 1 ? dtc_r0oR1 : dtc_r0oR0}`" />
      <Substitution name="R0_YA"   value="`${cuw_p1apex eq 1 ? dtc_r0oR1 : dtc_r0oR0}`" />
      <Substitution name="R0_YL3"  value="`${cuw_p1L3   eq 1 ? dtc_r0oR1 : dtc_r0oR0}`" />
      <Substitution name="R0_YL4"  value="`${cuw_p1L4   eq 1 ? dtc_r0oR1 : dtc_r0oR0}`" />
      <!-- When the boundary (first TC) activation of line_out is delayed by dead time into the 2nd
           period, the level change is drawn at the START of period 1 (R1_ODTW hold), so do NOT redraw
           it at the END of period 0 - hold the pre-boundary level (cuw_p1L4) to the right edge instead.
           Same threshold as the period-1 start-hold (R1_GODT) so the two views stay consistent. -->
      <Substitution name="R0_YEND" value="`${((dtc_stO1px * dtc_s1 &gt; 0.5) &amp;&amp; !cuw_oneShot) ? (cuw_p1L4 eq 1 ? dtc_r0oR1 : dtc_r0oR0) : (cuw_p1end eq 1 ? dtc_r0oR1 : dtc_r0oR0)}`" />

      <!-- Period 0 line_compl vertex X (dead-time shifted, _C), remapped -->
      <Substitution name="R0_CA" value="`${min(770, max(70, 70 + (cuw_xA1_Cs - 80) * dtc_s0))}`" />
      <Substitution name="R0_CB" value="`${min(770, max(70, 70 + (cuw_xB1_Cs - 80) * dtc_s0))}`" />
      <Substitution name="R0_CR" value="`${min(770, max(70, 70 + (cuw_rx1_Cs - 80) * dtc_s0))}`" />
      <Substitution name="R0_CC" value="`${min(770, max(70, 70 + (cuw_xC1_Cs - 80) * dtc_s0))}`" />
      <Substitution name="R0_CD" value="`${min(770, max(70, 70 + (cuw_xD1_Cs - 80) * dtc_s0))}`" />
      <Substitution name="R0_CE" value="`${min(770, max(70, 70 + (cuw_b1_Cs  - 80) * dtc_s0))}`" />

      <!-- Period 0 line_compl level Y (165=active/high, 190=low; inverted) -->
      <Substitution name="R0_NYL0"  value="`${cuw_p1L0   eq 1 ? dtc_r0cR1 : dtc_r0cR0}`" />
      <Substitution name="R0_NYL1"  value="`${cuw_p1L1   eq 1 ? dtc_r0cR1 : dtc_r0cR0}`" />
      <Substitution name="R0_NYL2"  value="`${cuw_p1L2   eq 1 ? dtc_r0cR1 : dtc_r0cR0}`" />
      <Substitution name="R0_NYA"   value="`${cuw_p1apex eq 1 ? dtc_r0cR1 : dtc_r0cR0}`" />
      <Substitution name="R0_NYL3"  value="`${cuw_p1L3   eq 1 ? dtc_r0cR1 : dtc_r0cR0}`" />
      <Substitution name="R0_NYL4"  value="`${cuw_p1L4   eq 1 ? dtc_r0cR1 : dtc_r0cR0}`" />
      <!-- line_compl counterpart of the R0_YEND boundary-edge suppression (delayed into period 1). -->
      <Substitution name="R0_NYEND" value="`${((dtc_stC1px * dtc_s1 &gt; 0.5) &amp;&amp; !cuw_oneShot) ? (cuw_p1L4 eq 1 ? dtc_r0cR1 : dtc_r0cR0) : (cuw_p1end eq 1 ? dtc_r0cR1 : dtc_r0cR0)}`" />

      <!-- Period 0 event marker X (undelayed logical positions), remapped -->
      <Substitution name="R0_EC0U"  value="`${min(770, max(70, 70 + (cuw_xc0_p1  - 80) * dtc_s0))}`" />
      <Substitution name="R0_EC0D"  value="`${min(770, max(70, 70 + (cuw_xc0d_p1 - 80) * dtc_s0))}`" />
      <Substitution name="R0_EC1U"  value="`${min(770, max(70, 70 + (cuw_xc1_p1  - 80) * dtc_s0))}`" />
      <Substitution name="R0_EC1D"  value="`${min(770, max(70, 70 + (cuw_xc1d_p1 - 80) * dtc_s0))}`" />
      <Substitution name="R0_EAPEX" value="`${min(770, max(70, 70 + (cuw_rx1     - 80) * dtc_s0))}`" />

      <!-- Period 0 raw (undelayed) vertex X: start of each dead-time gap.
           Same base positions the _O/_C vertices are shifted from. -->
      <Substitution name="R0_RA" value="`${min(770, max(70, 70 + (cuw_xA1 - 80) * dtc_s0))}`" />
      <Substitution name="R0_RB" value="`${min(770, max(70, 70 + (cuw_xB1 - 80) * dtc_s0))}`" />
      <Substitution name="R0_RR" value="`${min(770, max(70, 70 + (cuw_rx1 - 80) * dtc_s0))}`" />
      <Substitution name="R0_RC" value="`${min(770, max(70, 70 + (cuw_xC1 - 80) * dtc_s0))}`" />
      <Substitution name="R0_RD" value="`${min(770, max(70, 70 + (cuw_xD1 - 80) * dtc_s0))}`" />
      <Substitution name="R0_RE" value="`${min(770, max(70, 70 + (cuw_b1  - 80) * dtc_s0))}`" />

      <!-- Period 0 dead-time gap show-flags: 1 when the remapped shifted (_O/_C)
           vertex is right of the remapped raw vertex (a visible gap after
           clamping), i.e. that activating edge has a drawn dead-time bracket. -->
      <Substitution name="R0_GOA" value="`${(min(770,max(70,70+(cuw_xA1_Os-80)*dtc_s0)) - min(770,max(70,70+(cuw_xA1-80)*dtc_s0))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R0_GOB" value="`${(min(770,max(70,70+(cuw_xB1_Os-80)*dtc_s0)) - min(770,max(70,70+(cuw_xB1-80)*dtc_s0))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R0_GOR" value="`${(min(770,max(70,70+(cuw_rx1_Os-80)*dtc_s0)) - min(770,max(70,70+(cuw_rx1-80)*dtc_s0))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R0_GOC" value="`${(min(770,max(70,70+(cuw_xC1_Os-80)*dtc_s0)) - min(770,max(70,70+(cuw_xC1-80)*dtc_s0))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R0_GOD" value="`${(min(770,max(70,70+(cuw_xD1_Os-80)*dtc_s0)) - min(770,max(70,70+(cuw_xD1-80)*dtc_s0))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R0_GOE" value="`${(min(770,max(70,70+(cuw_b1_Os-80)*dtc_s0)) - min(770,max(70,70+(cuw_b1-80)*dtc_s0))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R0_GCA" value="`${(min(770,max(70,70+(cuw_xA1_Cs-80)*dtc_s0)) - min(770,max(70,70+(cuw_xA1-80)*dtc_s0))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R0_GCB" value="`${(min(770,max(70,70+(cuw_xB1_Cs-80)*dtc_s0)) - min(770,max(70,70+(cuw_xB1-80)*dtc_s0))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R0_GCR" value="`${(min(770,max(70,70+(cuw_rx1_Cs-80)*dtc_s0)) - min(770,max(70,70+(cuw_rx1-80)*dtc_s0))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R0_GCC" value="`${(min(770,max(70,70+(cuw_xC1_Cs-80)*dtc_s0)) - min(770,max(70,70+(cuw_xC1-80)*dtc_s0))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R0_GCD" value="`${(min(770,max(70,70+(cuw_xD1_Cs-80)*dtc_s0)) - min(770,max(70,70+(cuw_xD1-80)*dtc_s0))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R0_GCE" value="`${(min(770,max(70,70+(cuw_b1_Cs-80)*dtc_s0)) - min(770,max(70,70+(cuw_b1-80)*dtc_s0))) &gt; 0.5 ? 1.0 : 0.0}`" />

      <!-- Period 0 event visibility (gated by CC existence on the relevant leg) -->
      <Substitution name="R0_SC0U"  value="`${cuw_cc0Up ? cuw_showC0p1     : 0.0}`" />
      <Substitution name="R0_SC0D"  value="`${cuw_cc0Dn ? cuw_showC0downP1 : 0.0}`" />
      <Substitution name="R0_SC1U"  value="`${cuw_cc1Up ? cuw_showC1p1     : 0.0}`" />
      <Substitution name="R0_SC1D"  value="`${cuw_cc1Dn ? cuw_showC1downP1 : 0.0}`" />
      <Substitution name="R0_SAPEX" value="`${cuw_showOvApex}`" />

      <!-- ===== Period 1 (bottom): line_out vertex X (_O), remapped ===== -->
      <Substitution name="R1_OA" value="`${min(770, max(70, 70 + (cuw_xA2_Os - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_OB" value="`${min(770, max(70, 70 + (cuw_xB2_Os - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_OR" value="`${min(770, max(70, 70 + (cuw_rx3_Os - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_OC" value="`${min(770, max(70, 70 + (cuw_xC2_Os - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_OD" value="`${min(770, max(70, 70 + (cuw_xD2_Os - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_OE" value="`${min(770, max(70, 70 + (cuw_b2_Os  - cuw_b1) * dtc_s1))}`" />

      <!-- Period 1 start-of-period activation dead time (entering first TC). The line that activates on the
           TC into period 1 is held at its PRE-activation (inactive) level from x=70 to R1_?DTW, then rises to
           its period-1 settled level; R1_?DTY is that pre-activation level = the OPPOSITE of the settled start
           level R1_YL0 / R1_NYL0, so a real toggle always produces a visible dip while a constant (non-toggling)
           source collapses it (opposite == settled). The G-flags gate the DT_BUFF / DT_BUFF_N start brackets and
           are only set when the buffered dead time is wide enough to draw. Widths use the remapped buffered dead time. -->
      <Substitution name="R1_ODTW" value="`${min(770, max(70, 70 + dtc_stO1px * dtc_s1))}`" />
      <Substitution name="R1_CDTW" value="`${min(770, max(70, 70 + dtc_stC1px * dtc_s1))}`" />
      <Substitution name="R1_GODT" value="`${((dtc_stO1px * dtc_s1) &gt; 0.5) &amp;&amp; ((cuw_p2L0 eq 1 ? dtc_r1oR0 : dtc_r1oR1) ne (cuw_p2L0 eq 1 ? dtc_r1oR1 : dtc_r1oR0)) ? 1.0 : 0.0}`" />
      <Substitution name="R1_GCDT" value="`${((dtc_stC1px * dtc_s1) &gt; 0.5) &amp;&amp; ((cuw_p2L0 eq 1 ? dtc_r1cR0 : dtc_r1cR1) ne (cuw_p2L0 eq 1 ? dtc_r1cR1 : dtc_r1cR0)) ? 1.0 : 0.0}`" />
      <Substitution name="R1_ODTY" value="`${(((dtc_stO1px * dtc_s1) &gt; 0.5) &amp;&amp; ((cuw_p2L0 eq 1 ? dtc_r1oR0 : dtc_r1oR1) ne (cuw_p2L0 eq 1 ? dtc_r1oR1 : dtc_r1oR0))) ? (cuw_p2L0 eq 1 ? dtc_r1oR0 : dtc_r1oR1) : (cuw_p2L0 eq 1 ? dtc_r1oR1 : dtc_r1oR0)}`" />
      <Substitution name="R1_CDTY" value="`${(((dtc_stC1px * dtc_s1) &gt; 0.5) &amp;&amp; ((cuw_p2L0 eq 1 ? dtc_r1cR0 : dtc_r1cR1) ne (cuw_p2L0 eq 1 ? dtc_r1cR1 : dtc_r1cR0))) ? (cuw_p2L0 eq 1 ? dtc_r1cR0 : dtc_r1cR1) : (cuw_p2L0 eq 1 ? dtc_r1cR1 : dtc_r1cR0)}`" />

      <!-- Period 1 line_out level Y (285=active/high, 310=low) -->
      <Substitution name="R1_YL0"  value="`${cuw_p2L0   eq 1 ? dtc_r1oR1 : dtc_r1oR0}`" />
      <Substitution name="R1_YL1"  value="`${cuw_p2L1   eq 1 ? dtc_r1oR1 : dtc_r1oR0}`" />
      <Substitution name="R1_YL2"  value="`${cuw_p2L2   eq 1 ? dtc_r1oR1 : dtc_r1oR0}`" />
      <Substitution name="R1_YA"   value="`${cuw_p2apex eq 1 ? dtc_r1oR1 : dtc_r1oR0}`" />
      <Substitution name="R1_YL3"  value="`${cuw_p2L3   eq 1 ? dtc_r1oR1 : dtc_r1oR0}`" />
      <Substitution name="R1_YL4"  value="`${cuw_p2L4   eq 1 ? dtc_r1oR1 : dtc_r1oR0}`" />
      <Substitution name="R1_YEND" value="`${cuw_p2end  eq 1 ? dtc_r1oR1 : dtc_r1oR0}`" />

      <!-- Period 1 line_compl vertex X (_C), remapped -->
      <Substitution name="R1_CA" value="`${min(770, max(70, 70 + (cuw_xA2_Cs - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_CB" value="`${min(770, max(70, 70 + (cuw_xB2_Cs - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_CR" value="`${min(770, max(70, 70 + (cuw_rx3_Cs - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_CC" value="`${min(770, max(70, 70 + (cuw_xC2_Cs - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_CD" value="`${min(770, max(70, 70 + (cuw_xD2_Cs - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_CE" value="`${min(770, max(70, 70 + (cuw_b2_Cs  - cuw_b1) * dtc_s1))}`" />

      <!-- Period 1 line_compl level Y (335=active/high, 360=low; inverted) -->
      <Substitution name="R1_NYL0"  value="`${cuw_p2L0   eq 1 ? dtc_r1cR1 : dtc_r1cR0}`" />
      <Substitution name="R1_NYL1"  value="`${cuw_p2L1   eq 1 ? dtc_r1cR1 : dtc_r1cR0}`" />
      <Substitution name="R1_NYL2"  value="`${cuw_p2L2   eq 1 ? dtc_r1cR1 : dtc_r1cR0}`" />
      <Substitution name="R1_NYA"   value="`${cuw_p2apex eq 1 ? dtc_r1cR1 : dtc_r1cR0}`" />
      <Substitution name="R1_NYL3"  value="`${cuw_p2L3   eq 1 ? dtc_r1cR1 : dtc_r1cR0}`" />
      <Substitution name="R1_NYL4"  value="`${cuw_p2L4   eq 1 ? dtc_r1cR1 : dtc_r1cR0}`" />
      <Substitution name="R1_NYEND" value="`${cuw_p2end  eq 1 ? dtc_r1cR1 : dtc_r1cR0}`" />

      <!-- Period 1 event marker X, remapped -->
      <Substitution name="R1_EC0U"  value="`${min(770, max(70, 70 + (cuw_xc0_p2  - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_EC0D"  value="`${min(770, max(70, 70 + (cuw_xc0d_p2 - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_EC1U"  value="`${min(770, max(70, 70 + (cuw_xc1_p2  - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_EC1D"  value="`${min(770, max(70, 70 + (cuw_xc1d_p2 - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_EAPEX" value="`${min(770, max(70, 70 + (cuw_rx3     - cuw_b1) * dtc_s1))}`" />

      <!-- Period 1 raw (undelayed) vertex X: start of each dead-time gap -->
      <Substitution name="R1_RA" value="`${min(770, max(70, 70 + (cuw_xA2 - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_RB" value="`${min(770, max(70, 70 + (cuw_xB2 - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_RR" value="`${min(770, max(70, 70 + (cuw_rx3 - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_RC" value="`${min(770, max(70, 70 + (cuw_xC2 - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_RD" value="`${min(770, max(70, 70 + (cuw_xD2 - cuw_b1) * dtc_s1))}`" />
      <Substitution name="R1_RE" value="`${min(770, max(70, 70 + (cuw_b2  - cuw_b1) * dtc_s1))}`" />

      <!-- Period 1 dead-time gap show-flags -->
