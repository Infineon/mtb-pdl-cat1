      <Substitution name="SHOW_CC1" value="`${pCntCC1 ? 1.0 : 0.0}`" />

      <!-- Graph title: reflects the selected PWM Configurations (PwmAlignment) choice, e.g.
           "PWM Signal Configuration - Left Aligned". The text after the dash matches the Entry
           display name of the currently selected PwmAlignment value. -->
      <Substitution name="PWM_TITLE" value="`${(PwmAlignment eq CY_TCPWM_PWM_LEFT_ALIGN) ? &quot;PWM Signal Configuration - Left Aligned&quot; : (PwmAlignment eq CY_TCPWM_PWM_RIGHT_ALIGN) ? &quot;PWM Signal Configuration - Right Aligned&quot; : (PwmAlignment eq CY_TCPWM_PWM_CENTER_ALIGN) ? &quot;PWM Signal Configuration - Center Aligned&quot; : (PwmAlignment eq CY_TCPWM_PWM_CENTER_TIMEBASED_ALIGN) ? &quot;PWM Signal Configuration - Center Time Based&quot; : (PwmAlignment eq CY_TCPWM_PWM_CENTER_EXTERNAL_EVENT_ALIGN) ? &quot;PWM Signal Configuration - Center External Event&quot; : (PwmAlignment eq CY_TCPWM_PWM_ASYMMETRIC_ALIGN) ? &quot;PWM Signal Configuration - Asymmetric&quot; : (PwmAlignment eq CY_TCPWM_PWM_ASYMMETRIC_CC0_CC1_ALIGN) ? &quot;PWM Signal Configuration - Asymmetric CC0 &amp;amp; CC1&quot; : (PwmAlignment eq CY_TCPWM_PWM_CENTER_ASYMMETRIC_CC0_CC1_ALIGN) ? &quot;PWM Signal Configuration - Center Asymmetric CC0 &amp;amp; CC1&quot; : &quot;PWM Signal Configuration - Custom&quot;}`" />

      <!-- One Shot: SHOW_CONT gates the "continued" counter-graph elements (period-2+ ramp
           segments, asymmetric apex dividers, and the shared/hardcoded event + interrupt dots
           that live past the first period at x = cuw_b1) off at the source. It is 1.0 in
           Continuous (elements draw normally) and 0.0 in One Shot. In the SVG it wraps those
           elements in a nested <g opacity>, which multiplies with each element's own show
           flag, so Continuous is unchanged and One Shot stops the graph after the first
           period without any white masking. -->
      <Substitution name="SHOW_CONT" value="`${cuw_oneShot ? 0.0 : 1.0}`" />

