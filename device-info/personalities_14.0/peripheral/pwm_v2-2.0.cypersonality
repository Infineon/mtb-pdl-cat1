    <!-- Dead-time lead-in gap (becomes T0 when present): in custom Dead Time mode the SELECTED output's first
         activation is delayed by its dead time, so the period starts with a short INACTIVE interval (x=80 ->
         cuw_tgLX0) that would otherwise be unbracketed. cuw_tgGapShow flags it - 1 only when the start edge is
         actually delayed (cuw_tgLX0 &gt; 80) AND that first activation actually persists (seg0's run has positive
         width, cuw_tgLX0 &lt; cuw_tgRunEnd0). When the first activation is fully cancelled by dead time (on-time &lt;
         dead time, so seg0 collapses to zero width), the post-gap level equals the rest/gap level, so there is no
         real edge at cuw_tgLX0: the gap is then suppressed and the following inactive run is extended back to x=80
         via cuw_tgDX (below) so the whole interval shows as one T#. Always 0 in normal PWM where the first interval
         already starts at the period boundary (x=80). cuw_tgGapDur converts the gap pixel width back to counts, which
         equals exactly the selected output's dead-time clocks. When shown the gap is T0 and every following run's T#
         shifts up by one (cuw_tgIdx0 seeds at cuw_tgGapShow; the numeric cuw_tgCnt0 below returns the gap duration). -->
    <ParamString id="cuw_tgGapShow" name="cuw_tgGapShow" group="General" default="`${((cuw_tgLX0 &gt; 80) &amp;&amp; (cuw_tgLX0 &lt; cuw_tgRunEnd0)) ? 1 : 0}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_tgGapDur" name="cuw_tgGapDur" group="General" default="`${max(0, floor((((cuw_tgLX0 - 80) * cuw_maxper) / cuw_tmgPxPer) + 0.5))}`" visible="false" editable="false" desc="" />
