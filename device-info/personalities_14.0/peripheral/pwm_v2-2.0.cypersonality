    <!--HRPWM-->
    <ParamString id="ppca_hrpwm_Ex" name="ppcahrpwmEx" desc="look up expression for hrpwm" group="Internal" default="ppca[0].tcpwm[`${tcpwmInst}`].group[`${pCntGroup}`].cnt[`${cntInstNum}`].hrpwm[0]" visible="false" editable="false" />
