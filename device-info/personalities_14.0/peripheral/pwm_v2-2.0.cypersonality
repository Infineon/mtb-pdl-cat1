    <!-- ================================================================================================ -->
    <!-- CUSTOM MODE WAVEFORM VARIABLES                                                                    -->
    <!-- Simulate the line_out / line_compl_out levels produced by the user-selected TR_PWM_CTRL actions,  -->
    <!-- scaled against the actual Period / Compare values (illustrated for an up-counting timer).         -->
    <!-- ================================================================================================ -->

    <!-- Safe (clamped) period / compare values -->
    <!-- CC0/CC1 match-enable gates for the custom-mode compare-match event dots and waveform line actions. The
         CC0/CC1_MATCH_UP_EN / DOWN_EN bits only have a function when counting up/down (CNT_UPDN1/2, UpDownMode
         2 or 3): they enable/disable the compare match event per leg only while the counter alternates direction.
         In single-direction Count Up or Count Down there is only one leg, so the match always fires and the
         setting is ignored. So the gate is applied only on an AMC group AND in an up/down count mode; otherwise
         (non-AMC, or single-direction counting) the match is shown unconditionally (default behaviour). -->
    <ParamBool id="cuw_cc0Up" name="cuw_cc0Up" group="General" default="`${(pCntAMC &amp;&amp; ((UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_1) || (UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_2))) ? ((Cc0MatchEnable eq 1) || (Cc0MatchEnable eq 3)) : true}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_cc0Dn" name="cuw_cc0Dn" group="General" default="`${(pCntAMC &amp;&amp; ((UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_1) || (UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_2))) ? ((Cc0MatchEnable eq 2) || (Cc0MatchEnable eq 3)) : true}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_cc1Up" name="cuw_cc1Up" group="General" default="`${(pCntAMC &amp;&amp; ((UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_1) || (UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_2))) ? ((Cc1MatchEnable eq 1) || (Cc1MatchEnable eq 3)) : true}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_cc1Dn" name="cuw_cc1Dn" group="General" default="`${(pCntAMC &amp;&amp; ((UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_1) || (UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_2))) ? ((Cc1MatchEnable eq 2) || (Cc1MatchEnable eq 3)) : true}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_period" name="cuw_period" group="General" default="`${(Period0 &lt; 1) ? 1 : Period0}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cmp0" name="cuw_cmp0" group="General" default="`${(Compare0 &lt; 0) ? 0 : ((Compare0 &gt; cuw_period) ? cuw_period : Compare0)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cmp1" name="cuw_cmp1" group="General" default="`${(Compare2 &lt; 0) ? 0 : ((Compare2 &gt; cuw_period) ? cuw_period : Compare2)}`" visible="false" editable="false" desc="" />

    <!-- ============================== PERIOD SWAP (TCPWM v3 dual period registers) ============================== -->
    <!-- With Enable Period Swap the counter alternates its terminal value each period: Period0 -> Period1 -> Period0 -> ... -->
    <!-- Displayed periods 1 and 3 are odd (always Period0); displayed periods 2 and 4 are even (Period1 when swap is enabled, otherwise Period0). -->
    <!-- The counter axis is scaled to the larger of the two periods so the two ramp apex heights differ (mirrors the proportional-height approach used by the other alignment modes). -->
    <!-- Count Up/Down - TC on OVF and UNF exception applies ONLY when the global Swapping Enable is on (true bidirectional swap): the swapped-in Period1 is loaded at the overflow but swaps back at the underflow before it can govern an up-count, so it has NO physical effect. In that case the period graph (counter ramp widths + heights) must stay identical to Enable Period Swap disabled (equal Period0 periods), so cuw_perEven falls back to cuw_period. The swapped-in Period1 is still shown as a floating purple reference line via cuw_per1True / cuw_plYev1 below (the workaround overlay), but it never reshapes the ramp. -->
    <!-- When Swapping Enable is OFF (shadow-copy / persist mode) the buffered Period1 is copied once at the first overflow and held, so it DOES take effect: the period must tile like Count Up/Down - TC on UNF (period 1 = Period0, periods 2+ = buffered Period1). Hence the fallback to cuw_period only fires for pSwapEnableEff, not for the shadow-copy case. -->
    <ParamString id="cuw_perEven" name="cuw_perEven" group="General" default="`${(pSwapEnableEff &amp;&amp; (UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_2)) ? cuw_period : (pPeriodSwapEff ? ((Period1 &lt; 1) ? 1 : Period1) : cuw_period)}`" visible="false" editable="false" desc="" />
    <!-- True buffered Period1 value (independent of the geometry fallback above) - drives the workaround's floating purple 'Period 1' reference line + label so the swapped-in value is still visible in Count Up/Down - TC on OVF and UNF. In every non-asymmetric swap case this equals cuw_perEven, so the existing behavior is unchanged. -->
    <ParamString id="cuw_per1True" name="cuw_per1True" group="General" default="`${(Period1 &lt; 1) ? 1 : Period1}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_maxper" name="cuw_maxper" group="General" default="`${(cuw_period &gt; cuw_perEven) ? cuw_period : cuw_perEven}`" visible="false" editable="false" desc="" />
    <!-- Even-period compare source values. Enable Compare 0/1 Swap acts independently of Enable Period Swap: the even displayed periods (2 and 4) use the buffered compare values (Compare1 buffers Compare0, Compare3 buffers Compare2) whenever the matching Compare swap is enabled, regardless of Period swap. -->
    <ParamString id="cuw_cmp0eSrc" name="cuw_cmp0eSrc" group="General" default="`${pCompare0SwapEff ? Compare1 : Compare0}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cmp1eSrc" name="cuw_cmp1eSrc" group="General" default="`${pCompare1SwapEff ? Compare3 : Compare2}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cmp0e" name="cuw_cmp0e" group="General" default="`${(cuw_cmp0eSrc &lt; 0) ? 0 : ((cuw_cmp0eSrc &gt; cuw_perEven) ? cuw_perEven : cuw_cmp0eSrc)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cmp1e" name="cuw_cmp1e" group="General" default="`${(cuw_cmp1eSrc &lt; 0) ? 0 : ((cuw_cmp1eSrc &gt; cuw_perEven) ? cuw_perEven : cuw_cmp1eSrc)}`" visible="false" editable="false" desc="" />
    <!-- Counter Y level for "counter == period" on the 60..190 ramp axis (60 = max period, 190 = 0), scaled to the larger period -->
    <ParamString id="cuw_plYodd" name="cuw_plYodd" group="General" default="`${190 - (130 * cuw_period) / cuw_maxper}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_plYeven" name="cuw_plYeven" group="General" default="`${190 - (130 * cuw_perEven) / cuw_maxper}`" visible="false" editable="false" desc="" />
    <!-- Counter Y level for the true buffered Period1 value on the SAME ramp axis as the counter (scaled by cuw_maxper). In Count Up/Down - TC on OVF and UNF the ramp axis is Period0 (cuw_maxper == cuw_period), so this floats the purple 'Period 1' reference line at Period1's real height off the (swap-disabled) ramp; when Period1 &gt; Period0 it sits above the Period0 peak. In every non-asymmetric swap case cuw_maxper and cuw_per1True match cuw_perEven, so this equals cuw_plYeven (unchanged). -->
    <ParamString id="cuw_plYev1" name="cuw_plYev1" group="General" default="`${190 - (130 * cuw_per1True) / cuw_maxper}`" visible="false" editable="false" desc="" />
    <!-- Persist-mode odd-period (displayed periods 3/5/7) source values. In persist mode (global Swapping
         Enable OFF, per-register Enable*Swap ON) every period after the first uses the buffered value, so the
         odd periods 3/5/7 render exactly like the even periods (buffered): their period width and ramp apex
         height collapse onto the even-period values. When not in persist mode (global swap ON, or nothing
         enabled) they keep the regular Period0 value = the existing alternating representation. Period 1 is
         NOT redirected (it always shows the first, regular period). -->
    <ParamString id="cuw_perOdd3" name="cuw_perOdd3" group="General" default="`${pAnyPersist ? cuw_perEven : cuw_period}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_plYodd3" name="cuw_plYodd3" group="General" default="`${190 - (130 * cuw_perOdd3) / cuw_maxper}`" visible="false" editable="false" desc="" />

    <!-- Count direction selectors -->
    <ParamBool id="cuw_isDown" name="cuw_isDown" group="General" default="`${UpDownMode eq CY_TCPWM_PWM_COUNT_DOWN}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_isUpDown" name="cuw_isUpDown" group="General" default="`${(UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_1) || (UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_2)}`" visible="false" editable="false" desc="" />

    <!-- Initial counter value (resolved, clamped) and its Y position on the ramp -->
    <ParamString id="cuw_cntInit" name="cuw_cntInit" group="General" default="`${CounterInit eq &quot;period&quot; ? cuw_period : ((CounterInit eq &quot;custom&quot; ? CounterInitCustom : CounterInit) &lt; 0) ? 0 : (((CounterInit eq &quot;custom&quot; ? CounterInitCustom : CounterInit) &gt; cuw_period) ? cuw_period : (CounterInit eq &quot;custom&quot; ? CounterInitCustom : CounterInit))}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_initY" name="cuw_initY" group="General" default="`${190 - (130 * cuw_cntInit) / cuw_maxper}`" visible="false" editable="false" desc="" />

    <!-- ============================== HORIZONTAL AUTO-FIT (8-period rescale) ============================== -->
    <!-- The graph draws at most 8 displayed periods (slot1 + slots 2..8). When the period values are such that
         all 8 fit inside the 80..800 window AND end before the right edge (i.e. the 8-period tiling ran out of
         slots while window space remained, leaving a trailing gap), the whole horizontal axis is stretched so
         those 8 periods exactly fill the window.
         cuw_spanU = the raw, UN-scaled pixel span of the 8 periods from x=80, measured at the base 240 px-per-cuw_maxper
         rate (first period + 4 even + 3 odd). The stretch is applied to the HORIZONTAL axis only, by shrinking the
         pixel-per-count denominator: cuw_maxperX = cuw_maxper / cuw_xScale. Every X (pixel) conversion uses cuw_maxperX
         while every Y conversion keeps cuw_maxper, so ramp heights are unchanged. cuw_xScale = 1.0 (identical to before)
         unless all 8 periods fit with a trailing gap (cuw_spanU &lt; 720); it is also forced to 1.0 in One-Shot (only the
         first period is drawn). Note this gap is only reachable when one period is much larger than the other AND the
         smaller one is buffered into every following slot (persist mode: Swapping Enable OFF + Enable Period Swap ON);
         in the normal alternating case one period is always full width (240 px) so 8 periods never leave a gap. At the
         trigger the 8 periods span exactly 720 px (x=80..800). Because cuw_tmgPxPer is likewise multiplied by
         cuw_xScale, the timing / dead-time duration reconstructions (px -&gt; counts via '/ cuw_tmgPxPer') stay physically
         correct after the stretch. -->
    <ParamString id="cuw_spanU" name="cuw_spanU" group="General" default="`${((cuw_isUpDown ? ((240.0 * cuw_period) - (120.0 * cuw_cntInit)) : (cuw_isDown ? (240.0 * cuw_cntInit) : (240.0 * (cuw_period - cuw_cntInit)))) + (960.0 * cuw_perEven) + (720.0 * cuw_perOdd3)) / cuw_maxper}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_xScale" name="cuw_xScale" group="General" default="`${cuw_oneShot ? 1.0 : ((cuw_spanU &lt; 720.0) ? (720.0 / ((cuw_spanU &lt; 1.0) ? 1.0 : cuw_spanU)) : 1.0)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_maxperX" name="cuw_maxperX" group="General" default="`${cuw_maxper / cuw_xScale}`" visible="false" editable="false" desc="" />

    <!-- Period boundary X positions. Every displayed period's WIDTH is proportional to its period value at a uniform pixel-per-count rate (240 px = the larger of the two periods, cuw_maxper), so when Period0 / Period1 differ (Enable Period Swap) the odd (Period0) and even (Period1) periods render at different widths - the larger period is 240 px wide, the smaller is narrower. This keeps the ramp slope uniform (the Y axis already scales by cuw_maxper) and bounds the layout (each width &lt;= 240 px, so b3 &lt;= 800 with a non-negative trailing-period tail). The first displayed period is additionally shortened/lengthened to reflect the initial counter value. When period swap is off cuw_maxper == cuw_period so every full period is 240 px (identical to before). -->
    <ParamString id="cuw_p1w" name="cuw_p1w" group="General" default="`${cuw_isUpDown ? ((240.0 * cuw_period) - (120.0 * cuw_cntInit)) / cuw_maxperX : (cuw_isDown ? (240.0 * cuw_cntInit) / cuw_maxperX : (240.0 * (cuw_period - cuw_cntInit)) / cuw_maxperX)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_b1" name="cuw_b1" group="General" default="`${80 + cuw_p1w}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_b2" name="cuw_b2" group="General" default="`${cuw_b1 + (240.0 * cuw_perEven) / cuw_maxperX}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_b3" name="cuw_b3" group="General" default="`${cuw_b2 + (240.0 * cuw_perOdd3) / cuw_maxperX}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_m2" name="cuw_m2" group="General" default="`${(cuw_b1 + cuw_b2) / 2}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_m3" name="cuw_m3" group="General" default="`${(cuw_b2 + cuw_b3) / 2}`" visible="false" editable="false" desc="" />

    <!-- ============================== DYNAMIC PERIOD TILING (slots 4..8) ============================== -->
    <!-- The fixed-width 80..800 window is tiled with as many alternating Period0 (odd) / Period1 (even) cycles as fit at the uniform rate. When the period values are small (so each period is much narrower than 240 px) more than the first three displayed periods become visible; the extra periods (displayed periods 4..8) are laid down here, each one period wide, and the last one to cross x=800 is clipped at the window edge. When both periods are large (== cuw_maxper) every period is 240 px so b3 == 800 and slots 4..8 collapse to zero width at x=800 (hidden), giving exactly the original 3-period picture. -->
    <ParamString id="cuw_wOdd" name="cuw_wOdd" group="General" default="`${(240.0 * cuw_perOdd3) / cuw_maxperX}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_wEven" name="cuw_wEven" group="General" default="`${(240.0 * cuw_perEven) / cuw_maxperX}`" visible="false" editable="false" desc="" />
    <!-- Raw (un-clipped) boundaries, then the same clipped at the 800 window edge. Slot 4 = even (Period1), 5 = odd, 6 = even, 7 = odd, 8 = even. -->
    <ParamString id="cuw_rb4" name="cuw_rb4" group="General" default="`${cuw_b3 + cuw_wEven}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_b4" name="cuw_b4" group="General" default="`${(cuw_rb4 &gt; 800) ? 800 : cuw_rb4}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rb5" name="cuw_rb5" group="General" default="`${cuw_rb4 + cuw_wOdd}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_b5" name="cuw_b5" group="General" default="`${(cuw_rb5 &gt; 800) ? 800 : cuw_rb5}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rb6" name="cuw_rb6" group="General" default="`${cuw_rb5 + cuw_wEven}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_b6" name="cuw_b6" group="General" default="`${(cuw_rb6 &gt; 800) ? 800 : cuw_rb6}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rb7" name="cuw_rb7" group="General" default="`${cuw_rb6 + cuw_wOdd}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_b7" name="cuw_b7" group="General" default="`${(cuw_rb7 &gt; 800) ? 800 : cuw_rb7}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rb8" name="cuw_rb8" group="General" default="`${cuw_rb7 + cuw_wEven}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_b8" name="cuw_b8" group="General" default="`${(cuw_rb8 &gt; 800) ? 800 : cuw_rb8}`" visible="false" editable="false" desc="" />
    <!-- Slot midpoints (used for the up/down triangle apex of each extra slot). The apex is the TRUE peak of the
         full slot, i.e. the midpoint of the RAW (un-clipped) boundaries, only then clamped to the 800 window edge.
         Using the clipped boundaries here would pull the apex of a window-clipped slot LEFT of its own up-leg
         compare vertices (which sit at rawBoundary +/- offset), so the line_out / line_compl_out polyline would run
         right to the compare then back left to the apex - a vertical doubling-back (high and low at the same X) at
         the end of the graph. This is exposed by Enable Period Swap, which gives the odd/even periods different
         widths and so leaves a partially-clipped slot at the window edge. For fully-visible slots rbN == bN, so
         these reduce exactly to the previous clipped-boundary midpoints (unchanged). -->
    <ParamString id="cuw_m4" name="cuw_m4" group="General" default="`${(((cuw_b3 + cuw_rb4) / 2) &gt; 800) ? 800 : ((cuw_b3 + cuw_rb4) / 2)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_m5" name="cuw_m5" group="General" default="`${(((cuw_rb4 + cuw_rb5) / 2) &gt; 800) ? 800 : ((cuw_rb4 + cuw_rb5) / 2)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_m6" name="cuw_m6" group="General" default="`${(((cuw_rb5 + cuw_rb6) / 2) &gt; 800) ? 800 : ((cuw_rb5 + cuw_rb6) / 2)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_m7" name="cuw_m7" group="General" default="`${(((cuw_rb6 + cuw_rb7) / 2) &gt; 800) ? 800 : ((cuw_rb6 + cuw_rb7) / 2)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_m8" name="cuw_m8" group="General" default="`${(((cuw_rb7 + cuw_rb8) / 2) &gt; 800) ? 800 : ((cuw_rb7 + cuw_rb8) / 2)}`" visible="false" editable="false" desc="" />
    <!-- Per-slot visibility (1.0 when the slot starts before the window edge, else 0.0). A slot is visible when the previous boundary has not yet reached 800. -->
    <ParamString id="cuw_showP4" name="cuw_showP4" group="General" default="`${cuw_oneShot ? 0.0 : ((cuw_b3 &lt; 800) ? 1.0 : 0.0)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_showP5" name="cuw_showP5" group="General" default="`${cuw_oneShot ? 0.0 : ((cuw_b4 &lt; 800) ? 1.0 : 0.0)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_showP6" name="cuw_showP6" group="General" default="`${cuw_oneShot ? 0.0 : ((cuw_b5 &lt; 800) ? 1.0 : 0.0)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_showP7" name="cuw_showP7" group="General" default="`${cuw_oneShot ? 0.0 : ((cuw_b6 &lt; 800) ? 1.0 : 0.0)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_showP8" name="cuw_showP8" group="General" default="`${cuw_oneShot ? 0.0 : ((cuw_b7 &lt; 800) ? 1.0 : 0.0)}`" visible="false" editable="false" desc="" />

    <!-- Counter ramp vertices: odd vertices are the ramp peak (mid-period peak for the up/down triangle); even vertices are the period boundary. The Y level pattern depends on the count direction. -->
    <ParamString id="cuw_rx1" name="cuw_rx1" group="General" default="`${cuw_isUpDown ? (80 + (120.0 * (cuw_period - cuw_cntInit)) / cuw_maxperX) : cuw_b1}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rx3" name="cuw_rx3" group="General" default="`${cuw_isUpDown ? cuw_m2 : cuw_b2}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rx5" name="cuw_rx5" group="General" default="`${cuw_isUpDown ? cuw_m3 : cuw_b3}`" visible="false" editable="false" desc="" />
    <!-- Per-displayed-period ramp vertex Y values (period swap aware). rya = the ramp-peak vertex (rx1/rx3/rx5), ryb = the period boundary vertex (b1/b2/b3). -->
    <!-- Up / Up-Down: the peak vertex sits at the period level (plY), the boundary at 0 (190). Down: the peak (0) sits at 190, the boundary reloads to the NEXT period level. -->
    <ParamString id="cuw_rya1" name="cuw_rya1" group="General" default="`${cuw_isDown ? 190 : cuw_plYodd}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rya2" name="cuw_rya2" group="General" default="`${cuw_isDown ? 190 : cuw_plYeven}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rya3" name="cuw_rya3" group="General" default="`${cuw_isDown ? 190 : cuw_plYodd3}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_ryb1" name="cuw_ryb1" group="General" default="`${cuw_isDown ? cuw_plYeven : 190}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_ryb2" name="cuw_ryb2" group="General" default="`${cuw_isDown ? cuw_plYodd3 : 190}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_ryb3" name="cuw_ryb3" group="General" default="`${cuw_isDown ? cuw_plYeven : 190}`" visible="false" editable="false" desc="" />
    <!-- Extra slots 4..8 ramp vertices (slot 4 = even, 5 = odd, 6 = even, 7 = odd, 8 = even). Apex X = mid-slot for the up/down triangle, else the period boundary. Apex Y alternates even/odd peak; boundary Y reloads to the next slot's level when counting down. All X are already clipped at 800 (zero-width for hidden slots). -->
    <ParamString id="cuw_rx7" name="cuw_rx7" group="General" default="`${cuw_isUpDown ? cuw_m4 : cuw_b4}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rx9" name="cuw_rx9" group="General" default="`${cuw_isUpDown ? cuw_m5 : cuw_b5}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rx11" name="cuw_rx11" group="General" default="`${cuw_isUpDown ? cuw_m6 : cuw_b6}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rx13" name="cuw_rx13" group="General" default="`${cuw_isUpDown ? cuw_m7 : cuw_b7}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rx15" name="cuw_rx15" group="General" default="`${cuw_isUpDown ? cuw_m8 : cuw_b8}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rya4" name="cuw_rya4" group="General" default="`${cuw_isDown ? 190 : cuw_plYeven}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rya5" name="cuw_rya5" group="General" default="`${cuw_isDown ? 190 : cuw_plYodd3}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rya6" name="cuw_rya6" group="General" default="`${cuw_isDown ? 190 : cuw_plYeven}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rya7" name="cuw_rya7" group="General" default="`${cuw_isDown ? 190 : cuw_plYodd3}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rya8" name="cuw_rya8" group="General" default="`${cuw_isDown ? 190 : cuw_plYeven}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_ryb4" name="cuw_ryb4" group="General" default="`${cuw_isDown ? cuw_plYodd3 : 190}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_ryb5" name="cuw_ryb5" group="General" default="`${cuw_isDown ? cuw_plYeven : 190}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_ryb6" name="cuw_ryb6" group="General" default="`${cuw_isDown ? cuw_plYodd3 : 190}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_ryb7" name="cuw_ryb7" group="General" default="`${cuw_isDown ? cuw_plYeven : 190}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_ryb8" name="cuw_ryb8" group="General" default="`${cuw_isDown ? cuw_plYodd3 : 190}`" visible="false" editable="false" desc="" />

    <!-- True (un-clipped) ramp geometry for the extra slots 4..8. cuw_tm* are the real mid-period peaks (Count Up/Down apex) and cuw_rax* are the real apex X used to DRAW the ramp (mid-period for up/down, real boundary otherwise). These may exceed 800. The Qt SVG renderer IGNORES clip-path on <line>/<polyline> (it only honours it on <text>), so the ramp CANNOT be clipped by an SVG clipPath - it would simply draw past x=800. Instead the visible endpoints are clipped ANALYTICALLY below (cuw_cax/cay/cbx/cby): each segment that crosses x=800 has its far end replaced by the exact intersection (x=800, interpolated Y), which preserves the true slope AND stops drawing at the window edge. The shared cuw_rx*/CU_RX* (apex event dots + waveform) are intentionally left clamped and untouched. -->
    <ParamString id="cuw_tm4" name="cuw_tm4" group="General" default="`${(cuw_b3 + cuw_rb4) / 2}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_tm5" name="cuw_tm5" group="General" default="`${(cuw_rb4 + cuw_rb5) / 2}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_tm6" name="cuw_tm6" group="General" default="`${(cuw_rb5 + cuw_rb6) / 2}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_tm7" name="cuw_tm7" group="General" default="`${(cuw_rb6 + cuw_rb7) / 2}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_tm8" name="cuw_tm8" group="General" default="`${(cuw_rb7 + cuw_rb8) / 2}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rax4" name="cuw_rax4" group="General" default="`${cuw_isUpDown ? cuw_tm4 : cuw_rb4}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rax5" name="cuw_rax5" group="General" default="`${cuw_isUpDown ? cuw_tm5 : cuw_rb5}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rax6" name="cuw_rax6" group="General" default="`${cuw_isUpDown ? cuw_tm6 : cuw_rb6}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rax7" name="cuw_rax7" group="General" default="`${cuw_isUpDown ? cuw_tm7 : cuw_rb7}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_rax8" name="cuw_rax8" group="General" default="`${cuw_isUpDown ? cuw_tm8 : cuw_rb8}`" visible="false" editable="false" desc="" />

    <!-- Analytic window clip of the ramp at x=800. For each slot the up-leg runs (prevBoundary,prevBoundaryY)->(rax,rya) and the drop/down-leg (rax,rya)->(rb,ryb). cax/cbx = min(x,800); cay/cby = the Y at that clipped X (true Y when the vertex is in-window, else the segment's Y where it crosses x=800, computed by linear interpolation so the SLOPE is preserved). When the apex itself is past 800 the whole down-leg is off-window, so cbx/cby collapse onto the clipped apex (cax,cay) giving a zero-length, invisible drop. Denominators are guarded (>=1) to avoid divide-by-zero on degenerate (zero-width) slots; those slots are hidden by SHOW_P anyway. -->
    <ParamString id="cuw_cax4" name="cuw_cax4" group="General" default="`${(cuw_rax4 &lt;= 800) ? cuw_rax4 : 800}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cay4" name="cuw_cay4" group="General" default="`${(cuw_rax4 &lt;= 800) ? cuw_rya4 : (cuw_ryb3 + ((cuw_rya4 - cuw_ryb3) * (800 - cuw_b3)) / (((cuw_rax4 - cuw_b3) &lt; 1) ? 1 : (cuw_rax4 - cuw_b3)))}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cbx4" name="cuw_cbx4" group="General" default="`${(cuw_rb4 &lt;= 800) ? cuw_rb4 : 800}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cby4" name="cuw_cby4" group="General" default="`${(cuw_rb4 &lt;= 800) ? cuw_ryb4 : ((cuw_rax4 &lt;= 800) ? (cuw_rya4 + ((cuw_ryb4 - cuw_rya4) * (800 - cuw_rax4)) / (((cuw_rb4 - cuw_rax4) &lt; 1) ? 1 : (cuw_rb4 - cuw_rax4))) : cuw_cay4)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cax5" name="cuw_cax5" group="General" default="`${(cuw_rax5 &lt;= 800) ? cuw_rax5 : 800}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cay5" name="cuw_cay5" group="General" default="`${(cuw_rax5 &lt;= 800) ? cuw_rya5 : (cuw_ryb4 + ((cuw_rya5 - cuw_ryb4) * (800 - cuw_rb4)) / (((cuw_rax5 - cuw_rb4) &lt; 1) ? 1 : (cuw_rax5 - cuw_rb4)))}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cbx5" name="cuw_cbx5" group="General" default="`${(cuw_rb5 &lt;= 800) ? cuw_rb5 : 800}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cby5" name="cuw_cby5" group="General" default="`${(cuw_rb5 &lt;= 800) ? cuw_ryb5 : ((cuw_rax5 &lt;= 800) ? (cuw_rya5 + ((cuw_ryb5 - cuw_rya5) * (800 - cuw_rax5)) / (((cuw_rb5 - cuw_rax5) &lt; 1) ? 1 : (cuw_rb5 - cuw_rax5))) : cuw_cay5)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cax6" name="cuw_cax6" group="General" default="`${(cuw_rax6 &lt;= 800) ? cuw_rax6 : 800}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cay6" name="cuw_cay6" group="General" default="`${(cuw_rax6 &lt;= 800) ? cuw_rya6 : (cuw_ryb5 + ((cuw_rya6 - cuw_ryb5) * (800 - cuw_rb5)) / (((cuw_rax6 - cuw_rb5) &lt; 1) ? 1 : (cuw_rax6 - cuw_rb5)))}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cbx6" name="cuw_cbx6" group="General" default="`${(cuw_rb6 &lt;= 800) ? cuw_rb6 : 800}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cby6" name="cuw_cby6" group="General" default="`${(cuw_rb6 &lt;= 800) ? cuw_ryb6 : ((cuw_rax6 &lt;= 800) ? (cuw_rya6 + ((cuw_ryb6 - cuw_rya6) * (800 - cuw_rax6)) / (((cuw_rb6 - cuw_rax6) &lt; 1) ? 1 : (cuw_rb6 - cuw_rax6))) : cuw_cay6)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cax7" name="cuw_cax7" group="General" default="`${(cuw_rax7 &lt;= 800) ? cuw_rax7 : 800}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cay7" name="cuw_cay7" group="General" default="`${(cuw_rax7 &lt;= 800) ? cuw_rya7 : (cuw_ryb6 + ((cuw_rya7 - cuw_ryb6) * (800 - cuw_rb6)) / (((cuw_rax7 - cuw_rb6) &lt; 1) ? 1 : (cuw_rax7 - cuw_rb6)))}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cbx7" name="cuw_cbx7" group="General" default="`${(cuw_rb7 &lt;= 800) ? cuw_rb7 : 800}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cby7" name="cuw_cby7" group="General" default="`${(cuw_rb7 &lt;= 800) ? cuw_ryb7 : ((cuw_rax7 &lt;= 800) ? (cuw_rya7 + ((cuw_ryb7 - cuw_rya7) * (800 - cuw_rax7)) / (((cuw_rb7 - cuw_rax7) &lt; 1) ? 1 : (cuw_rb7 - cuw_rax7))) : cuw_cay7)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cax8" name="cuw_cax8" group="General" default="`${(cuw_rax8 &lt;= 800) ? cuw_rax8 : 800}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cay8" name="cuw_cay8" group="General" default="`${(cuw_rax8 &lt;= 800) ? cuw_rya8 : (cuw_ryb7 + ((cuw_rya8 - cuw_ryb7) * (800 - cuw_rb7)) / (((cuw_rax8 - cuw_rb7) &lt; 1) ? 1 : (cuw_rax8 - cuw_rb7)))}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cbx8" name="cuw_cbx8" group="General" default="`${(cuw_rb8 &lt;= 800) ? cuw_rb8 : 800}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_cby8" name="cuw_cby8" group="General" default="`${(cuw_rb8 &lt;= 800) ? cuw_ryb8 : ((cuw_rax8 &lt;= 800) ? (cuw_rya8 + ((cuw_ryb8 - cuw_rya8) * (800 - cuw_rax8)) / (((cuw_rb8 - cuw_rax8) &lt; 1) ? 1 : (cuw_rb8 - cuw_rax8))) : cuw_cay8)}`" visible="false" editable="false" desc="" />

    <!-- Asymmetric apex-divider visibility for the dynamic tiled slots 4..8. The grey divider sits at the ramp APEX, so it must only appear when that apex is actually within the window (cuw_rax* &lt;= 800), NOT merely when the slot start is on-screen (cuw_showP*, which only tests the period start): a partially-drawn up-leg whose apex is off-window would otherwise clamp cuw_cax* to 800 and paint a spurious divider at the right edge. -->
    <ParamString id="cuw_showApexDiv4" name="cuw_showApexDiv4" group="General" default="`${((cuw_showP4 &gt; 0) &amp;&amp; (cuw_rax4 &lt;= 800)) ? 1.0 : 0.0}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_showApexDiv5" name="cuw_showApexDiv5" group="General" default="`${((cuw_showP5 &gt; 0) &amp;&amp; (cuw_rax5 &lt;= 800)) ? 1.0 : 0.0}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_showApexDiv6" name="cuw_showApexDiv6" group="General" default="`${((cuw_showP6 &gt; 0) &amp;&amp; (cuw_rax6 &lt;= 800)) ? 1.0 : 0.0}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_showApexDiv7" name="cuw_showApexDiv7" group="General" default="`${((cuw_showP7 &gt; 0) &amp;&amp; (cuw_rax7 &lt;= 800)) ? 1.0 : 0.0}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_showApexDiv8" name="cuw_showApexDiv8" group="General" default="`${((cuw_showP8 &gt; 0) &amp;&amp; (cuw_rax8 &lt;= 800)) ? 1.0 : 0.0}`" visible="false" editable="false" desc="" />

    <!-- Dash pattern for the apex-to-boundary counter segment. When counting up or down the counter snaps from the period back to zero (or zero back to the period): this rapid change is drawn dotted. The up/down triangle has no rapid change, so the segment stays solid (0 = no dashing). -->
    <ParamString id="cuw_dropDash" name="cuw_dropDash" group="General" default="`${cuw_isUpDown ? 0 : 3}`" visible="false" editable="false" desc="" />

    <!-- Boundary event seen at the end of each displayed ramp: overflow when counting up, underflow when the ramp returns to zero -->
    <ParamString id="cuw_boundAct" name="cuw_boundAct" group="General" default="`${(cuw_isDown || cuw_isUpDown) ? UnderflowMode : OverflowMode}`" visible="false" editable="false" desc="" />
    <!-- Overflow (OVF) event at the period boundary: only Count Up reaches Period at the boundary (apex coincides with the boundary). -->
    <ParamString id="cuw_showOv" name="cuw_showOv" group="General" default="`${(UpDownMode eq CY_TCPWM_PWM_COUNT_UP) ? 1.0 : 0.0}`" visible="false" editable="false" desc="" />
    <!-- Overflow (OVF) event at the ramp apex: Count Up/Down (modes 2 and 3) reach Period mid-period, so OVF is generated at the apex, not at the boundary. -->
    <ParamString id="cuw_showOvApex" name="cuw_showOvApex" group="General" default="`${cuw_isUpDown ? 1.0 : 0.0}`" visible="false" editable="false" desc="" />
    <!-- Underflow (UNF) event at the period boundary: Count Down and Count Up/Down reach 0 at the boundary. -->
    <ParamString id="cuw_showUn" name="cuw_showUn" group="General" default="`${(UpDownMode eq CY_TCPWM_PWM_COUNT_UP) ? 0.0 : 1.0}`" visible="false" editable="false" desc="" />
    <!-- Terminal-count (tc) at the apex. Count Up/Down - TC on UNF (mode 2) raises tc only on underflow (the bottom boundaries); Count Up/Down - TC on OVF and UNF (mode 3) raises tc on BOTH overflow and underflow, so an extra tc event is shown at each ramp apex. -->
    <ParamString id="cuw_showTcApex" name="cuw_showTcApex" group="General" default="`${(UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_2) ? 1.0 : 0.0}`" visible="false" editable="false" desc="" />
    <!-- Inverse of cuw_showTcApex: shows the full-width (un-split) compare reference line in every mode EXCEPT asymmetric mode 3, where the line is split at the grey apex divider instead. -->
    <!-- Asymmetric down-count (right of the grey divider) buffered-compare reference-line / label visibility: shown only when mode 3 AND the matching Enable Compare Swap is on (otherwise the buffer equals the main value, so no separate line is needed). -->
    <!-- Compare 1 odd-period reference-line gating combined with CC1 availability: full-width line shown when CC1 present and NOT asymmetric; split line shown when CC1 present AND asymmetric. -->
    <!-- Per-register shadow-copy persistence: Swapping Enable OFF plus the matching Enable Compare Swap ON. In this case the buffered compare is shadow-copied once at the first TC and HELD to the end of the graph, so the compare reference line must NOT alternate main/buffered every period - it shows the main level up to the first TC, then the buffered level continuously. When Swapping Enable is ON (bidirectional) these are false and the legacy per-TC alternation is kept. -->
    <ParamBool id="cuw_c0Persist" name="cuw_c0Persist" group="General" default="`${(!pSwapEnableEff) &amp;&amp; pCompare0SwapEff}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_c1Persist" name="cuw_c1Persist" group="General" default="`${(!pSwapEnableEff) &amp;&amp; pCompare1SwapEff &amp;&amp; pCntCC1}`" visible="false" editable="false" desc="" />
    <!-- Period shadow-copy persistence (analogous to the compare flags above): Swapping Enable OFF plus Enable Period Swap ON. The buffered Period 1 is shadow-copied once at the first TC and HELD to the end of the graph, so the Period 0 / Period 1 horizontal reference lines must NOT alternate every period - Period 0 (green) up to the first TC, then Period 1 (purple) continuously. When Swapping Enable is ON (bidirectional) this is false and the legacy per-TC alternation (NA full-width) / asymmetric split (AS) is kept. -->
    <ParamBool id="cuw_perPersist" name="cuw_perPersist" group="General" default="`${(!pSwapEnableEff) &amp;&amp; pPeriodSwapEff}`" visible="false" editable="false" desc="" />

    <!-- Per-compare X offset (pixels) inside a displayed period, at the uniform pixel-per-count rate (240 px per cuw_maxper counts), so the markers sit on the ramp whatever the period width. -->
    <ParamString id="cuw_pxc0" name="cuw_pxc0" group="General" default="`${cuw_isDown ? ((cuw_period - cuw_cmp0) * 240.0) / cuw_maxperX : (cuw_isUpDown ? (cuw_cmp0 * 120.0) / cuw_maxperX : (cuw_cmp0 * 240.0) / cuw_maxperX)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_pxc1" name="cuw_pxc1" group="General" default="`${cuw_isDown ? ((cuw_period - cuw_cmp1) * 240.0) / cuw_maxperX : (cuw_isUpDown ? (cuw_cmp1 * 120.0) / cuw_maxperX : (cuw_cmp1 * 240.0) / cuw_maxperX)}`" visible="false" editable="false" desc="" />

    <!-- Event ordering by time (smaller X offset happens first) -->
    <ParamBool id="cuw_c0First" name="cuw_c0First" group="General" default="`${pCntCC1 ? (cuw_pxc0 &lt;= cuw_pxc1) : (1 &lt; 2)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_offA" name="cuw_offA" group="General" default="`${cuw_c0First ? cuw_pxc0 : cuw_pxc1}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_offB" name="cuw_offB" group="General" default="`${pCntCC1 ? (cuw_c0First ? cuw_pxc1 : cuw_pxc0) : cuw_offA}`" visible="false" editable="false" desc="" />
    <!-- Match-enable-gated line actions: when the CC0/CC1 Match mode disables a compare match on a given leg (up/down) the
         match generates no event, so the output line action becomes No Change on that leg. Applied to the waveform level
         state machine (cuw_actA/B up-leg, cuw_actAdn/Bdn down-leg) so line_out and line_compl_out stop transitioning on a
         disabled compare match. On non-AMC counters cuw_ccXUp/Dn are always true, so the actions are unchanged. -->
    <ParamString id="cuw_c0ActUp" name="cuw_c0ActUp" group="General" default="`${cuw_cc0Up ? Cc0MatchMode : &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot;}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_c1ActUp" name="cuw_c1ActUp" group="General" default="`${cuw_cc1Up ? Cc1MatchMode : &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot;}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_c0ActDn" name="cuw_c0ActDn" group="General" default="`${cuw_cc0Dn ? Cc0MatchMode : &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot;}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_c1ActDn" name="cuw_c1ActDn" group="General" default="`${cuw_cc1Dn ? Cc1MatchMode : &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot;}`" visible="false" editable="false" desc="" />

    <!-- ===== Coincident CC0/CC1 (same-tick) UP-leg action merge =====
         When Compare0 and Compare1 (CC1) sit on the SAME counter value, the CC0 and CC1 match events fire on the same
         clock tick, so the hardware writes line_out ONCE with the combined effect, not twice in sequence. The level
         state machine (cuw_pNL1 then cuw_pNL2) applies actA then actB as two separate vertices at the same X; with two
         INVERTs (or any pair) that produced a spurious zero-width intermediate level (e.g. 1 -> 0 -> 1) that, in Dead
         Time mode, the dead-time edge logic expands into a visible notch. Collapse the pair into a single equivalent
         action: apply the merged action at slot A (cuw_actA) and No Change at slot B (cuw_actB), so only one (or zero)
         net edge is drawn. Merge table for "apply mAU then mBU": an absolute SET/CLEAR as the SECOND action wins; a No
         Change second keeps the first; an INVERT second flips the first (SET->CLEAR, CLEAR->SET, INVERT->No Change,
         No Change->INVERT). Two INVERTs therefore cancel to No Change (no edge) - exactly the case the user reported.
         cuw_coincU also requires the EVEN-period compares to coincide (cuw_cmp0e/cmp1e) so an Enable Compare Swap that
         separates the even-period matches is not wrongly collapsed; with no swap those equal cuw_cmp0/cmp1, so the test
         reduces to Compare0 == Compare1 and every non-coincident config is byte-identical. -->
    <ParamBool id="cuw_coincU" name="cuw_coincU" group="General" default="`${pCntCC1 &amp;&amp; (cuw_cmp0 eq cuw_cmp1) &amp;&amp; (cuw_cmp0e eq cuw_cmp1e)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_mAU" name="cuw_mAU" group="General" default="`${cuw_c0First ? cuw_c0ActUp : cuw_c1ActUp}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_mBU" name="cuw_mBU" group="General" default="`${cuw_c0First ? cuw_c1ActUp : cuw_c0ActUp}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_mergeU" name="cuw_mergeU" group="General" default="`${(cuw_mBU eq CY_TCPWM_PWM_ACTION_SET) ? &quot;CY_TCPWM_PWM_ACTION_SET&quot; : (cuw_mBU eq CY_TCPWM_PWM_ACTION_CLEAR) ? &quot;CY_TCPWM_PWM_ACTION_CLEAR&quot; : (cuw_mBU eq CY_TCPWM_PWM_ACTION_NO_CHANGE) ? cuw_mAU : ((cuw_mAU eq CY_TCPWM_PWM_ACTION_SET) ? &quot;CY_TCPWM_PWM_ACTION_CLEAR&quot; : (cuw_mAU eq CY_TCPWM_PWM_ACTION_CLEAR) ? &quot;CY_TCPWM_PWM_ACTION_SET&quot; : (cuw_mAU eq CY_TCPWM_PWM_ACTION_INVERT) ? &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot; : &quot;CY_TCPWM_PWM_ACTION_INVERT&quot;)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_actA" name="cuw_actA" group="General" default="`${cuw_coincU ? cuw_mergeU : (cuw_c0First ? cuw_c0ActUp : cuw_c1ActUp)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_actB" name="cuw_actB" group="General" default="`${cuw_coincU ? &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot; : (pCntCC1 ? (cuw_c0First ? cuw_c1ActUp : cuw_c0ActUp) : &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot;)}`" visible="false" editable="false" desc="" />

    <!-- ============ Asymmetric (Count Up/Down - TC on OVF and UNF, mode 3) down-leg compare source ============ -->
    <!-- In Asymmetric PWM the OVF terminal-count at the apex swaps each compare with its buffer (Compare1 buffers Compare0, Compare3 buffers Compare2), so the DOWN-leg matches the buffered value while the UP-leg keeps the main value. Center-Aligned (mode 2) and swap-off keep the main value on both legs (buffer == main => symmetric). Defined here (before the period-level and waveform-X params that consume them) so every reference is backward, matching the define-before-use convention of this file. -->
    <ParamBool id="cuw_asym" name="cuw_asym" group="General" default="`${UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_2}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_c0Dn" name="cuw_c0Dn" group="General" default="`${(cuw_asym &amp;&amp; pCompare0SwapEff) ? ((Compare1 &lt; 0) ? 0 : ((Compare1 &gt; cuw_period) ? cuw_period : Compare1)) : cuw_cmp0}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_c1Dn" name="cuw_c1Dn" group="General" default="`${(cuw_asym &amp;&amp; pCompare1SwapEff) ? ((Compare3 &lt; 0) ? 0 : ((Compare3 &gt; cuw_period) ? cuw_period : Compare3)) : cuw_cmp1}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_pxc0Dn" name="cuw_pxc0Dn" group="General" default="`${(cuw_c0Dn * 120.0) / cuw_maxperX}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_pxc1Dn" name="cuw_pxc1Dn" group="General" default="`${(cuw_c1Dn * 120.0) / cuw_maxperX}`" visible="false" editable="false" desc="" />
    <!-- Down-leg crossing order: counting back down the HIGHER compare value is reached first (its offset from the boundary is larger). Recomputed from the buffered values so the polyline stays monotonic even when the buffer reverses the up-leg ordering. -->
    <ParamBool id="cuw_c0HiDn" name="cuw_c0HiDn" group="General" default="`${pCntCC1 ? (cuw_pxc0Dn &gt;= cuw_pxc1Dn) : (1 &lt; 2)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_offBdn" name="cuw_offBdn" group="General" default="`${cuw_c0HiDn ? cuw_pxc0Dn : cuw_pxc1Dn}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_offAdn" name="cuw_offAdn" group="General" default="`${pCntCC1 ? (cuw_c0HiDn ? cuw_pxc1Dn : cuw_pxc0Dn) : cuw_offBdn}`" visible="false" editable="false" desc="" />
    <!-- ===== Coincident CC0/CC1 (same-tick) DOWN-leg action merge (Center / Up-Down counting) =====
         Same collapse as the up-leg, but for the down sweep, where the level machine applies cuw_actBdn (slot first,
         cuw_pNL3) then cuw_actAdn (slot second, cuw_pNL4). When the two DOWN-leg compare values coincide (cuw_c0Dn ==
         cuw_c1Dn) both matches fire on one tick, so merge them into a single action at the first slot and No Change at
         the second. cuw_mFirstD is the action applied first (cuw_actBdn base), cuw_mSecondD second (cuw_actAdn base);
         the merge applies mFirstD then mSecondD using the same table as cuw_mergeU. Collapses to the existing values
         whenever the down compares differ (every non-coincident config unchanged); the down compares already equal the
         up compares unless Asymmetric mode buffers them, so cuw_c0Dn/c1Dn is the correct same-tick test here. -->
    <ParamBool id="cuw_coincD" name="cuw_coincD" group="General" default="`${pCntCC1 &amp;&amp; (cuw_c0Dn eq cuw_c1Dn)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_mFirstD" name="cuw_mFirstD" group="General" default="`${cuw_c0HiDn ? cuw_c0ActDn : cuw_c1ActDn}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_mSecondD" name="cuw_mSecondD" group="General" default="`${cuw_c0HiDn ? cuw_c1ActDn : cuw_c0ActDn}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_mergeD" name="cuw_mergeD" group="General" default="`${(cuw_mSecondD eq CY_TCPWM_PWM_ACTION_SET) ? &quot;CY_TCPWM_PWM_ACTION_SET&quot; : (cuw_mSecondD eq CY_TCPWM_PWM_ACTION_CLEAR) ? &quot;CY_TCPWM_PWM_ACTION_CLEAR&quot; : (cuw_mSecondD eq CY_TCPWM_PWM_ACTION_NO_CHANGE) ? cuw_mFirstD : ((cuw_mFirstD eq CY_TCPWM_PWM_ACTION_SET) ? &quot;CY_TCPWM_PWM_ACTION_CLEAR&quot; : (cuw_mFirstD eq CY_TCPWM_PWM_ACTION_CLEAR) ? &quot;CY_TCPWM_PWM_ACTION_SET&quot; : (cuw_mFirstD eq CY_TCPWM_PWM_ACTION_INVERT) ? &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot; : &quot;CY_TCPWM_PWM_ACTION_INVERT&quot;)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_actBdn" name="cuw_actBdn" group="General" default="`${cuw_coincD ? cuw_mergeD : (cuw_c0HiDn ? cuw_c0ActDn : cuw_c1ActDn)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_actAdn" name="cuw_actAdn" group="General" default="`${cuw_coincD ? &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot; : (pCntCC1 ? (cuw_c0HiDn ? cuw_c1ActDn : cuw_c0ActDn) : &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot;)}`" visible="false" editable="false" desc="" />
    <!-- ===== EVEN / PERSIST DOWN-leg coincidence merge =====
         cuw_coincD tests the MAIN down compares (cuw_c0Dn / cuw_c1Dn). But the even displayed periods (2/4/6/8) and,
         in persist mode (Swapping Enable off + a per-register buffer enabled), the odd full periods (3/5/7) render
         their DOWN leg at the BUFFERED compare positions, not the main ones. In the non-asymmetric persist case the
         down leg reuses the even/buffered UP positions (cuw_offAe), so the same-tick test must use the buffered even
         compares (cuw_cmp0e == cuw_cmp1e) - exactly like the up-leg cuw_coincUe. In asymmetric mode the down leg
         already matches the buffered down values (cuw_c0Dn / cuw_c1Dn), which is what cuw_coincD tests, so keep that.
         When two buffered down compares coincide the two INVERTs (or any pair) fire on one tick and must collapse to a
         single merged action at the first down slot (cuw_actBdne, cuw_pNL3) and No Change at the second (cuw_actAdne,
         cuw_pNL4); otherwise the level toggled 0->1->0 and the differential dead time (buffered Line Out vs Line Compl
         DT) expanded that zero-width step into a visible notch on line_compl_out. In every non-persist / non-coincident
         config cuw_coincDe equals cuw_coincD, so cuw_actBdne/cuw_actAdne are byte-identical to cuw_actBdn/cuw_actAdn. -->
    <ParamBool id="cuw_coincDe" name="cuw_coincDe" group="General" default="`${pCntCC1 &amp;&amp; (cuw_asym ? (cuw_c0Dn eq cuw_c1Dn) : (cuw_cmp0e eq cuw_cmp1e))}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_actBdne" name="cuw_actBdne" group="General" default="`${cuw_coincDe ? cuw_mergeD : cuw_actBdn}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_actAdne" name="cuw_actAdne" group="General" default="`${cuw_coincDe ? &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot; : cuw_actAdn}`" visible="false" editable="false" desc="" />
    <!-- Down-leg actions in UP-leg crossing order (cuw_c0First), but gated by the DOWN match-enable (cuw_cXActDn).
         The non-asymmetric even displayed period (cuw_p2dnA/B) reaches its down-leg slots with the up-leg ordering gates
         (cuw_reachedAE/BE), so it must use the down-leg-ENABLED action at that slot - reusing the up-leg cuw_actA/cuw_actB
         would gate the down sweep by the CC up-enable and drop the match on a 'Only Down' leg (no reaction on that period).
         Collapses to cuw_actA/cuw_actB whenever up and down enables match (e.g. 'Both' or non-AMC), so those cases are unchanged. -->
    <ParamString id="cuw_actAd2" name="cuw_actAd2" group="General" default="`${cuw_c0First ? cuw_c0ActDn : cuw_c1ActDn}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_actBd2" name="cuw_actBd2" group="General" default="`${pCntCC1 ? (cuw_c0First ? cuw_c1ActDn : cuw_c0ActDn) : &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot;}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_yc0Dn" name="cuw_yc0Dn" group="General" default="`${190 - (130 * cuw_c0Dn) / cuw_maxper}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_yc1Dn" name="cuw_yc1Dn" group="General" default="`${190 - (130 * cuw_c1Dn) / cuw_maxper}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_c0DnColor" name="cuw_c0DnColor" group="General" default="`${(cuw_asym &amp;&amp; pCompare0SwapEff) ? &quot;blue&quot; : &quot;red&quot;}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_c1DnColor" name="cuw_c1DnColor" group="General" default="`${(cuw_asym &amp;&amp; pCompare1SwapEff) ? &quot;purple&quot; : &quot;orange&quot;}`" visible="false" editable="false" desc="" />

    <!-- Even displayed periods (2 and 4) compare crossing offsets, scaled to Period1 when Enable Period Swap is set. NOTE: the two compares can be ordered DIFFERENTLY in the even period than in the odd period - either because Enable Compare Swap feeds the even period a different compare pair, or because a compare that exceeds the (small) odd period gets clamped there (collapsing the odd ordering) while staying in range in the (large) even period. So the even period needs its OWN crossing-order selector cuw_c0FirstE (based on the even-period pixel offsets pxc0e/pxc1e); reusing cuw_c0First here would swap the A/B (and hence the down-leg C/D) offsets and double the waveform back on itself (a horizontal spike). cuw_c0FirstE equals cuw_c0First whenever the orderings coincide, so the in-range no-swap case is unchanged. -->
    <ParamString id="cuw_pxc0e" name="cuw_pxc0e" group="General" default="`${cuw_isDown ? ((cuw_perEven - cuw_cmp0e) * 240.0) / cuw_maxperX : (cuw_isUpDown ? (cuw_cmp0e * 120.0) / cuw_maxperX : (cuw_cmp0e * 240.0) / cuw_maxperX)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_pxc1e" name="cuw_pxc1e" group="General" default="`${cuw_isDown ? ((cuw_perEven - cuw_cmp1e) * 240.0) / cuw_maxperX : (cuw_isUpDown ? (cuw_cmp1e * 120.0) / cuw_maxperX : (cuw_cmp1e * 240.0) / cuw_maxperX)}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_c0FirstE" name="cuw_c0FirstE" group="General" default="`${pCntCC1 ? (cuw_pxc0e &lt;= cuw_pxc1e) : (1 &lt; 2)}`" visible="false" editable="false" desc="" />
    <!-- UP-leg crossing order for the EVEN displayed periods (2/4/6/8) and the persist-redirected odd periods (3/5/7).
         The up-leg matches the MAIN compare pair (crossing order cuw_c0First) ONLY in the asymmetric (Count Up/Down - TC
         on OVF and UNF) NON-persist case, where the compare register swaps back to the main value at every underflow. In
         every other case the up-leg matches the BUFFERED compare pair (the normal even-period buffered-everywhere
         representation, or the asymmetric SHADOW-COPY persist case where the buffered value is copied once and persists),
         so it must use the buffered crossing order cuw_c0FirstE. Using cuw_c0First for a buffered pair whose ordering
         differs (e.g. main CC0 &gt; CC1 but buffered CC0 &lt; CC1 via Enable Compare Swap) swaps the two up-leg slots and
         doubles the ramp back on itself - a backward segment in PWM, and a ZERO-WIDTH (invisible) pulse once the dead-time
         edge clamp pins the reversed edges together in PWM_DT. cuw_c0FirstP2u collapses to cuw_c0First / cuw_c0FirstE
         respectively, so every non-reordered config is byte-identical. -->
    <ParamBool id="cuw_c0FirstP2u" name="cuw_c0FirstP2u" group="General" default="`${(cuw_asym &amp;&amp; !pAnyPersist) ? cuw_c0First : cuw_c0FirstE}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_offAe" name="cuw_offAe" group="General" default="`${cuw_c0FirstE ? cuw_pxc0e : cuw_pxc1e}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_offBe" name="cuw_offBe" group="General" default="`${pCntCC1 ? (cuw_c0FirstE ? cuw_pxc1e : cuw_pxc0e) : cuw_offAe}`" visible="false" editable="false" desc="" />
    <!-- Even-period compare reach flags: a compare is crossed only if its (possibly buffered) even-period value is within the even period value (Period1 when swap is enabled). -->
    <ParamBool id="cuw_c0reachE" name="cuw_c0reachE" group="General" default="`${cuw_cmp0eSrc &lt;= cuw_perEven}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_c1reachE" name="cuw_c1reachE" group="General" default="`${pCntCC1 &amp;&amp; (cuw_cmp1eSrc &lt;= cuw_perEven)}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_reachedAE" name="cuw_reachedAE" group="General" default="`${cuw_c0FirstE ? cuw_c0reachE : cuw_c1reachE}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_reachedBE" name="cuw_reachedBE" group="General" default="`${pCntCC1 ? (cuw_c0FirstE ? cuw_c1reachE : cuw_c0reachE) : cuw_reachedAE}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_showC0p2" name="cuw_showC0p2" group="General" default="`${cuw_c0reachE ? 1.0 : 0.0}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_showC1p2" name="cuw_showC1p2" group="General" default="`${cuw_c1reachE ? 1.0 : 0.0}`" visible="false" editable="false" desc="" />

    <!-- ===== Coincident CC0/CC1 (same-tick) UP-leg action merge for the EVEN displayed periods (2/4/6/8) =====
         The even periods use the buffered/even compare values (cuw_cmp0e/cmp1e). When Enable Compare Swap feeds the
         even period a pair that lands on the SAME even-period counter value, both CC0 and CC1 matches fire on one tick,
         so the hardware writes line_out once - but the level state machine (cuw_pNL1 then cuw_pNL2) would apply the two
         actions as two separate vertices at the same X, producing a spurious zero-width up-then-down spike (e.g. two
         INVERTs => 0 -> 1 -> 0). The odd-period merge cuw_coincU deliberately does NOT fire here because it also tests
         the ODD compares (cuw_cmp0/cmp1), which can differ (a buffered even pair coincides while the main odd pair does
         not - exactly the reported case). So the even periods need their OWN coincidence test on cuw_cmp0e/cmp1e and
         their own merged action pair, ordered by the even crossing order cuw_c0FirstE (matching the even reach gates
         cuw_reachedAE/BE). When the even compares do NOT coincide these collapse EXACTLY to cuw_actA / cuw_actB, so every
         non-even-coincident config is byte-identical; and with Compare Swap off cuw_cmp0e/cmp1e == cuw_cmp0/cmp1 so the
         test only fires when the odd merge already handled it. Same merge table as cuw_mergeU (second action wins for an
         absolute SET/CLEAR, No Change keeps the first, INVERT flips the first; two INVERTs cancel to No Change). -->
    <ParamBool id="cuw_coincUe" name="cuw_coincUe" group="General" default="`${pCntCC1 &amp;&amp; (cuw_cmp0e eq cuw_cmp1e)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_mAUe" name="cuw_mAUe" group="General" default="`${cuw_c0FirstE ? cuw_c0ActUp : cuw_c1ActUp}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_mBUe" name="cuw_mBUe" group="General" default="`${cuw_c0FirstE ? cuw_c1ActUp : cuw_c0ActUp}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_mergeUe" name="cuw_mergeUe" group="General" default="`${(cuw_mBUe eq CY_TCPWM_PWM_ACTION_SET) ? &quot;CY_TCPWM_PWM_ACTION_SET&quot; : (cuw_mBUe eq CY_TCPWM_PWM_ACTION_CLEAR) ? &quot;CY_TCPWM_PWM_ACTION_CLEAR&quot; : (cuw_mBUe eq CY_TCPWM_PWM_ACTION_NO_CHANGE) ? cuw_mAUe : ((cuw_mAUe eq CY_TCPWM_PWM_ACTION_SET) ? &quot;CY_TCPWM_PWM_ACTION_CLEAR&quot; : (cuw_mAUe eq CY_TCPWM_PWM_ACTION_CLEAR) ? &quot;CY_TCPWM_PWM_ACTION_SET&quot; : (cuw_mAUe eq CY_TCPWM_PWM_ACTION_INVERT) ? &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot; : &quot;CY_TCPWM_PWM_ACTION_INVERT&quot;)}`" visible="false" editable="false" desc="" />
    <!-- Non-coincident fallback MUST use the EVEN crossing order (cuw_c0FirstE), NOT the main odd order (cuw_actA/actB
         which are cuw_c0First-ordered). The even up-leg X positions (cuw_offAe/offBe) and reach gates
         (cuw_reachedAE/BE) are both ordered by cuw_c0FirstE, so the actions must match. When Enable Compare Swap feeds
         the even periods a buffered pair whose crossing order differs from the main pair (cuw_c0FirstE != cuw_c0First -
         e.g. main CC0 > CC1 but buffered CC0 < CC1), reusing cuw_actA/actB applied CC1's action at the CC0 slot and vice
         versa, so on the positive (up) slope of every even / persist-odd full period the CC0 and CC1 matches reacted at
         the wrong crossing (a wrong or absent edge). cuw_c0FirstE == cuw_c0First whenever the two orderings coincide, so
         every non-reordered config is byte-identical. Mirrors cuw_actA/actB but with the even crossing order. -->
    <ParamString id="cuw_actAe" name="cuw_actAe" group="General" default="`${cuw_coincUe ? cuw_mergeUe : (cuw_c0FirstP2u ? cuw_c0ActUp : cuw_c1ActUp)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_actBe" name="cuw_actBe" group="General" default="`${cuw_coincUe ? &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot; : (pCntCC1 ? (cuw_c0FirstP2u ? cuw_c1ActUp : cuw_c0ActUp) : &quot;CY_TCPWM_PWM_ACTION_NO_CHANGE&quot;)}`" visible="false" editable="false" desc="" />
    <!-- Persist-mode (Swapping Enable OFF + per-register swap ON) redirect of the odd FULL displayed periods (3/5/7):
         in persist mode those periods render with the buffered/even compare values (like the even periods - see
         cuw_fullReachA3 / cuw_offA3), so they must ALSO use the even-period coincidence-merged actions cuw_actAe/actBe,
         otherwise a buffered even pair that coincides (cuw_cmp0e == cuw_cmp1e) toggles the level on the odd persist
         periods and draws a spurious spike (the line_out forward-fill happens to mask it when its dead-time-shifted _O
         vertices collapse, but the complement _C vertices are dead-time-separated so the spike survives on
         line_compl_out). NOT in persist => keeps cuw_actA/actB exactly (main-compare odd periods, byte-identical). -->
    <ParamString id="cuw_actA3" name="cuw_actA3" group="General" default="`${pAnyPersist ? cuw_actAe : cuw_actA}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_actB3" name="cuw_actB3" group="General" default="`${pAnyPersist ? cuw_actBe : cuw_actB}`" visible="false" editable="false" desc="" />

    <!-- Period-1 init-aware compare crossing offsets and "compare reached" flags. In the first period the counter starts at the initial value, so a compare on the far side of the start value is not crossed (no match, no line action). -->
    <ParamString id="cuw_pxc0_p1" name="cuw_pxc0_p1" group="General" default="`${cuw_isDown ? (240.0 * (cuw_cntInit - cuw_cmp0)) / cuw_maxperX : (cuw_isUpDown ? (120.0 * (cuw_cmp0 - cuw_cntInit)) / cuw_maxperX : (240.0 * (cuw_cmp0 - cuw_cntInit)) / cuw_maxperX)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_pxc1_p1" name="cuw_pxc1_p1" group="General" default="`${cuw_isDown ? (240.0 * (cuw_cntInit - cuw_cmp1)) / cuw_maxperX : (cuw_isUpDown ? (120.0 * (cuw_cmp1 - cuw_cntInit)) / cuw_maxperX : (240.0 * (cuw_cmp1 - cuw_cntInit)) / cuw_maxperX)}`" visible="false" editable="false" desc="" />
    <!-- "Compare matches at all" gate. A compare whose value exceeds the period count is never reached by the counter, so it must NOT toggle the output line (or show a match dot) in any period. The per-period offsets clamp the compare to the period for placement, which would otherwise pin a spurious match at the apex; these flags test the UNCLAMPED main/buffered compare against the period so an out-of-range compare has no effect, matching hardware. The even displayed periods already test cuw_cmp0eSrc / cuw_cmp1eSrc against cuw_perEven (cuw_c0reachE / cuw_c1reachE), so only the odd/main path needs this. -->
    <ParamBool id="cuw_c0inPer" name="cuw_c0inPer" group="General" default="`${Compare0 &lt;= cuw_period}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_c1inPer" name="cuw_c1inPer" group="General" default="`${pCntCC1 &amp;&amp; (Compare2 &lt;= cuw_period)}`" visible="false" editable="false" desc="" />
    <!-- Down-leg (up/down counting) match gate: the down sweep uses the buffered compare in asymmetric mode, otherwise the main compare. Same out-of-range test against the period. -->
    <ParamBool id="cuw_c0inPerDn" name="cuw_c0inPerDn" group="General" default="`${(cuw_asym &amp;&amp; pCompare0SwapEff) ? (Compare1 &lt;= cuw_period) : cuw_c0inPer}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_c1inPerDn" name="cuw_c1inPerDn" group="General" default="`${pCntCC1 &amp;&amp; ((cuw_asym &amp;&amp; pCompare1SwapEff) ? (Compare3 &lt;= cuw_period) : (Compare2 &lt;= cuw_period))}`" visible="false" editable="false" desc="" />
    <!-- Even-period (Period1) DOWN-leg match gate: in asymmetric mode the down sweep matches the buffered down value (cuw_c0Dn / cuw_c1Dn), which can differ from the up-leg even value, so test that down value against the even period; otherwise it collapses to the up-leg even reach (cuw_c0reachE / cuw_c1reachE). Needed so an asymmetric down dot is hidden when its buffered value exceeds the even period (the up dot stays gated by the main reach). -->
    <ParamBool id="cuw_c0reachEDn" name="cuw_c0reachEDn" group="General" default="`${cuw_asym ? (cuw_c0Dn &lt;= cuw_perEven) : cuw_c0reachE}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_c1reachEDn" name="cuw_c1reachEDn" group="General" default="`${pCntCC1 &amp;&amp; (cuw_asym ? (cuw_c1Dn &lt;= cuw_perEven) : cuw_c1reachE)}`" visible="false" editable="false" desc="" />
    <!-- Ordered full-period (period 3 / warm-up) up-leg reach (same crossing order as cuw_offA / cuw_offB via cuw_c0First) and down-leg reach (down crossing order via cuw_c0HiDn). In the normal in-range case every flag is true, so the waveform is byte-identical. -->
    <ParamBool id="cuw_fullReachA" name="cuw_fullReachA" group="General" default="`${cuw_c0First ? cuw_c0inPer : cuw_c1inPer}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_fullReachB" name="cuw_fullReachB" group="General" default="`${pCntCC1 ? (cuw_c0First ? cuw_c1inPer : cuw_c0inPer) : cuw_fullReachA}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_dnReachB" name="cuw_dnReachB" group="General" default="`${cuw_c0HiDn ? cuw_c0inPerDn : cuw_c1inPerDn}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_dnReachA" name="cuw_dnReachA" group="General" default="`${pCntCC1 ? (cuw_c0HiDn ? cuw_c1inPerDn : cuw_c0inPerDn) : cuw_dnReachB}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_c0reach" name="cuw_c0reach" group="General" default="`${cuw_c0inPer &amp;&amp; (cuw_isDown ? (cuw_cmp0 &lt;= cuw_cntInit) : (cuw_cmp0 &gt;= cuw_cntInit))}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_c1reach" name="cuw_c1reach" group="General" default="`${cuw_c1inPer &amp;&amp; (cuw_isDown ? (cuw_cmp1 &lt;= cuw_cntInit) : (cuw_cmp1 &gt;= cuw_cntInit))}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_offA_p1" name="cuw_offA_p1" group="General" default="`${cuw_c0First ? cuw_pxc0_p1 : cuw_pxc1_p1}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_offB_p1" name="cuw_offB_p1" group="General" default="`${pCntCC1 ? (cuw_c0First ? cuw_pxc1_p1 : cuw_pxc0_p1) : cuw_offA_p1}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_reachedA" name="cuw_reachedA" group="General" default="`${cuw_c0First ? cuw_c0reach : cuw_c1reach}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_reachedB" name="cuw_reachedB" group="General" default="`${pCntCC1 ? (cuw_c0First ? cuw_c1reach : cuw_c0reach) : cuw_reachedA}`" visible="false" editable="false" desc="" />

    <!-- Asymmetric (mode 3) makes displayed period 2 (even) behave exactly like the odd FULL periods (period 3): the up-leg matches the MAIN compare and the down-leg matches the BUFFERED compare, instead of the even-period buffered-everywhere representation used for compare/period swap in the other modes. The up-leg reach uses the FULL-period gate cuw_fullReachA/B (in-range only), NOT the period-1 init-aware cuw_reachedA/B: an even period is a complete 0..Period sweep, so its up-leg crosses every in-range compare regardless of the initial counter value. Using cuw_reachedA/B here wrongly suppressed all even-period matches when Initial Count >= a compare (e.g. Initial Count == Period made cmp >= cntInit false for every compare, killing the CC0/CC1 reaction on periods 2/4/6). cuw_fullReachA/B == cuw_reachedA/B when Initial Count is 0, and every selector below collapses to the existing even-period behaviour when not asymmetric, so center-aligned, swap and zero-init modes are byte-identical. -->
    <ParamBool id="cuw_p2reachA" name="cuw_p2reachA" group="General" default="`${(cuw_asym &amp;&amp; !pAnyPersist) ? cuw_fullReachA : cuw_reachedAE}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_p2reachB" name="cuw_p2reachB" group="General" default="`${(cuw_asym &amp;&amp; !pAnyPersist) ? cuw_fullReachB : cuw_reachedBE}`" visible="false" editable="false" desc="" />
    <!-- Even-period DOWN-leg reach in DOWN-crossing order (cuw_c0HiDn), mirroring the odd-period cuw_dnReachA/B. The even down-leg X offsets (cuw_offA_p2d / cuw_offB_p2d) and actions (cuw_actAdn / cuw_actBdn) are both ordered by cuw_c0HiDn, so the gates MUST use the same down order; reusing the UP-order cuw_reachedAE/BE here mismatched the slot-to-compare mapping and, when CC0 and CC1 trigger different actions at the same count, applied the wrong action to each down slot (a spurious zero-width spike on the even displayed period that the odd period did not have). Collapses to all-true (== the old gates) whenever every compare is in range, so in-range cases are unchanged. -->
    <ParamBool id="cuw_dnReachBE" name="cuw_dnReachBE" group="General" default="`${cuw_c0HiDn ? cuw_c0reachEDn : cuw_c1reachEDn}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_dnReachAE" name="cuw_dnReachAE" group="General" default="`${pCntCC1 ? (cuw_c0HiDn ? cuw_c1reachEDn : cuw_c0reachEDn) : cuw_dnReachBE}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_p2dnGateB" name="cuw_p2dnGateB" group="General" default="`${cuw_asym ? (1 &lt; 2) : cuw_dnReachBE}`" visible="false" editable="false" desc="" />
    <ParamBool id="cuw_p2dnGateA" name="cuw_p2dnGateA" group="General" default="`${cuw_asym ? (1 &lt; 2) : cuw_dnReachAE}`" visible="false" editable="false" desc="" />
    <!-- Even-period DOWN-leg actions: use the DOWN-crossing-order, down-ENABLED actions (cuw_actAdn / cuw_actBdn), identical to the odd periods and consistent with the down-order X offsets above. Previously the non-asymmetric branch used cuw_actAd2 / cuw_actBd2 (UP-crossing order), which swapped the per-compare action between the two down slots on the even period whenever CC0 and CC1 differ - the source of the period-1 spike. -->
    <ParamString id="cuw_p2dnB" name="cuw_p2dnB" group="General" default="`${cuw_actBdne}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_p2dnA" name="cuw_p2dnA" group="General" default="`${cuw_actAdne}`" visible="false" editable="false" desc="" />
    <!-- Period 2 (even) asymmetric compare crossing positions measured against the EVEN period terminal count (cuw_perEven), so the up-leg MAIN compare and the down-leg BUFFERED compare markers sit on the period-2 ramp even when Enable Period Swap makes perEven differ from Period0. Each value is clamped to perEven so a compare beyond the even period pins to the apex (stays on the ramp). When perEven == Period0 (no period swap) these reduce exactly to the period-scaled cuw_pxc0 / cuw_pxc0Dn used by the odd periods. -->
    <!-- Even-period (2/4/6/8) UP-leg compare value. In the asymmetric Count Up/Down - TC on OVF and UNF SHADOW-COPY case (Swapping Enable off + Compare swap on = pAnyPersist) the buffered compare is shadow-copied once at the first overflow and PERSISTS, so every subsequent up-leg (not just the down-legs) matches the buffered value - use the even/buffered compare cuw_cmp0e like the non-asymmetric persist path. In the bidirectional swap case (pAnyPersist false) the compare swaps back at each underflow, so the up-leg keeps the MAIN value (unchanged). -->
    <ParamString id="cuw_c0_p2u" name="cuw_c0_p2u" group="General" default="`${(pAnyPersist &amp;&amp; cuw_asym) ? cuw_cmp0e : ((cuw_cmp0 &gt; cuw_perEven) ? cuw_perEven : cuw_cmp0)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_c1_p2u" name="cuw_c1_p2u" group="General" default="`${(pAnyPersist &amp;&amp; cuw_asym) ? cuw_cmp1e : ((cuw_cmp1 &gt; cuw_perEven) ? cuw_perEven : cuw_cmp1)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_c0_p2d" name="cuw_c0_p2d" group="General" default="`${(cuw_c0Dn &gt; cuw_perEven) ? cuw_perEven : cuw_c0Dn}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_c1_p2d" name="cuw_c1_p2d" group="General" default="`${(cuw_c1Dn &gt; cuw_perEven) ? cuw_perEven : cuw_c1Dn}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_pxc0_p2u" name="cuw_pxc0_p2u" group="General" default="`${(cuw_c0_p2u * 120.0) / cuw_maxperX}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_pxc1_p2u" name="cuw_pxc1_p2u" group="General" default="`${(cuw_c1_p2u * 120.0) / cuw_maxperX}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_pxc0_p2d" name="cuw_pxc0_p2d" group="General" default="`${(cuw_c0_p2d * 120.0) / cuw_maxperX}`" visible="false" editable="false" desc="" />
