    <!-- Up/down (bidirectional) counting flag used to double the period for the Period Frequency calculation.
         Derived from the RESOLVED Count Direction (UpDownMode), NOT from PwmAlignment, so it is correct for every
         alignment: predefined modes map to UpDownMode automatically (LEFT->UP, RIGHT->DOWN, CENTER/asymmetric->
         UP_DOWN_1/2) and Custom mode uses the user-selected direction. When counting up/down the counter runs up
         to Period and back down, so one PWM period spans 2*(Period+1) clocks; single-direction modes span (Period+1). -->
    <ParamBool id="isUpdownPwm" name="Is PWM up/down counting" group="Actual PWM Rate" default="`${(UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_1) || (UpDownMode eq CY_TCPWM_PWM_COUNT_UP_DOWN_2)}`" visible="false" editable="false" desc="Check for Up/down configuration" />
    <ParamRange id="adjustedPeriod0" name="Adjusted Period 0" group="Actual PWM Rate" default="`${isUpdownPwm ? ((Period0 + 1) * 2) : (Period0 + 1)}`" min="0" max="`${isUpdownPwm ? ((pCntWidthMax + 1) * 2) : (pCntWidthMax + 1)}`" resolution="1" visible="false" editable="false" desc="Adjusted period to account for up/down modes" />
    <!-- Period frequency. When HRPWM is active the PERIOD register holds {Period : micro-ticks} = (Period0 &lt;&lt; pHrpwmWidth) + Period0_hrpwm,
         so the effective period is measured in micro-ticks running at pHrpwmElements * actualPwmClk. The denominator therefore scales the
         adjusted (integer, up/down-corrected) period into micro-ticks (adjustedPeriod0 * pHrpwmElements) and adds the fractional HRPWM
         micro-ticks (doubled for up/down since the peak is traversed on both ramps). With Period0_hrpwm = 0 this reduces exactly to the
         non-HRPWM frequency actualPwmClk / adjustedPeriod0. -->
    <ParamRange id="actualPwmPeriod0" name="Actual PWM Period" group="Actual PWM Rate" default="`${enable_hrpwm ? ((pHrpwmElements * actualPwmClk) / ((adjustedPeriod0 * pHrpwmElements) + (isUpdownPwm ? (Period0_hrpwm * 2) : Period0_hrpwm))) : (actualPwmClk / adjustedPeriod0)}`" min="0" max="500000000" resolution="1" visible="false" editable="false" desc="The PWM period frequency" />
    <ParamString id="pwmFreq" name="Period Frequency" group="Actual PWM Rate" default="`${(actualPwmPeriod0 &lt; 1000000) ? (actualPwmPeriod0 / 1000.0) . &quot; kHz&quot; : (actualPwmPeriod0 / 1000000.0) . &quot; MHz&quot;}`" visible="true" editable="false" desc="Frequency of the PWM terminal count period" />

