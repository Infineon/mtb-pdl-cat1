    <!--Kill Mode-->
    <ParamBool id="pwmstoponkill" name="PWM Stop on Kill" group="Kill Mode" default="true" visible="true" editable="true" desc="Specifies whether the counter stops on a kill event. Has a function in PWM, PWM_DT and PWM_PR modes only.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Unchecked:&lt;/b&gt; the kill event does NOT stop the counter; the kill behavior is then defined by PWM Sync Kill, PWM Immediate Kill and the Dead Time (DT) kill options.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Checked:&lt;/b&gt; the kill event stops the counter.&lt;/li&gt;&lt;/ul&gt;Note: enable this option to be able to stop the PWM using a SW (software) trigger." />
    <ParamBool id="pwmsynckill" name="PWM Sync Kill" group="Kill Mode" default="false" visible="true" editable="true" desc="Specifies asynchronous/synchronous kill behavior. Used only when PWM Stop on Kill is unchecked; has a function in PWM and PWM_DT modes only.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Checked (synchronous kill):&lt;/b&gt; the kill event disables the line_out and line_compl_out signals immediately. They are re-enabled at the next terminal count (TC) event after the kill event becomes inactive.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Unchecked (asynchronous kill):&lt;/b&gt; the kill event only disables the dt_line_out and dt_line_compl_out signals when present.&lt;/li&gt;&lt;/ul&gt;" />
    <ParamBool id="ImmediateKill" name="PWM Immediate Kill" group="Kill Mode" default="false" visible="true" editable="true" desc="Specifies whether the kill event deactivates the output signals immediately or with the next module clock. Has a function in PWM, PWM_DT and PWM_PR modes only.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Unchecked (synchronous kill activation):&lt;/b&gt; deactivates the line_out and line_compl_out signals with the next module clock.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Checked (immediate kill activation):&lt;/b&gt; immediately deactivates the dt_line_out and dt_line_compl_out signals.&lt;/li&gt;&lt;/ul&gt;" />
    <ParamBool id="pwmtcsynckilldt" name="PWM TC Sync Kill DT" group="Kill Mode" default="false" visible="true" editable="true" desc="Specifies Terminal Count (TC) synchronous Dead Time (DT) kill behavior. Used only when PWM Stop on Kill is unchecked; has a function in PWM_DT mode only.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Checked:&lt;/b&gt; the kill event disables the line_out and line_compl_out signals at the next TC event and until the following TC event. If Dead Time is enabled, the outputs are disabled after the TC event plus the dead time. They are re-enabled at the next TC event after the kill input becomes inactive.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Unchecked:&lt;/b&gt; TC synchronous DT kill mode is disabled.&lt;/li&gt;&lt;/ul&gt;" />
    <ParamBool id="pwmsynckilldt" name="PWM Sync Kill DT" group="Kill Mode" default="false" visible="true" editable="true" desc="Specifies synchronous Dead Time (DT) kill behavior. Used only when PWM Stop on Kill is unchecked; has a function in PWM_DT mode only.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Checked:&lt;/b&gt; the kill event disables line_out immediately, whereas line_compl_out is disabled after the dead time until the next terminal count (TC) event. Both are re-enabled at the next TC event after the kill input becomes inactive.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Unchecked:&lt;/b&gt; synchronous DT kill mode is disabled.&lt;/li&gt;&lt;/ul&gt;" />
    <ParamChoice id="KillMode" name="Kill Mode" group="Kill Mode" default="`${(pwmstoponkill) ? CY_TCPWM_PWM_STOP_ON_KILL : ((pwmsynckill) ? CY_TCPWM_PWM_SYNCH_KILL : CY_TCPWM_PWM_ASYNC_KILL)}`" visible="false" editable="false" desc="Determines what the kill signal does to the PWM. This value is derived from the PWM Stop on Kill and PWM Sync Kill options.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Asynchronous Kill:&lt;/b&gt; while the kill event is active it disables the dt_line_out and dt_line_compl_out signals when present.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Synchronous Kill:&lt;/b&gt; the kill event disables line_out and line_compl_out immediately; they are re-enabled at the next terminal count (TC) event after the kill event becomes inactive.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Stop on Kill:&lt;/b&gt; the kill event stops the counter.&lt;/li&gt;&lt;/ul&gt;" >
      <Entry name="Asynchronous Kill" value="CY_TCPWM_PWM_ASYNC_KILL" visible="true" />
      <Entry name="Synchronous Kill" value="CY_TCPWM_PWM_SYNCH_KILL" visible="true" />
      <Entry name="Stop on Kill" value="CY_TCPWM_PWM_STOP_ON_KILL" visible="true" />
    </ParamChoice>
    <ParamChoice id="kill_line_polarity" name="Kill Line Polarity" group="Kill Mode" default="CY_TCPWM_LINEOUT_AND_LINECMPOUT_IS_LOW" visible="`${(&quot;mxs40tcpwm&quot; eq getIpBlockName()) || (&quot;mxs40ppss&quot; eq getIpBlockName())}`" editable="true" desc="Specifies the levels driven on the PWM outputs line_out and line_compl_out while a kill event is active.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Line Out and Line Complementary Out is Low:&lt;/b&gt; both outputs driven to 0.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Line Out is High and Line Complementary Out is Low:&lt;/b&gt; line_out to 1, line_compl_out to 0.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Line Out is Low and Line Complementary Out is High:&lt;/b&gt; line_out to 0, line_compl_out to 1.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Line Out and Line Complementary Out is High:&lt;/b&gt; both outputs driven to 1.&lt;/li&gt;&lt;/ul&gt;" >
      <Entry name="Line Out and Line Complementary Out is Low" value="CY_TCPWM_LINEOUT_AND_LINECMPOUT_IS_LOW" visible="true" />
      <Entry name="Line Out is High and Line Complementary Out is Low" value="CY_TCPWM_LINEOUT_IS_HIGH_AND_LINECMPOUT_IS_LOW" visible="true" />
      <Entry name="Line Out is Low and Line Complementary Out is High" value="CY_TCPWM_LINECMPOUT_IS_HIGH_LINEOUT_IS_LOW" visible="true" />
      <Entry name="Line Out and Line Complementary Out is High" value="CY_TCPWM_LINEOUT_AND_LINECMPOUT_IS_HIGH" visible="true" />
    </ParamChoice>

