    <ParamChoice id="Cc0MatchEnable" name="CC0 Event generation" group="PWM signal behavior" default="`${(PwmAlignment eq CY_TCPWM_PWM_LEFT_ALIGN) ? 1 : ((PwmAlignment eq CY_TCPWM_PWM_RIGHT_ALIGN) ? 2 : (((PwmAlignment eq CY_TCPWM_PWM_CENTER_ALIGN) || (PwmAlignment eq CY_TCPWM_PWM_ASYMMETRIC_ALIGN)) ? 3 : ((PwmAlignment eq CY_TCPWM_PWM_ASYMMETRIC_CC0_CC1_ALIGN) ? 1 : ((PwmAlignment eq CY_TCPWM_PWM_CENTER_ASYMMETRIC_CC0_CC1_ALIGN) ? 1 : ((Compare0MatchUp &amp;&amp; Compare0MatchDown) ? 3 : (Compare0MatchUp ? 1 : (Compare0MatchDown ? 2 : 0)))))))}`" visible="`${pPwmNePrs &amp;&amp; pCntAMC}`" editable="`${pPwmNePrs &amp;&amp; pCntAMC &amp;&amp; (PwmAlignment eq CY_TCPWM_PWM_CUSTOM_ALIGN)}`" desc="Selects in which counting direction(s) a compare match 0 (CC0) event is generated. Controls the CC0_MATCH_UP_EN and CC0_MATCH_DOWN_EN fields of the CTRL register.&lt;ul&gt;&lt;li&gt;&lt;b&gt;None:&lt;/b&gt; no CC0 match event is generated.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Only Up:&lt;/b&gt; CC0 match event is generated only while counting up.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Only Down:&lt;/b&gt; CC0 match event is generated only while counting down.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Both:&lt;/b&gt; CC0 match event is generated in both counting directions.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Note:&lt;/b&gt; This setting takes effect only when the Count Direction is Up/Down (CNT_UPDN1/2). In single-direction Count Up or Count Down the compare match event is always generated.">
      <Entry name="None" value="0" visible="true" />
      <Entry name="Only Up" value="1" visible="true" />
      <Entry name="Only Down" value="2" visible="true" />
      <Entry name="Both" value="3" visible="true" />
    </ParamChoice>
    <ParamChoice id="Cc1MatchEnable" name="CC1 Event generation" group="PWM signal behavior" default="`${(PwmAlignment eq CY_TCPWM_PWM_ASYMMETRIC_CC0_CC1_ALIGN) ? 1 : ((PwmAlignment eq CY_TCPWM_PWM_CENTER_ASYMMETRIC_CC0_CC1_ALIGN) ? 2 : (((PwmAlignment eq CY_TCPWM_PWM_LEFT_ALIGN) || (PwmAlignment eq CY_TCPWM_PWM_RIGHT_ALIGN) || (PwmAlignment eq CY_TCPWM_PWM_CENTER_ALIGN) || (PwmAlignment eq CY_TCPWM_PWM_ASYMMETRIC_ALIGN)) ? 0 : ((Compare1MatchUp &amp;&amp; Compare1MatchDown) ? 3 : (Compare1MatchUp ? 1 : (Compare1MatchDown ? 2 : 0)))))}`" visible="`${pPwmNePrs &amp;&amp; pCntAMC &amp;&amp; pCntCC1}`" editable="`${pPwmNePrs &amp;&amp; pCntAMC &amp;&amp; pCntCC1 &amp;&amp; (PwmAlignment eq CY_TCPWM_PWM_CUSTOM_ALIGN)}`" desc="Selects in which counting direction(s) a compare match 1 (CC1) event is generated. Controls the CC1_MATCH_UP_EN and CC1_MATCH_DOWN_EN fields of the CTRL register.&lt;ul&gt;&lt;li&gt;&lt;b&gt;None:&lt;/b&gt; no CC1 match event is generated.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Only Up:&lt;/b&gt; CC1 match event is generated only while counting up.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Only Down:&lt;/b&gt; CC1 match event is generated only while counting down.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Both:&lt;/b&gt; CC1 match event is generated in both counting directions.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Note:&lt;/b&gt; This setting takes effect only when the Count Direction is Up/Down (CNT_UPDN1/2). In single-direction Count Up or Count Down the compare match event is always generated.">
      <Entry name="None" value="0" visible="true" />
      <Entry name="Only Up" value="1" visible="true" />
      <Entry name="Only Down" value="2" visible="true" />
      <Entry name="Both" value="3" visible="true" />
