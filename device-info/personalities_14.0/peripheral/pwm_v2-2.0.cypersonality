    <!-- ============================== DEAD TIME (PWM_DT mode, custom align only) ============================== -->
    <!-- In "PWM Dead Time" mode the dead-time block delays the ACTIVATING edge of each line output by a number of
         counter clocks (DT register): line_out by Line Out DT Clocks (DT_LINE_OUT), line_compl_out by Line Compl
         DT Clocks (DT_LINE_COMPL_OUT). The de-activating edge is immediate, which opens the non-overlap gap that
         prevents both outputs being active at once. Without advanced motor control (AMC) the dead time is a single
         8-bit value (DT_LINE_OUT_L) applied to BOTH outputs, so the complement delay falls back to Line Out DT
         Clocks. The dead time acts on the internal (pre-inversion) line signal, expressed here on the logical
         levels: line_out activates on a 0->1 level transition, line_compl_out (the inverted line) activates on a
         1->0 level transition. Both delays are pixel offsets that shift ONLY the relevant rising edge of the
         line_out / line_compl_out polylines to the right - the compare/event dots are not moved. Everything is
         gated by cuw_dtOn so non-DT / non-custom modes are byte-identical (offset 0). Only the always-visible
         displayed periods 1..3 are dead-time aware. -->
    <ParamBool id="cuw_dtOn" name="cuw_dtOn" group="General" default="`${pPwmNePrs &amp;&amp; (PwmMode eq CY_TCPWM_PWM_MODE_DEADTIME)}`" visible="false" editable="false" desc="" />
    <!-- Pixel-per-counter-clock on the time axis: a full period is 240 px wide; up/down spans 2*period counts over that width (120 px per count-unit), edge counts period counts (240 px). -->
    <ParamString id="cuw_dtPxClk" name="cuw_dtPxClk" group="General" default="`${cuw_isUpDown ? (120.0 / cuw_maxperX) : (240.0 / cuw_maxperX)}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_dtOutPx" name="cuw_dtOutPx" group="General" default="`${cuw_dtOn ? (DeadClocks * cuw_dtPxClk) : 0}`" visible="false" editable="false" desc="" />
    <!-- Complement delay: AMC -> its own DT_LINE_COMPL_OUT (Line Compl DT Clocks); no AMC -> the single 8-bit Line Out DT Clocks applies to both outputs. -->
    <ParamString id="cuw_dtComplPx" name="cuw_dtComplPx" group="General" default="`${cuw_dtOn ? ((pCntAMC ? DeadClocks_compl : DeadClocks) * cuw_dtPxClk) : 0}`" visible="false" editable="false" desc="" />
    <!-- Effective ("buffered / post-TC") dead-time pixel offsets. When "Swapping Enable" is unchecked the buffered
         dead time is shadow-copied into the active DT register ON the TC event and then held, so every transition
         from the first TC onward - the TC action itself (period boundary, or the apex OVF in the asymmetric
         up/down mode) and all subsequent periods - uses the buffered dead time; period 1 up to its first TC keeps
         the active DeadClocks. When swapping is on the DT buffer has no effect so pDtP2 == active and these
         collapse to cuw_dtOutPx / cuw_dtComplPx (byte-identical, also when the buffer equals the active value). -->
