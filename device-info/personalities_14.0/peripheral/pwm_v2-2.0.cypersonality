    <!-- Dead-time lead-in gap (becomes T0 when present): in custom Dead Time mode the SELECTED output's first
         activation is delayed by its dead time, so the period starts with a short INACTIVE interval (x=80 ->
         cuw_tcLX0) that would otherwise be unbracketed. cuw_tcGapShow flags it - 1 only when the start edge is
         actually delayed (cuw_tcLX0 &gt; 80) AND that first activation actually persists (seg0's run has positive
         width, cuw_tcLX0 &lt; cuw_tcRunEnd0). When the first activation is fully cancelled by dead time (on-time &lt;
         dead time, so seg0 collapses to zero width), the post-gap level equals the rest/gap level, so there is no
         real edge at cuw_tcLX0: the gap is then suppressed and the following inactive run is extended back to x=80
         via cuw_tcDX (below) so the whole interval shows as one T#. Always 0 in normal PWM where the first interval
         already starts at the period boundary (x=80). cuw_tcGapDur converts the gap pixel width back to counts, which
         equals exactly the selected output's dead-time clocks. When shown the gap is T0 and every following run's T#
         shifts up by one (cuw_tcIdx0 seeds at cuw_tcGapShow; the numeric cuw_tcCnt0 below returns the gap duration). -->
    <ParamString id="cuw_tcGapShow" name="cuw_tcGapShow" group="General" default="`${((cuw_tcLX0 &gt; 80) &amp;&amp; (cuw_tcLX0 &lt; cuw_tcRunEnd0)) ? 1 : 0}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_tcGapDur" name="cuw_tcGapDur" group="General" default="`${max(0, floor((((cuw_tcLX0 - 80) * cuw_maxper) / cuw_tmgPxPer) + 0.5))}`" visible="false" editable="false" desc="" />
