    <ParamChoice id="Cc1MatchMode" name="CC1 Match Action" group="PWM signal behavior" default="`${((PwmAlignment eq CY_TCPWM_PWM_ASYMMETRIC_CC0_CC1_ALIGN) || (PwmAlignment eq CY_TCPWM_PWM_CENTER_ASYMMETRIC_CC0_CC1_ALIGN)) ? CY_TCPWM_PWM_ACTION_CLEAR : CY_TCPWM_PWM_ACTION_NO_CHANGE}`" visible="`${pPwmNePrs &amp;&amp; pCntCC1}`" editable="`${pPwmNePrs &amp;&amp; pCntCC1 &amp;&amp; (PwmAlignment eq CY_TCPWM_PWM_CUSTOM_ALIGN)}`" desc="Determines the effect of a compare match 1 event (COUNTER equals CC1 register) on the line_out and line_compl_out output signals.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Set:&lt;/b&gt; sets line_out to 1 (line_compl_out to 0).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Clear:&lt;/b&gt; sets line_out to 0 (line_compl_out to 1).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Invert:&lt;/b&gt; toggles line_out and line_compl_out.&lt;/li&gt;&lt;li&gt;&lt;b&gt;No Change:&lt;/b&gt; leaves line_out and line_compl_out unchanged.&lt;/li&gt;&lt;/ul&gt;">
      <Entry name="Set" value="CY_TCPWM_PWM_ACTION_SET" visible="true" />
