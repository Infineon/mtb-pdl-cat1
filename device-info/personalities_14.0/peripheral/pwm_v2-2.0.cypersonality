  <Parameters>
    <!-- PDL documentation -->
    <ParamDoc id="pdlDoc" name="Configuration Help" group="Overview" default="file:///`${cy_libs_path()}`/docs/html/group__group__tcpwm__pwm.html" linkText="Open PWM (TCPWM) Documentation" visible="true" desc="Opens the Peripheral Driver Library Documentation" />

    <!-- Acronyms used in PWM behavior parameter descriptions -->
    <ParamString id="Acronyms" name="Acronyms" group="Overview" default="TC, OVF, UNF, CC0, CC1, DT, HRPWM" visible="true" editable="false" desc="Acronyms used in the PWM behavior parameter descriptions:&lt;ul&gt;&lt;li&gt;&lt;b&gt;TC&lt;/b&gt; - Terminal Count&lt;/li&gt;&lt;li&gt;&lt;b&gt;OVF&lt;/b&gt; - Overflow (COUNTER reaches Period)&lt;/li&gt;&lt;li&gt;&lt;b&gt;UNF&lt;/b&gt; - Underflow (COUNTER reaches 0)&lt;/li&gt;&lt;li&gt;&lt;b&gt;CC0&lt;/b&gt; - Compare/Capture 0&lt;/li&gt;&lt;li&gt;&lt;b&gt;CC1&lt;/b&gt; - Compare/Capture 1&lt;/li&gt;&lt;li&gt;&lt;b&gt;DT&lt;/b&gt; - Dead Time&lt;/li&gt;&lt;li&gt;&lt;b&gt;HRPWM&lt;/b&gt; - High-Resolution PWM&lt;/li&gt;&lt;/ul&gt;" />

    <!--General-->
    <ParamRange id="pCntGroup" name="pCntGroup" desc="pCntGroup" group="Internal"  default="`${getInstNumber(&quot;group&quot;)}`" min="0" max="3" resolution="1" visible="false" editable="false" />
    <ParamRange id="pMaxGroupCount" name="pMaxGroupCount" desc="pMaxGroupCount" group="Internal"  default="4" min="0" max="4" resolution="1" visible="false" editable="false" />
    <ParamString id="pCntWidthEx" name="pCntWidthEx" desc="pCntWidthEx" group="Internal"  default="GRP_NR[`${pCntGroup}`].CNT.GRP_CNT_WIDTH" visible="false" editable="false" />
    <ParamRange id="pCntWidth" name="pCntWidth" desc="pCntWidth" group="Internal"  default="`${lookupExpression(pCntWidthEx)}`" min="0" max="32" resolution="1" visible="false" editable="false" />
    <ParamRange id="pCntWidthMax" name="pCntWidthMax" desc="pCntWidthMax" group="Internal"  default="`${pow(2, pCntWidth)-1}`" min="0" max="4294967296" resolution="1" visible="false" editable="false" />
    <ParamRange id="tcpwmInst" name="TCPWM Number" group="Internal" default="`${getInstNumber(&quot;tcpwm&quot;)}`" min="0" max="3" resolution="1" visible="false" editable="false" desc="" />
    <ParamRange id="cntInstNum" name="Counter Number" group="Internal" default="`${getInstNumber(&quot;cnt&quot;)}`" min="0" max="1024" resolution="1" visible="false" editable="false" desc="" />
    <ParamRange id="cntInst" name="CNT Number" group="Internal" default="`${getInstNumber(&quot;cnt&quot;) + pCntGroup * 256}`" min="0" max="1023" resolution="1" visible="false" editable="false" desc="" />
    <ParamString id="pCntCC1Ex" name="pCntCC1Ex" desc="pCntCC1Ex" group="Internal" default="GRP_NR[`${pCntGroup}`].CNT.GRP_CC1_PRESENT" visible="false" editable="false" />
    <ParamBool id="pCntCC1" name="pCntCC1" desc="pCntCC1" group="Internal" default="`${lookupExpression(pCntCC1Ex) eq 1}`" visible="false" editable="false" />
    <ParamString id="pCntAMCEx" name="pCntAMCEx" desc="pCntAMCEx" group="Internal" default="GRP_NR[`${pCntGroup}`].CNT.GRP_AMC_PRESENT" visible="false" editable="false" />
    <ParamBool id="pCntAMC" name="pCntAMC" desc="pCntAMC" group="Internal" default="`${lookupExpression(pCntAMCEx) eq 1}`" visible="false" editable="false" />
    <ParamString id="pCntParallelPathEx" name="pCntParallelPathEx" desc="pCntParallelPathEx" group="Internal" default="GRP_NR[`${pCntGroup}`].CNT.GRP_DATA_IN_CC_PRESENT" visible="false" editable="false" />
    <ParamBool id="pCntParallelPath" name="pCntParallelPath" desc="Parallel data path for CC0/CC1 present for this counter group" group="Internal" default="`${lookupExpression(pCntParallelPathEx, 0) ne 0}`" visible="false" editable="false" />
    <ParamBool id="pPPCABlock" name="PPCA Block" desc="Is from PPCA Block" group="Internal" default="`${(&quot;mxs40ppss&quot; eq getIpBlockName())}`" visible="false" editable="false" />
    <!-- Platform flag params — computed from IP block name for cross-platform ExposedMember support -->
    <ParamBool id="isMxs40tcpwm" name="isMxs40tcpwm" group="Internal" default="`${&quot;mxs40tcpwm&quot; eq getIpBlockName()}`" visible="false" editable="false" desc="True when IP block is mxs40tcpwm" />
    <ParamBool id="isMxs40ppss"  name="isMxs40ppss"  group="Internal" default="`${&quot;mxs40ppss&quot;  eq getIpBlockName()}`" visible="false" editable="false" desc="True when IP block is mxs40ppss (PPCA)" />
    <ParamBool id="pHasDCMask" name="Has DC/Mask" desc="DC and Mask features present (mxs40tcpwm or mxs40ppss)" group="Internal" default="`${((&quot;mxs40tcpwm&quot; eq getIpBlockName()) &amp;&amp; (GENERATED.IP_MINOR_VERSION &gt; 0)) || (&quot;mxs40ppss&quot; eq getIpBlockName())}`" visible="false" editable="false" />
    <ParamBool id="debug" name="debug" group="Internal" default="false" visible="false" editable="false" desc="Set this to true to expose debug-only parameters" />

    <ParamString id="TCPWM_version" name="TCPWM Version" group="General" default="TCPWM_ver2" visible="false" editable="false" desc="Version of the TCPWM hardware block"/>

    <ParamChoice id="PwmMode" name="PWM Mode" group="General" default="CY_TCPWM_PWM_MODE_PWM" visible="true" editable="true" desc="Selects the PWM mode of operation.&lt;ul&gt;&lt;li&gt;&lt;b&gt;PWM:&lt;/b&gt; standard pulse-width modulation output.&lt;/li&gt;&lt;li&gt;&lt;b&gt;PWM Dead Time:&lt;/b&gt; inserts a configurable DT (Dead Time) delay between the line_out and line_compl_out transitions.&lt;/li&gt;&lt;li&gt;&lt;b&gt;PWM Pseudo random:&lt;/b&gt; generates a pseudo-random output using an LFSR (not available on all blocks).&lt;/li&gt;&lt;/ul&gt;">
      <Entry name="PWM" value="CY_TCPWM_PWM_MODE_PWM" visible="true" />
      <Entry name="PWM Dead Time" value="CY_TCPWM_PWM_MODE_DEADTIME" visible="true" />
      <Entry name="PWM Pseudo random" value="CY_TCPWM_PWM_MODE_PSEUDORANDOM" visible="`${(&quot;mxs40tcpwm&quot; ne getIpBlockName()) &amp;&amp;  !pPPCABlock}`" />
    </ParamChoice>
    <ParamBool id="pPwmNePrs" name="pPwmNePrs" desc="pPwmNePrs" group="Internal" default="`${PwmMode ne CY_TCPWM_PWM_MODE_PSEUDORANDOM}`" visible="false" editable="false" />

    <ParamChoice id="ClockPrescaler" name="Clock Prescaler" group="General" default="CY_TCPWM_PWM_PRESCALER_DIVBY_1" visible="`${(PwmMode ne CY_TCPWM_PWM_MODE_DEADTIME) || (&quot;mxs40tcpwm&quot; eq getIpBlockName())}`" editable="true" desc="Divides down the input clock to set the counter clock.&lt;br&gt;&lt;br&gt;A higher divider lowers the counter clock, increasing the PWM period at the cost of resolution. Not available in PWM Dead Time mode on some blocks." >
      <Entry name="Divide by 1" value="CY_TCPWM_PWM_PRESCALER_DIVBY_1" visible="true" />
      <Entry name="Divide by 2" value="CY_TCPWM_PWM_PRESCALER_DIVBY_2" visible="true" />
      <Entry name="Divide by 4" value="CY_TCPWM_PWM_PRESCALER_DIVBY_4" visible="true" />
      <Entry name="Divide by 8" value="CY_TCPWM_PWM_PRESCALER_DIVBY_8" visible="true" />
      <Entry name="Divide by 16" value="CY_TCPWM_PWM_PRESCALER_DIVBY_16" visible="true" />
      <Entry name="Divide by 32" value="CY_TCPWM_PWM_PRESCALER_DIVBY_32" visible="true" />
      <Entry name="Divide by 64" value="CY_TCPWM_PWM_PRESCALER_DIVBY_64" visible="true" />
      <Entry name="Divide by 128" value="CY_TCPWM_PWM_PRESCALER_DIVBY_128" visible="true" />
    </ParamChoice>
    <ParamChoice id="Resolution" name="PWM Resolution" group="General" default="`${(pCntWidth eq 16) ? &quot;CY_TCPWM_PWM_RESOLUTION_WIDTH_16_BITS&quot; : &quot;CY_TCPWM_PWM_RESOLUTION_WIDTH_32_BITS&quot;}`" visible="true" editable="false" desc="Shows the counter width of the PWM, determined by the hardware block.&lt;ul&gt;&lt;li&gt;&lt;b&gt;16-bits:&lt;/b&gt; Period and Compare range 0–65535.&lt;/li&gt;&lt;li&gt;&lt;b&gt;32-bits:&lt;/b&gt; Period and Compare range 0–4294967295.&lt;/li&gt;&lt;/ul&gt;This field is read-only.">
      <Entry name="16-bits" value="CY_TCPWM_PWM_RESOLUTION_WIDTH_16_BITS" visible="true" />
      <Entry name="32-bits" value="CY_TCPWM_PWM_RESOLUTION_WIDTH_32_BITS" visible="true" />
    </ParamChoice>

    <ParamChoice id="PwmAlignment" name="PWM Configurations" group="PWM signal behavior" default="CY_TCPWM_PWM_LEFT_ALIGN" visible="`${pPwmNePrs}`" editable="true" desc="Selects a predefined PWM configuration or &lt;b&gt;Custom&lt;/b&gt;. A predefined configuration presets the counter direction, initial counter value and the per-event line actions (CC0/CC1 match, overflow, underflow); &lt;b&gt;Custom&lt;/b&gt; unlocks those CTRL, COUNTER and TR_PWM_CTRL register fields for explicit editing.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Left Aligned:&lt;/b&gt; up-counting. line_out starts high and is cleared on the CC0 match, giving a pulse aligned to the start of the period.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Right Aligned:&lt;/b&gt; down-counting. line_out starts low and is set on the CC0 match, giving a pulse aligned to the end of the period.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Center Aligned:&lt;/b&gt; up/down-counting. line_out is toggled on each CC0 match so the pulse is centered. Pulse width = 2 x (PERIOD - CC0).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Asymmetric:&lt;/b&gt; up/down-counting with a CC0 match on each leg. Pulse width = 2 x PERIOD - CC0 - CC0_buff.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Asymmetric CC0 &amp; CC1:&lt;/b&gt; up-counting with independent CC0 and CC1 matches that define the pulse edges. Pulse width = CC1 - CC0.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Center Asymmetric CC0 &amp; CC1:&lt;/b&gt; up/down-counting with independent CC0 and CC1 matches. Pulse width = 2 x PERIOD - CC0 - CC1.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Custom:&lt;/b&gt; user-defined. Set the Count Direction, Initial Counter Value and the CC0/CC1/Overflow/Underflow actions explicitly to build a non-standard waveform.&lt;/li&gt;&lt;/ul&gt;" >
      <Entry name="Left Aligned" value="CY_TCPWM_PWM_LEFT_ALIGN" visible="true" />
      <Entry name="Right Aligned" value="CY_TCPWM_PWM_RIGHT_ALIGN" visible="true" />
      <Entry name="Center Aligned" value="CY_TCPWM_PWM_CENTER_ALIGN" visible="true" />
      <Entry name="Center Time Based" value="CY_TCPWM_PWM_CENTER_TIMEBASED_ALIGN" visible="`${pCntAMC}`" />
      <Entry name="Center External Event" value="CY_TCPWM_PWM_CENTER_EXTERNAL_EVENT_ALIGN" visible="`${pCntAMC &amp;&amp; pHasDCMask}`" />
      <Entry name="Asymmetric" value="CY_TCPWM_PWM_ASYMMETRIC_ALIGN" visible="true" />
      <Entry name="Asymmetric CC0 &amp; CC1" value="CY_TCPWM_PWM_ASYMMETRIC_CC0_CC1_ALIGN" visible="`${pCntAMC}`" />
      <Entry name="Center Asymmetric CC0 &amp; CC1" value="CY_TCPWM_PWM_CENTER_ASYMMETRIC_CC0_CC1_ALIGN" visible="`${pCntAMC}`" />
      <Entry name="Custom" value="CY_TCPWM_PWM_CUSTOM_ALIGN" visible="`${(&quot;mxs40tcpwm&quot; eq getIpBlockName()) || (&quot;mxs40ppss&quot; eq getIpBlockName())}`" />
    </ParamChoice>
    <ParamBool id="SwapUnderflowOverflow" name="Swap Underflow Overflow Set/Clear" group="General" default="false" visible="`${((pPwmNePrs) &amp;&amp; ((PwmAlignment eq CY_TCPWM_PWM_CENTER_ALIGN) || (PwmAlignment eq CY_TCPWM_PWM_ASYMMETRIC_ALIGN)))}`" editable="true" desc="Swaps the Set/Clear actions applied to the PWM output on the UNF (Underflow) and OVF (Overflow) events.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Checked:&lt;/b&gt; the output is SET on UNF and CLEARED on OVF.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Unchecked:&lt;/b&gt; the output is CLEARED on UNF and SET on OVF.&lt;/li&gt;&lt;/ul&gt;" />
    <ParamChoice id="UpDownMode" name="Count Direction" group="PWM signal behavior" default="`${(PwmAlignment eq CY_TCPWM_PWM_LEFT_ALIGN) ? CY_TCPWM_PWM_COUNT_UP : (PwmAlignment eq CY_TCPWM_PWM_RIGHT_ALIGN) ? CY_TCPWM_PWM_COUNT_DOWN : (PwmAlignment eq CY_TCPWM_PWM_ASYMMETRIC_ALIGN) ? CY_TCPWM_PWM_COUNT_UP_DOWN_2 : (PwmAlignment eq CY_TCPWM_PWM_ASYMMETRIC_CC0_CC1_ALIGN) ? CY_TCPWM_PWM_COUNT_UP : CY_TCPWM_PWM_COUNT_UP_DOWN_1}`" visible="`${pPwmNePrs}`" editable="`${pPwmNePrs &amp;&amp; (PwmAlignment eq CY_TCPWM_PWM_CUSTOM_ALIGN)}`" desc="Determines the counter counting direction.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Count Up:&lt;/b&gt; counts up to Period. An OVF event and a TC event are generated when the counter reaches Period.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Count Down:&lt;/b&gt; counts down to 0. A UNF event and a TC event are generated when the counter reaches 0.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Count Up/Down - TC on UNF:&lt;/b&gt; counts up to Period, then down to 0. An OVF event is generated at Period and a UNF event at 0; the TC event is generated only at 0.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Count Up/Down - TC on OVF and UNF:&lt;/b&gt; counts up to Period, then down to 0. An OVF event is generated at Period and a UNF event at 0; the TC event is generated at both Period and 0 (used for PWM with asymmetrical updates).&lt;/li&gt;&lt;/ul&gt;">
      <Entry name="Up" value="CY_TCPWM_PWM_COUNT_UP" visible="true" />
      <Entry name="Down" value="CY_TCPWM_PWM_COUNT_DOWN" visible="true" />
      <Entry name="Up/Down - TC on UNF" value="CY_TCPWM_PWM_COUNT_UP_DOWN_1" visible="true" />
      <Entry name="Up/Down - TC on OVF and UNF" value="CY_TCPWM_PWM_COUNT_UP_DOWN_2" visible="true" />
    </ParamChoice>
    <ParamChoice id="CounterInit" name="Initial Counter Value" group="PWM signal behavior" default="`${(PwmAlignment eq CY_TCPWM_PWM_RIGHT_ALIGN) ? &quot;period&quot; : (PwmAlignment eq CY_TCPWM_PWM_LEFT_ALIGN) ? 0 : 1}`" visible="`${pPwmNePrs}`" editable="`${pPwmNePrs &amp;&amp; (PwmAlignment eq CY_TCPWM_PWM_CUSTOM_ALIGN)}`" desc="Determines the value loaded into the counter when it starts.&lt;ul&gt;&lt;li&gt;&lt;b&gt;0 (Up Counting):&lt;/b&gt; counter starts from 0, typically used for up-counting.&lt;/li&gt;&lt;li&gt;&lt;b&gt;1 (Up/Down Counting):&lt;/b&gt; counter starts from 1, typically used for up/down-counting.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Period:&lt;/b&gt; counter starts from the Period value, typically used for down-counting.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Custom:&lt;/b&gt; counter starts from a user-defined value entered in Custom Value.&lt;/li&gt;&lt;/ul&gt;">
      <Entry name="0 (Up Counting)" value="0" visible="true" />
      <Entry name="1 (Up/Down Counting)" value="1" visible="true" />
      <Entry name="Period (Down Counting)" value="period" visible="true" />
      <Entry name="Custom" value="custom" visible="true" />
    </ParamChoice>
    <ParamRange id="CounterInitCustom" name="Custom Value" group="PWM signal behavior" default="0" min="0" max="`${pCntWidthMax}`" resolution="1" visible="`${pPwmNePrs &amp;&amp; (PwmAlignment eq CY_TCPWM_PWM_CUSTOM_ALIGN) &amp;&amp; (CounterInit eq &quot;custom&quot;)}`" editable="`${pPwmNePrs &amp;&amp; (PwmAlignment eq CY_TCPWM_PWM_CUSTOM_ALIGN) &amp;&amp; (CounterInit eq &quot;custom&quot;)}`" desc="User-defined value loaded into the counter when it starts. Used when &lt;b&gt;Initial Counter Value&lt;/b&gt; is set to &lt;b&gt;Custom&lt;/b&gt;.&lt;ul&gt;&lt;li&gt;&lt;b&gt;16 bit resolution:&lt;/b&gt; 0 - 65535.&lt;/li&gt;&lt;li&gt;&lt;b&gt;32 bit resolution:&lt;/b&gt; 0 - 4294967295.&lt;/li&gt;&lt;/ul&gt;" />
    <ParamChoice id="Cc0MatchMode" name="CC0 Match Action" group="PWM signal behavior" default="`${(PwmAlignment eq CY_TCPWM_PWM_LEFT_ALIGN) ? CY_TCPWM_PWM_ACTION_CLEAR : ((PwmAlignment eq CY_TCPWM_PWM_RIGHT_ALIGN) || (PwmAlignment eq CY_TCPWM_PWM_ASYMMETRIC_CC0_CC1_ALIGN) || (PwmAlignment eq CY_TCPWM_PWM_CENTER_ASYMMETRIC_CC0_CC1_ALIGN)) ? CY_TCPWM_PWM_ACTION_SET : CY_TCPWM_PWM_ACTION_INVERT}`" visible="`${pPwmNePrs}`" editable="`${pPwmNePrs &amp;&amp; (PwmAlignment eq CY_TCPWM_PWM_CUSTOM_ALIGN)}`" desc="Determines the effect of a compare match 0 event (COUNTER equals CC0 register) on the line_out and line_compl_out output signals. INVERT is especially useful for center aligned PWM.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Set:&lt;/b&gt; sets line_out to 1 (line_compl_out to 0).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Clear:&lt;/b&gt; sets line_out to 0 (line_compl_out to 1).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Invert:&lt;/b&gt; toggles line_out and line_compl_out.&lt;/li&gt;&lt;li&gt;&lt;b&gt;No Change:&lt;/b&gt; leaves line_out and line_compl_out unchanged.&lt;/li&gt;&lt;/ul&gt;To generate a duty cycle of 0%, set the CC0 register to 0. For a 100% duty cycle, set the CC0 register larger than the PERIOD register.">
      <Entry name="Set" value="CY_TCPWM_PWM_ACTION_SET" visible="true" />
