    <!-- GRP_HRPWM_WIDTH is a synthesis parameter that some device models do not expose as a queryable characteristic. When absent, fall back to 6 bits (the common TCPWM HRPWM width, i.e. 64 micro ticks) so the HRPWM Ticks range is usable on those devices. -->
    <ParamRange id="pHrpwmWidth" name="pHrpwmWidth" desc="pHrpwmWidth" group="HRPWM"  default="`${lookupExpression(pHrpwmWidthEx, 6)}`" min="0" max="32" resolution="1" visible="false" editable="false" />
    <ParamRange id="pHrpwmElements" name="pHrpwmElements" desc="pHrpwmElements" group="HRPWM"  default="`${pow(2,pHrpwmWidth)}`" min="0" max="4096" resolution="1" visible="false" editable="false" />

    <ParamBool id="enable_hrpwm" name="Enable HRPWM" group="HRPWM" default="false" visible="`${pCnthrpwm}`" editable="true" desc="Enables HRPWM (High-Resolution PWM), which refines the placement of the Period and Compare edges to sub-counter-clock resolution and is available only in &lt;b&gt;PWM&lt;/b&gt; and &lt;b&gt;PWM Dead Time&lt;/b&gt; modes on counters that support the feature.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Checked:&lt;/b&gt; HRPWM is enabled.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Unchecked:&lt;/b&gt; HRPWM is disabled.&lt;/li&gt;&lt;/ul&gt;When enabled, the bottom GRP_HRPWM_WIDTH bits of each affected register are re-purposed as an HRPWM micro-tick value. A dedicated micro-tick (LSB) parameter is provided for each affected value; the value programmed into the register is the concatenation &lt;b&gt;{main value : HRPWM micro-ticks}&lt;/b&gt; = (main value &amp;lt;&amp;lt; GRP_HRPWM_WIDTH) + micro-ticks. The entered main value is not changed - it is only shifted into the upper bits and extended with the micro-ticks.&lt;br&gt;&lt;br&gt;Affected parameters (each has a matching &lt;b&gt;... HRPWM Ticks&lt;/b&gt; field):&lt;ul&gt;&lt;li&gt;&lt;b&gt;Period&lt;/b&gt; (PERIOD register)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Period Buff&lt;/b&gt; (PERIOD_BUFF register)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Compare 0&lt;/b&gt; (CC0 register)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Compare 0 Buff&lt;/b&gt; (CC0_BUFF register)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Compare 1&lt;/b&gt; (CC1 register)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Compare 1 Buff&lt;/b&gt; (CC1_BUFF register)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Line Out DT Clocks&lt;/b&gt; (DT_LINE_OUT register, on devices with AMC support)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Line Compl DT Clocks&lt;/b&gt; (DT_LINE_COMPL_OUT register, on devices with AMC support)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Line Out DT Clocks Buff&lt;/b&gt; (DT_BUFF_LINE_OUT register, on devices with AMC support)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Line Compl DT Clocks Buff&lt;/b&gt; (DT_BUFF_LINE_COMPL_OUT register, on devices with AMC support)&lt;/li&gt;&lt;/ul&gt;Each micro-tick field ranges from 0 to 2^GRP_HRPWM_WIDTH - 1.&lt;br&gt;&lt;br&gt;&lt;b&gt;Constraint:&lt;/b&gt; the Clock Prescaler must be &lt;b&gt;Divide by 1&lt;/b&gt; (PS_DIV = 0) for HRPWM to work on the counter output." />

    <!-- HRPWM is applicable only when it is present, enabled and the counter is in PWM or PWM Dead Time mode. -->
    <ParamBool id="pHrpwmActive" name="pHrpwmActive" desc="HRPWM present, enabled and in a mode that supports it (PWM or PWM Dead Time)" group="Internal" default="`${pCnthrpwm &amp;&amp; enable_hrpwm &amp;&amp; ((PwmMode eq CY_TCPWM_PWM_MODE_PWM) || (PwmMode eq CY_TCPWM_PWM_MODE_DEADTIME))}`" visible="false" editable="false" />

    <!--Period-->
    <ParamRange id="Period0" name="Period" group="Period" default="32768" min="0" max="`${pCntWidthMax}`" resolution="1" visible="true" editable="true" desc="Sets the period of the counter (the maximum count value). When COUNTER reaches this value an OVF (Overflow) / TC (Terminal Count) event is generated.&lt;br&gt;&lt;br&gt;&lt;b&gt;Range:&lt;/b&gt; 0–65535 (16-bit resolution) or 0–4294967295 (32-bit resolution).`${pCnthrpwm ? (&quot;&lt;br&gt;&lt;br&gt;When &lt;b&gt;HRPWM&lt;/b&gt; is enabled, the low &quot; . pHrpwmWidth . &quot; bits of the PERIOD register are used by the paired &lt;b&gt;Period HRPWM Ticks&lt;/b&gt; field, so the effective usable range of this value is reduced to the upper &quot; . (pCntWidth - pHrpwmWidth) . &quot; bits.&lt;br&gt;&lt;b&gt;HRPWM Integer range:&lt;/b&gt; 0-&quot; . (pow(2, 16 - pHrpwmWidth) - 1) . &quot; (16-bit resolution) or 0-&quot; . (pow(2, 32 - pHrpwmWidth) - 1) . &quot; (32-bit resolution).&quot;) : &quot;&quot;}`" />
    <ParamRange id="Period0_hrpwm" name="Period HRPWM Ticks" group="Period" default="0" min="0" max="`${pHrpwmElements - 1}`" resolution="1" visible="`${pHrpwmActive}`" editable="true" desc="HRPWM micro-tick value placed in the bottom `${pHrpwmWidth}` bits of the PERIOD register. The value written to hardware is {Period : micro-ticks} = (Period &amp;lt;&amp;lt; `${pHrpwmWidth}`) + this value, adding sub-counter-clock resolution to the period without changing the entered Period.&lt;br&gt;&lt;br&gt;&lt;b&gt;Range:&lt;/b&gt; 0 to `${pHrpwmElements - 1}`. Available only when HRPWM is enabled (PWM and PWM Dead Time modes)." />
    <ParamBool id="EnablePeriodSwap" name="Enable Period `${swap_enable ? &quot;Switch&quot; : &quot;Update&quot;}`" group="Period" default="false" visible="`${!(PwmMode eq CY_TCPWM_PWM_MODE_PSEUDORANDOM)}`" editable="true" desc="`${((isMxs40tcpwm || pPPCABlock) &amp;&amp; !swap_enable) ? &quot;Specifies updating of the active Period from the buffered Period (Period Buff) value.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Checked:&lt;/b&gt; the Period Buff value is shadow-copied into the active Period on a TC (Terminal Count) event when an update is pending; the Period Buff value itself is retained.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Unchecked:&lt;/b&gt; the active Period is never updated from Period Buff.&lt;/li&gt;&lt;/ul&gt;When enabled, the &lt;b&gt;Period Buff&lt;/b&gt; field becomes available.&quot; : &quot;Specifies switching of the Period and buffered Period (Period Buff) values.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Checked:&lt;/b&gt; the active Period and Period Buff are swapped on a TC (Terminal Count) event when a switch is pending.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Unchecked:&lt;/b&gt; the values are never switched.&lt;/li&gt;&lt;/ul&gt;When enabled, the &lt;b&gt;Period Buff&lt;/b&gt; field becomes available.&quot;}`" />
    <ParamRange id="Period1" name="Period Buff" group="Period" default="32768" min="0" max="`${pCntWidthMax}`" resolution="1" visible="`${EnablePeriodSwap}`" editable="true" desc="Sets the buffered period value. When Period swapping is enabled, this value is swapped into the active Period register on a TC (Terminal Count) event.&lt;br&gt;&lt;br&gt;&lt;b&gt;Range:&lt;/b&gt; 0–65535 (16-bit resolution) or 0–4294967295 (32-bit resolution).`${pCnthrpwm ? (&quot;&lt;br&gt;&lt;br&gt;When &lt;b&gt;HRPWM&lt;/b&gt; is enabled, the low &quot; . pHrpwmWidth . &quot; bits of the PERIOD_BUFF register are used by the paired &lt;b&gt;Period Buff HRPWM Ticks&lt;/b&gt; field, so the effective usable range of this value is reduced to the upper &quot; . (pCntWidth - pHrpwmWidth) . &quot; bits.&lt;br&gt;&lt;b&gt;HRPWM Integer range:&lt;/b&gt; 0-&quot; . (pow(2, 16 - pHrpwmWidth) - 1) . &quot; (16-bit resolution) or 0-&quot; . (pow(2, 32 - pHrpwmWidth) - 1) . &quot; (32-bit resolution).&quot;) : &quot;&quot;}`" />
    <ParamRange id="Period1_hrpwm" name="Period Buff HRPWM Ticks" group="Period" default="0" min="0" max="`${pHrpwmElements - 1}`" resolution="1" visible="`${pHrpwmActive &amp;&amp; EnablePeriodSwap}`" editable="true" desc="HRPWM micro-tick value placed in the bottom `${pHrpwmWidth}` bits of the PERIOD_BUFF register. The value written to hardware is {Period Buff : micro-ticks} = (Period Buff &amp;lt;&amp;lt; `${pHrpwmWidth}`) + this value, adding sub-counter-clock resolution to the buffered period without changing the entered Period Buff.&lt;br&gt;&lt;br&gt;&lt;b&gt;Range:&lt;/b&gt; 0 to `${pHrpwmElements - 1}`. Available only when HRPWM is enabled (PWM and PWM Dead Time modes)." />

    <!--Taps Enabled-->
    <ParamRange id="TapsEnabled" name="Taps Enabled" group="Taps Enabled" default="45" min="0" max="`${pCntWidthMax}`" resolution="1" visible="`${PwmMode eq CY_TCPWM_PWM_MODE_PSEUDORANDOM}`" editable="true" desc="Sets the tap value. Range: 0-65535 (for 16 bit resolution) or 0–4294967295 (for 32 bit resolution)." />

    <!--Compare-->
    <ParamRange id="Compare0" name="Compare 0" group="Compare 0" default="16384" min="0" max="`${pCntWidthMax}`" resolution="1" visible="true" editable="true" desc="Sets the Compare 0 (CC0) value. A compare match (cc0_match) event is generated when COUNTER equals this value, which modify the PWM output according to the configured compare action.&lt;br&gt;&lt;br&gt;&lt;b&gt;Range:&lt;/b&gt; 0–65535 (16-bit resolution) or 0–4294967295 (32-bit resolution).`${pCnthrpwm ? (&quot;&lt;br&gt;&lt;br&gt;When &lt;b&gt;HRPWM&lt;/b&gt; is enabled, the low &quot; . pHrpwmWidth . &quot; bits of the CC0 register are used by the paired &lt;b&gt;Compare 0 HRPWM Ticks&lt;/b&gt; field, so the effective usable range of this value is reduced to the upper &quot; . (pCntWidth - pHrpwmWidth) . &quot; bits.&lt;br&gt;&lt;b&gt;HRPWM Integer range:&lt;/b&gt; 0-&quot; . (pow(2, 16 - pHrpwmWidth) - 1) . &quot; (16-bit resolution) or 0-&quot; . (pow(2, 32 - pHrpwmWidth) - 1) . &quot; (32-bit resolution).&quot;) : &quot;&quot;}`" />
    <ParamRange id="Compare0_hrpwm" name="Compare 0 HRPWM Ticks" group="Compare 0" default="0" min="0" max="`${pHrpwmElements - 1}`" resolution="1" visible="`${pHrpwmActive}`" editable="true" desc="HRPWM micro-tick value placed in the bottom `${pHrpwmWidth}` bits of the CC0 (Compare 0) register. The value written to hardware is {Compare 0 : micro-ticks} = (Compare 0 &amp;lt;&amp;lt; `${pHrpwmWidth}`) + this value, adding sub-counter-clock resolution to the compare edge without changing the entered Compare 0.&lt;br&gt;&lt;br&gt;&lt;b&gt;Range:&lt;/b&gt; 0 to `${pHrpwmElements - 1}`. Available only when HRPWM is enabled (PWM and PWM Dead Time modes)." />
    <ParamBool id="EnableCompare0Swap" name="Enable Compare 0 `${swap_enable ? &quot;Switch&quot; : &quot;Update&quot;}`" group="Compare 0" default="false" visible="true" editable="true" desc="`${((isMxs40tcpwm || pPPCABlock) &amp;&amp; !swap_enable) ? &quot;Specifies updating of the active CC0 (Compare 0) from the buffered CC0 (Compare 0 Buff) value.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Checked:&lt;/b&gt; the Compare 0 Buff value is shadow-copied into the active Compare 0 on a TC (Terminal Count) event when an update is pending; the Compare 0 Buff value itself is retained.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Unchecked:&lt;/b&gt; the active Compare 0 is never updated from Compare 0 Buff.&lt;/li&gt;&lt;/ul&gt;When enabled, the &lt;b&gt;Compare 0 Buff&lt;/b&gt; field becomes available.&quot; : &quot;Specifies switching of the CC0 (Compare 0) and buffered CC0 (Compare 0 Buff) values.&lt;ul&gt;&lt;li&gt;&lt;b&gt;Checked:&lt;/b&gt; the active Compare 0 and Compare 0 Buff are swapped on a TC (Terminal Count) event when a switch is pending.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Unchecked:&lt;/b&gt; the values are never switched.&lt;/li&gt;&lt;/ul&gt;When enabled, the &lt;b&gt;Compare 0 Buff&lt;/b&gt; field becomes available.&quot;}`" />
