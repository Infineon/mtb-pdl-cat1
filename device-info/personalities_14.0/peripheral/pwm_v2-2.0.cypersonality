      <Substitution name="R1_GOB" value="`${(min(770,max(70,70+(cuw_xB2_Os-cuw_b1)*dtc_s1)) - min(770,max(70,70+(cuw_xB2-cuw_b1)*dtc_s1))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R1_GOR" value="`${(min(770,max(70,70+(cuw_rx3_Os-cuw_b1)*dtc_s1)) - min(770,max(70,70+(cuw_rx3-cuw_b1)*dtc_s1))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R1_GOC" value="`${(min(770,max(70,70+(cuw_xC2_Os-cuw_b1)*dtc_s1)) - min(770,max(70,70+(cuw_xC2-cuw_b1)*dtc_s1))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R1_GOD" value="`${(min(770,max(70,70+(cuw_xD2_Os-cuw_b1)*dtc_s1)) - min(770,max(70,70+(cuw_xD2-cuw_b1)*dtc_s1))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R1_GOE" value="`${(min(770,max(70,70+(cuw_b2_Os-cuw_b1)*dtc_s1)) - min(770,max(70,70+(cuw_b2-cuw_b1)*dtc_s1))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R1_GCA" value="`${(min(770,max(70,70+(cuw_xA2_Cs-cuw_b1)*dtc_s1)) - min(770,max(70,70+(cuw_xA2-cuw_b1)*dtc_s1))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R1_GCB" value="`${(min(770,max(70,70+(cuw_xB2_Cs-cuw_b1)*dtc_s1)) - min(770,max(70,70+(cuw_xB2-cuw_b1)*dtc_s1))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R1_GCR" value="`${(min(770,max(70,70+(cuw_rx3_Cs-cuw_b1)*dtc_s1)) - min(770,max(70,70+(cuw_rx3-cuw_b1)*dtc_s1))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R1_GCC" value="`${(min(770,max(70,70+(cuw_xC2_Cs-cuw_b1)*dtc_s1)) - min(770,max(70,70+(cuw_xC2-cuw_b1)*dtc_s1))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R1_GCD" value="`${(min(770,max(70,70+(cuw_xD2_Cs-cuw_b1)*dtc_s1)) - min(770,max(70,70+(cuw_xD2-cuw_b1)*dtc_s1))) &gt; 0.5 ? 1.0 : 0.0}`" />
      <Substitution name="R1_GCE" value="`${(min(770,max(70,70+(cuw_b2_Cs-cuw_b1)*dtc_s1)) - min(770,max(70,70+(cuw_b2-cuw_b1)*dtc_s1))) &gt; 0.5 ? 1.0 : 0.0}`" />

      <!-- Period 1 event visibility -->
      <Substitution name="R1_SC0U"  value="`${cuw_cc0Up ? cuw_showC0p2     : 0.0}`" />
      <Substitution name="R1_SC0D"  value="`${cuw_cc0Dn ? cuw_showC0downP2 : 0.0}`" />
      <Substitution name="R1_SC1U"  value="`${cuw_cc1Up ? cuw_showC1p2     : 0.0}`" />
      <Substitution name="R1_SC1D"  value="`${cuw_cc1Dn ? cuw_showC1downP2 : 0.0}`" />
      <Substitution name="R1_SAPEX" value="`${cuw_showOvApex}`" />

      <!-- Colors -->
      <Substitution name="IFX_COLOR_BERRY400" value="#BE3283" />
      <Substitution name="IFX_COLOR_LAWN500"  value="#9BBA43" />
      <Substitution name="IFX_COLOR_ORANGE"   value="#FF8C00" />
      <Substitution name="IFX_COLOR_CC0"      value="#005EB8" />
      <Substitution name="IFX_COLOR_OCEAN500" value="#0A8276" />
      <Substitution name="IFX_COLOR_BLACK"    value="#1D1D1D" />
      <Substitution name="IFX_COLOR_GRAY"     value="#808080" />
      <Substitution name="IFX_COLOR_DT_OUT"   value="#D32F2F" />
      <Substitution name="IFX_COLOR_DT_COMPL" value="#2E7D32" />

      <!-- Period 1 dead-time labels: buffered ("DT_BUFF"/"DT_BUFF_N") only when
           the buffered dead time actually applies (Swapping Enable OFF, shadow
           copy). With Swapping Enable ON the DT buffer has no effect, so Period 1
           uses the active dead time and the tags stay plain "DT"/"DT_N". -->
      <Substitution name="R1_LBL_OUT"  value="`${pDtBuffP2Applies ? &quot;DT_BUFF&quot; : &quot;DT&quot;}`" />
      <Substitution name="R1_LBL_CMPL" value="`${pDtBuffP2Applies ? &quot;DT_BUFF_N&quot; : &quot;DT_N&quot;}`" />
    </ParamImage>
