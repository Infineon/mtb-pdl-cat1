      name="PWM Visualization"
      group="Advanced"
      desc=""
      visible="`${pPwmNePrs}`"
      position="OUTSET"
      default="`${cy_libs_path()}`/device-info/personalities_14.0/svg/pwm_custom_align_v2.svg">

