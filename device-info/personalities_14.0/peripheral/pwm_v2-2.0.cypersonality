      <Member name="killMode" value="`${KillMode}`" />
      <Member name="swapInputMode" value="`${((SwapInput eq CY_TCPWM_INPUT_DISABLED) || (SwapInput eq CY_TCPWM_INPUT_ENABLED)) ? defineInputDisabled : SwapInput}`" />
      <Member name="swapInput" value="`${SwapInput eq CY_TCPWM_INPUT_DISABLED ? &quot;CY_TCPWM_INPUT_0&quot; : SwapInput eq CY_TCPWM_INPUT_ENABLED ? &quot;CY_TCPWM_INPUT_1&quot; : (definePrefix . &quot;_CAPTURE0_VALUE&quot;)}`" />
