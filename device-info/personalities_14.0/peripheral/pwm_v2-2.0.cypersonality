    <!-- Global "Swapping Enable" (swap_enable). It exists for the mxs40tcpwm AND mxs40ppss (PPCA) IP blocks
         (hidden/forced false elsewhere); for the remaining IP blocks it is treated as ON so the per-register
         enables are honored directly (legacy behavior). This gate no longer suppresses the buffered
         visualization - it only selects between the two buffer-transfer semantics (see pAnyPersist below). -->
    <ParamBool id="pSwapEnableEff" name="pSwapEnableEff" desc="pSwapEnableEff" group="Internal" default="`${((&quot;mxs40tcpwm&quot; eq getIpBlockName()) || pPPCABlock) ? swap_enable : true}`" visible="false" editable="false" />
    <!-- The per-register Enable*Swap options drive the buffered visualization REGARDLESS of the global
         "Swapping Enable": whenever an Enable*Swap is set the buffered value is loaded into the active
         register on a TC, so the even displayed periods always show the buffered value. -->
    <ParamBool id="pPeriodSwapEff" name="pPeriodSwapEff" desc="pPeriodSwapEff" group="Internal" default="`${EnablePeriodSwap}`" visible="false" editable="false" />
    <ParamBool id="pCompare0SwapEff" name="pCompare0SwapEff" desc="pCompare0SwapEff" group="Internal" default="`${EnableCompare0Swap}`" visible="false" editable="false" />
    <ParamBool id="pCompare1SwapEff" name="pCompare1SwapEff" desc="pCompare1SwapEff" group="Internal" default="`${EnableCompare1Swap}`" visible="false" editable="false" />
    <!-- Persist mode: global "Swapping Enable" OFF while a per-register Enable*Swap is ON. Without a
         bidirectional swap the buffer is copied to the active register on the first TC and then stays, so
         EVERY displayed period after the first (the odd periods 3/5/7 as well as the even periods) uses the
         buffered value. When the global swap is ON this is false, so the odd periods keep the active
         (regular) value and the buffered value alternates every other period (existing behavior). Non-mxs40
         blocks force pSwapEnableEff true, so pAnyPersist is false there and they keep the legacy alternating
         representation. -->
    <ParamBool id="pAnyPersist" name="pAnyPersist" desc="pAnyPersist" group="Internal" default="`${(!pSwapEnableEff) &amp;&amp; (EnablePeriodSwap || EnableCompare0Swap || EnableCompare1Swap)}`" visible="false" editable="false" />

    <ParamBool id="pEnCAndNEnP" name="pEnCAndNEnP" desc="pEnCAndNEnP" group="Internal" default="`${EnableCompare0Swap &amp;&amp; (!EnablePeriodSwap)}`" visible="false" editable="false" />
    <ParamBool id="pEnCAndEnP" name="pEnCAndEnP" desc="pEnCAndEnP" group="Internal" default="`${EnableCompare0Swap &amp;&amp; EnablePeriodSwap}`" visible="false" editable="false" />
    <ParamBool id="pNEnCOrAssymAndC0GtP1" name="pNEnCOrAssymAndC0GtP1" desc="pNEnCOrAssymAndC0GtP1" group="Internal" default="`${((!EnableCompare0Swap) || pAlignAsymm)&amp;&amp; pC0GtP1}`" visible="false" editable="false" />
    <ParamBool id="pNePrsAndEnCAndEnP" name="pNePrsAndEnCAndEnP" desc="pNePrsAndEnCAndEnP" group="Internal" default="`${pPwmNePrs &amp;&amp; pEnCAndEnP}`" visible="false" editable="false" />

    <!-- Effective Period-2 dead-time values for the shared Dead Time visualization. Unlike the Compare and
         Period buffers, dead time switching is NOT supported by the swap mechanism: the buffered dead time
         (DeadClocksBuff / DeadClocksBuff_compl) is shadow-transferred into the active DT register on a TC
         event only when "Swapping Enable" is UNCHECKED (shadow-copy mode). When swapping is enabled the DT
         buffer has no effect, so the second displayed period keeps the active dead time. Therefore period 2
         shows the buffered dead time when swapping is off and the active dead time when swapping is on -
         the inverse of the Compare/Period swap events. The mxs40tcpwm and mxs40ppss (PPCA) blocks both
         expose "Swapping Enable", so both honor it here; the remaining blocks have no such switch and keep
         the legacy behavior of always showing the buffered value on the second period. -->
    <ParamBool id="pDtBuffP2Applies" name="pDtBuffP2Applies" desc="pDtBuffP2Applies" group="Internal" default="`${((&quot;mxs40tcpwm&quot; eq getIpBlockName()) || pPPCABlock) ? (!swap_enable) : true}`" visible="false" editable="false" />
