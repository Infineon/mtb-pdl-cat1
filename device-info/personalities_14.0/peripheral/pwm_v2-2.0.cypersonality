    <!-- Period-4 (extension) compare reach flags. The trailing partial period shows the wrapped beginning (counts 0..init when counting up), so a compare is crossed there only if it falls within that range. The visible period-4 tail is purely an UP-counting leg, so in asymmetric mode (mode 3) it must reflect the MAIN compare value (cuw_cmp0/cmp1), exactly like the up-legs of the odd periods - NOT the buffered/even value. When not asymmetric it falls back to the even-period (buffered when Enable Compare Swap is set) compare value, matching the period-swap / compare-swap representation; cuw_cmp0e/cmp1e equal cuw_cmp0/cmp1 when swap is off, so behavior is unchanged in that case. -->

    <!-- ===== Period-4 (trailing partial) compare dot placement, anchored to the EXACT ramp endpoints ===== -->
    <!-- The visible period-4 leg is drawn as one straight ramp segment from (cuw_b3, cuw_ryb3) at the boundary counter value to (800, cuw_initY) at the initial counter value. The earlier placement used a full-period offset (compare * 240/period measured from cuw_b3); because cuw_b3 and that offset use INDEPENDENT integer divisions, the dot at compare==init did NOT land exactly on x=800 (the ramp's pinned right end), so the markers drifted off the ramp by the integer-division remainder - a drift that changes with the initial counter value. Period 1 does not have this problem because its dot offset reuses the SAME truncated quantity (cuw_p1w) as its ramp end. Here every period-4 marker is placed by interpolating between the two exact ramp endpoints using the counter fraction, so it always sits on the rendered line for every count direction / init / compare value. In the exact-division cases this reduces to the previous offsets. -->
    <!-- Compare value used for period 4: main only for the asymmetric BIDIRECTIONAL up-leg (swap reverses at each underflow); even/buffered in all other modes AND in the asymmetric shadow-copy (pAnyPersist) case where the buffered compare persists after the first overflow. Matches the reach flags and colours above. -->
    <!-- Pixel span and counter span of the visible period-4 leg (counter goes 0..init counting up / up-down, period..init counting down). The counter span is guarded against zero (period 4 collapses to zero width for some init values; its dots are hidden by the reach flags then). -->
    <!-- Counter distance of each compare from the period-4 boundary start value (0 counting up / up-down, Period counting down). -->
    <!-- Span-anchored pixel offset from cuw_b3 (lands exactly on 800 - cuw_b3 when the compare equals init). -->
    <!-- Dot Y interpolated between the exact ramp endpoints (cuw_ryb3 at the boundary, cuw_initY at x=800) by the same counter fraction, so the marker sits on the rendered line. -->
    <!-- Ordered period-4 waveform offsets (same up-leg ordering as the dots) so the output edges line up with the markers. -->

    <!-- Displayed period 1 starts from the physical power-up level of line_out.
         When the counter begins counting, the line_out latch comes up at its
         inactive level (logical 0 => line_out low, line_compl_out high),
         independent of Count Direction, Overflow/Underflow Action and Kill Line
         Polarity (the kill polarity only drives the output while it is
         killed/disabled, not once counting has started). The configured boundary
         (overflow/underflow) action first takes effect at the END of period 1
         (baked into cuw_p1end), so the settled steady-state start level only
         appears from displayed period 2 onwards. This matches silicon, where the
         first PWM period after start is a transient that always begins low. -->
    <ParamString id="cuw_p1L0" name="cuw_p1L0" group="General" default="`${0}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_p1L1" name="cuw_p1L1" group="General" default="`${cuw_reachedA ? ((cuw_actA eq CY_TCPWM_PWM_ACTION_SET) ? 1 : (cuw_actA eq CY_TCPWM_PWM_ACTION_CLEAR) ? 0 : (cuw_actA eq CY_TCPWM_PWM_ACTION_INVERT) ? (1 - cuw_p1L0) : cuw_p1L0) : cuw_p1L0}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_p1L2" name="cuw_p1L2" group="General" default="`${(pCntCC1 &amp;&amp; cuw_reachedB) ? ((cuw_actB eq CY_TCPWM_PWM_ACTION_SET) ? 1 : (cuw_actB eq CY_TCPWM_PWM_ACTION_CLEAR) ? 0 : (cuw_actB eq CY_TCPWM_PWM_ACTION_INVERT) ? (1 - cuw_p1L1) : cuw_p1L1) : cuw_p1L1}`" visible="false" editable="false" desc="" />
    <!-- Up/Down only: the counter reaches PERIOD at the ramp apex, generating an overflow event. The Overflow Action is applied to the line at the apex (between the up-leg and the down-leg). -->
    <ParamString id="cuw_p1apex" name="cuw_p1apex" group="General" default="`${cuw_isUpDown ? ((OverflowMode eq CY_TCPWM_PWM_ACTION_SET) ? 1 : (OverflowMode eq CY_TCPWM_PWM_ACTION_CLEAR) ? 0 : (OverflowMode eq CY_TCPWM_PWM_ACTION_INVERT) ? (1 - cuw_p1L2) : cuw_p1L2) : cuw_p1L2}`" visible="false" editable="false" desc="" />
    <!-- Up/Down only: down-leg compare matches. Counting back down crosses the higher compare (actB) first, then the lower (actA). In the first displayed period the down sweep covers the whole 0..period range, so both fire regardless of the initial value. The down-leg starts from the post-overflow apex level. -->
    <ParamString id="cuw_p1L3" name="cuw_p1L3" group="General" default="`${cuw_isUpDown ? (cuw_dnReachB ? ((cuw_actBdn eq CY_TCPWM_PWM_ACTION_SET) ? 1 : (cuw_actBdn eq CY_TCPWM_PWM_ACTION_CLEAR) ? 0 : (cuw_actBdn eq CY_TCPWM_PWM_ACTION_INVERT) ? (1 - cuw_p1apex) : cuw_p1apex) : cuw_p1apex) : cuw_p1L2}`" visible="false" editable="false" desc="" />
    <ParamString id="cuw_p1L4" name="cuw_p1L4" group="General" default="`${cuw_isUpDown ? (cuw_dnReachA ? ((cuw_actAdn eq CY_TCPWM_PWM_ACTION_SET) ? 1 : (cuw_actAdn eq CY_TCPWM_PWM_ACTION_CLEAR) ? 0 : (cuw_actAdn eq CY_TCPWM_PWM_ACTION_INVERT) ? (1 - cuw_p1L3) : cuw_p1L3) : cuw_p1L3) : cuw_p1L2}`" visible="false" editable="false" desc="" />
