      <Substitution name="CU_B5" value="`${cuw_b5}`" />
      <Substitution name="CU_B6" value="`${cuw_b6}`" />
      <Substitution name="CU_B7" value="`${cuw_b7}`" />
      <Substitution name="CU_B8" value="`${cuw_b8}`" />
      <Substitution name="CU_RX7" value="`${cuw_rx7}`" />
