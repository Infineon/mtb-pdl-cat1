    <!--Trigger Output DRCs-->
    <DRC type="INFO" text="Trigger 0 Event is enabled but Trigger 0 Signal has no connection." condition="`${!hasConnection(&quot;tr_out0&quot;, 0) &amp;&amp; (trigger0Event ne CY_TCPWM_CNT_TRIGGER_ON_DISABLED)}`" paramId="trigger0Event" />
