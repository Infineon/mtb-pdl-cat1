    <ExposedMember key="Kill0Signal" paramId="kill0SignalPath" />
    <ExposedMember key="Kill1Signal" paramId="kill1SignalPath" />
    <ExposedMember key="ReloadSignal" paramId="reloadSignalPath" />
    <ExposedMember key="StartSignal" paramId="startSignalPath" />
    <ExposedMember key="SwapSignal" paramId="swapSignalPath" />
