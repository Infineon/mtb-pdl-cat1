<PersonalityTemplate id="configuration_export" name="Configuration Export" version="1.0" xmlns="http://cypress.com/xsd/cyhwpersonality_v14">
  <VirtualResourceDefinition ipblock="VirtualResource" type="vres" count="1">
    <VirtualResourceDefinition type="configuration_export" display_name="Configuration Export" display_path="" count="1"/>
  </VirtualResourceDefinition>

  <FittingRules>
    <MappingRules>
      <IpBlock name="VirtualResource" />
      <Resource name="vres\.configuration_export" />
      <DependentResource name="pass.sar" />
    </MappingRules>
  </FittingRules>

  <Parameters>
    <!-- Enable Configuration Export -->
    <ParamBool id="enable_configuration_export" name="Enable Configuration Export" group="Configuration Export" default="false" visible="true" editable="true" desc="Enable generation of configuration_export.json file containing system and peripheral configuration data." />

    <!-- System Clock -->
    <ParamRange id="cpu_clock_hz" name="CPU Clock (Hz)" group="System" default="`${getExposedMember(&quot;srss[0].clock[0].hfclk[0]&quot;, &quot;frequency&quot;)}`" min="0" max="500000000" resolution="1" visible="false" editable="false" desc="CPU system clock frequency in Hz." />

    <!-- CSG0 (Current Steering Generator) Resources -->
    <ParamBool id="csg0_used" name="CSG0 Used" group="Internal" default="`${isBlockUsed(&quot;pass[0].csg[0]&quot;)}`" visible="false" editable="false" desc="Indicates if CSG0 is instantiated." />

    <!-- CSG0 Slices Detection (5 slices available) -->
    <Repeat count="5">
      <ParamString id="csg0_slice$idx_rsc" name="csg0_slice$idx_rsc" group="Internal" default="pass[0].csg[0].slice[$idx]" visible="false" editable="false" desc="" />    
      <ParamBool id="csg0_slice$idx_used" name="csg0_slice$idx_used" group="Internal" default="`${isBlockUsed(csg0_slice$idx_rsc)}`" visible="false" editable="false" desc="" />
    </Repeat>

    <!-- CSG0 Enabled Slices String -->
    <ParamString id="csg0_enabled_slices" name="CSG0 Enabled Slices" group="CSG0" default="`${csg0_used ? ((csg0_slice0_used ? &quot;Slice0&quot; : &quot;&quot;) . (csg0_slice1_used ? (csg0_slice0_used ? &quot;, Slice1&quot; : &quot;Slice1&quot;) : &quot;&quot;) . (csg0_slice2_used ? ((csg0_slice0_used || csg0_slice1_used) ? &quot;, Slice2&quot; : &quot;Slice2&quot;) : &quot;&quot;) . (csg0_slice3_used ? ((csg0_slice0_used || csg0_slice1_used || csg0_slice2_used) ? &quot;, Slice3&quot; : &quot;Slice3&quot;) : &quot;&quot;) . (csg0_slice4_used ? ((csg0_slice0_used || csg0_slice1_used || csg0_slice2_used || csg0_slice3_used) ? &quot;, Slice4&quot; : &quot;Slice4&quot;) : &quot;&quot;)) : &quot;None&quot;}`" visible="false" editable="false" desc="List of enabled CSG slices." />

    <!-- CSG0 DAC Detection - which DAC output is enabled (if any) -->
    <ParamRange id="csg0_dac_output_loc" name="CSG0 DAC Output Location" group="Internal" default="`${csg0_used ? getExposedMember(&quot;pass[0].csg[0]&quot;, &quot;dacOutSelLoc&quot;) : 0}`" min="0" max="5" resolution="1" visible="false" editable="false" desc="DAC output location (0=disabled, 1-5=slice 0-4)." />
    <ParamRange id="csg0_dac_output_slice" name="CSG0 DAC Output Slice" group="CSG0" default="`${csg0_dac_output_loc - 1}`" min="-1" max="4" resolution="1" visible="false" editable="false" desc="DAC slice index (-1 = disabled, 0-4 = slice index)." />
    <ParamBool id="csg0_dac_enabled" name="CSG0 DAC Enabled" group="CSG0" default="`${csg0_used &amp;&amp; (csg0_dac_output_slice &gt;= 0)}`" visible="false" editable="false" desc="Indicates if DAC output is enabled." />

    <!-- CSG0 Comparator Inputs (Pin information) - ONLY actual available properties -->
    <Repeat count="5">
      <ParamString id="csg0_slice$idx_comp_pos_input" name="CSG0 Slice$idx Comparator Pos Input" group="CSG0" default="`${csg0_slice$idx_used ? getExposedMember(&quot;pass[0].csg[0].slice[$idx]&quot;, &quot;compPosInput&quot;) : &quot;N/A&quot;}`" visible="false" editable="false" desc="Comparator positive input selection." />
      <ParamString id="csg0_slice$idx_comp_neg_input" name="CSG0 Slice$idx Comparator Neg Input" group="CSG0" default="`${csg0_slice$idx_used ? getExposedMember(&quot;pass[0].csg[0].slice[$idx]&quot;, &quot;compNegInput&quot;) : &quot;N/A&quot;}`" visible="false" editable="false" desc="Comparator negative input selection." />
    </Repeat>

    <!-- SAR0 (ADC) Resources - Support for multiple architectures (CAT1, XMC7000, etc) -->
    <!-- Auto-detect SAR resource path: HPPASS (PSC3M5), CAT1A (pass[0].saradc[0]), or other -->
    <ParamBool id="sar0_used" name="SAR0 Used" group="Internal" default="`${isBlockUsed(&quot;pass[0].sar[0]&quot;)}`" visible="false" editable="false" desc="Indicates if SAR0 is instantiated." />
    <ParamString id="sar0_resource_path" name="SAR0 Resource Path (Advanced)" group="Internal" default="`${isBlockUsed(&quot;pass[0].sar[0]&quot;) ? &quot;pass[0].sar[0]&quot; : (isBlockUsed(&quot;pass[0].saradc[0].sar[0]&quot;) ? &quot;pass[0].saradc[0].sar[0]&quot; : &quot;&quot;)}`" visible="false" editable="false" desc="Auto-detected SAR resource path. Edit if different for your device (e.g., sar[0], pass[0].sar[0], pass[0].saradc[0].sar[0])." />
    <ParamString id="sar0_vref_select" name="SAR0 VREF Select" group="SAR0" default="`${sar0_used ? getExposedMember(&quot;pass[0].sar[0]&quot;, &quot;vref&quot;) : &quot;CY_HPPASS_SAR_VREF_VDDA&quot;}`" visible="false" editable="false" desc="Reference voltage selection." />
    <ParamRange id="sar0_vref_voltage" name="SAR0 VREF Voltage (mV)" group="SAR0" default="`${sar0_used ? getExposedMember(&quot;pass[0].sar[0]&quot;, &quot;vRefMv&quot;) : 1200}`" min="0" max="33000" resolution="1" visible="false" editable="false" desc="Reference voltage in millivolts." />
    
    <!-- HPPASS SAR Channels Detection (28 channels) -->
    <!-- Creates: sar_ch0_used, sar_ch1_used, ..., sar_ch27_used with channel properties -->
    <Repeat count="28">
      <ParamBool id="sar_ch$idx_used" name="SAR Channel $idx Used" group="Internal" default="`${isBlockUsed(&quot;pass[0].sar[0].ch[$idx]&quot;)}`" visible="false" editable="false" desc="Indicates if SAR channel $idx is instantiated." />
      <ParamString id="sar_ch$idx_name" name="SAR Channel $idx Name" group="SAR_CH$idx" default="`${sar_ch$idx_used ? (hasExposedMember(&quot;pass[0].sar[0].ch[$idx]&quot;, &quot;instName&quot;) ? getExposedMember(&quot;pass[0].sar[0].ch[$idx]&quot;, &quot;instName&quot;) : (&quot;sar_ch_&quot; . $idx)) : (&quot;sar_ch_&quot; . $idx)}`" visible="false" editable="false" desc="SAR channel $idx instance name." />
      <ParamBool id="sar_ch$idx_diff" name="SAR Channel $idx Pseudo-Differential" group="SAR_CH$idx" default="`${sar_ch$idx_used ? getExposedMember(&quot;pass[0].sar[0].ch[$idx]&quot;, &quot;diff&quot;) : false}`" visible="false" editable="false" desc="Pseudo-Differential Enable for channel $idx." />
      <ParamBool id="sar_ch$idx_sign" name="SAR Channel $idx Signed" group="SAR_CH$idx" default="`${sar_ch$idx_used ? getExposedMember(&quot;pass[0].sar[0].ch[$idx]&quot;, &quot;sign&quot;) : false}`" visible="false" editable="false" desc="Result Format (Signed=true/Unsigned=false) for channel $idx." />
      <ParamString id="sar_ch$idx_samp_type" name="SAR Channel $idx Sampler Type" group="SAR_CH$idx" default="`${($idx &gt;= 12) ? &quot;muxed_sampler&quot; : &quot;dir_sampler&quot;}`" visible="false" editable="false" desc="Derived sampler type for channel $idx." />
      <ParamRange id="sar_ch$idx_samp_inst" name="SAR Channel $idx Sampler Inst" group="SAR_CH$idx" default="`${($idx &gt;= 12) ? (($idx - 12)/4) : $idx}`" min="0" max="27" resolution="1" visible="false" editable="false" desc="Derived sampler index for channel $idx." />
      <ParamString id="sar_ch$idx_dir_sampler_name" name="SAR Channel $idx Direct Sampler Name" group="SAR_CH$idx" default="`${($idx &lt; 12) ? ((hasExposedMember(&quot;pass[0].sar[0].dir_sampler[$idx]&quot;, &quot;instName&quot;) &amp;&amp; (getExposedMember(&quot;pass[0].sar[0].dir_sampler[$idx]&quot;, &quot;instName&quot;) ne &quot;&quot;)) ? getExposedMember(&quot;pass[0].sar[0].dir_sampler[$idx]&quot;, &quot;instName&quot;) : ((hasExposedMember(&quot;pass[0].sar[0].dir_sampler[$idx]&quot;, &quot;name&quot;) &amp;&amp; (getExposedMember(&quot;pass[0].sar[0].dir_sampler[$idx]&quot;, &quot;name&quot;) ne &quot;&quot;)) ? getExposedMember(&quot;pass[0].sar[0].dir_sampler[$idx]&quot;, &quot;name&quot;) : (&quot;pass_0_sar_0_dir_sampler_&quot; . $idx))) : &quot;&quot;}`" visible="false" editable="false" desc="Direct sampler name for channel $idx." />
      <ParamString id="sar_ch$idx_mux_sampler_name" name="SAR Channel $idx Muxed Sampler Name" group="SAR_CH$idx" default="`${($idx &gt;= 12) ? ((hasExposedMember(&quot;pass[0].sar[0].muxed_sampler[&quot; . sar_ch$idx_samp_inst . &quot;]&quot;, &quot;instName&quot;) &amp;&amp; (getExposedMember(&quot;pass[0].sar[0].muxed_sampler[&quot; . sar_ch$idx_samp_inst . &quot;]&quot;, &quot;instName&quot;) ne &quot;&quot;)) ? getExposedMember(&quot;pass[0].sar[0].muxed_sampler[&quot; . sar_ch$idx_samp_inst . &quot;]&quot;, &quot;instName&quot;) : ((hasExposedMember(&quot;pass[0].sar[0].muxed_sampler[&quot; . sar_ch$idx_samp_inst . &quot;]&quot;, &quot;name&quot;) &amp;&amp; (getExposedMember(&quot;pass[0].sar[0].muxed_sampler[&quot; . sar_ch$idx_samp_inst . &quot;]&quot;, &quot;name&quot;) ne &quot;&quot;)) ? getExposedMember(&quot;pass[0].sar[0].muxed_sampler[&quot; . sar_ch$idx_samp_inst . &quot;]&quot;, &quot;name&quot;) : (&quot;pass_0_sar_0_muxed_sampler_&quot; . sar_ch$idx_samp_inst))) : &quot;&quot;}`" visible="false" editable="false" desc="Muxed sampler name for channel $idx." />
      <ParamString id="sar_ch$idx_sampler" name="SAR Channel $idx Sampler" group="SAR_CH$idx" default="`${sar_ch$idx_used ? (($idx &gt;= 12) ? sar_ch$idx_mux_sampler_name : sar_ch$idx_dir_sampler_name) : &quot;&quot;}`" visible="false" editable="false" desc="Sampler instance name for channel $idx." />
    </Repeat>

    <!-- SAR Enabled Channels String for JSON export -->
    <ParamString id="sar_enabled_channels_list" name="SAR Enabled Channels" group="Internal" default="`${isBlockUsed(&quot;pass[0].sar[0]&quot;) ? &quot;Auto-detected from HPPASS config&quot; : &quot;&quot;}`" visible="false" editable="false" desc="HPPASS SAR enabled channels auto-detected from Device Configurator." />

    <!-- SAR Sequencer Groups Detection (8 groups available) -->
    <Repeat count="8">
      <ParamString id="sar_grp$idx_rsc" name="sar_grp$idx_rsc" group="Internal" default="pass[0].sar[0].seq[0].grp[$idx]" visible="false" editable="false" desc="" />
      <ParamBool id="sar_grp$idx_used" name="sar_grp$idx_used" group="Internal" default="`${isBlockUsed(sar_grp$idx_rsc)}`" visible="false" editable="false" desc="" />
      <ParamString id="sar_grp$idx_name" name="SAR Group $idx Name" group="SAR_GRP$idx" default="`${sar_grp$idx_used ? (hasExposedMember(&quot;pass[0].sar[0].seq[0].grp[$idx]&quot;, &quot;instName&quot;) ? getExposedMember(&quot;pass[0].sar[0].seq[0].grp[$idx]&quot;, &quot;instName&quot;) : (&quot;sar_grp_&quot; . $idx)) : (&quot;sar_grp_&quot; . $idx)}`" visible="false" editable="false" desc="SAR group $idx instance name." />
    </Repeat>

    <!-- Detect if any SAR channel is used -->
    <ParamBool id="sar_any_channel_used" name="SAR Any Channel Used" group="Internal" default="`${sar0_used || sar_ch0_used || sar_ch1_used || sar_ch2_used || sar_ch3_used || sar_ch4_used || sar_ch5_used || sar_ch6_used || sar_ch7_used || sar_ch8_used || sar_ch9_used || sar_ch10_used || sar_ch11_used || sar_ch12_used || sar_ch13_used || sar_ch14_used || sar_ch15_used || sar_ch16_used || sar_ch17_used || sar_ch18_used || sar_ch19_used || sar_ch20_used || sar_ch21_used || sar_ch22_used || sar_ch23_used || sar_ch24_used || sar_ch25_used || sar_ch26_used || sar_ch27_used}`" visible="false" editable="false" desc="Indicates if any SAR or SAR channel is used." />

    <!-- Hall Sensor (MOTIF) Resources - TCPWM MOTIF - Search in all groups -->
    <Repeat count="4">
      <ParamBool id="hallsensor_group$idx_used" name="hallsensor_group$idx_used" group="Internal" default="`${isBlockUsed(&quot;tcpwm[0].group[$idx].motif[0]&quot;)}`" visible="false" editable="false" desc="" />
    </Repeat>

    <!-- Detect which group has Hall Sensor and get resource path -->
    <ParamString id="hallsensor_resource_path" name="hallsensor_resource_path" group="Internal" default="`${(hallsensor_group0_used &amp;&amp; hasExposedMember(&quot;tcpwm[0].group[0].motif[0]&quot;, &quot;hallInput1Pin&quot;)) ? &quot;tcpwm[0].group[0].motif[0]&quot; : ((hallsensor_group1_used &amp;&amp; hasExposedMember(&quot;tcpwm[0].group[1].motif[0]&quot;, &quot;hallInput1Pin&quot;)) ? &quot;tcpwm[0].group[1].motif[0]&quot; : ((hallsensor_group2_used &amp;&amp; hasExposedMember(&quot;tcpwm[0].group[2].motif[0]&quot;, &quot;hallInput1Pin&quot;)) ? &quot;tcpwm[0].group[2].motif[0]&quot; : ((hallsensor_group3_used &amp;&amp; hasExposedMember(&quot;tcpwm[0].group[3].motif[0]&quot;, &quot;hallInput1Pin&quot;)) ? &quot;tcpwm[0].group[3].motif[0]&quot; : &quot;&quot;)))}`" visible="false" editable="false" desc="" />

    <ParamBool id="hallsensor_used" name="Hall Sensor Used" group="Internal" default="`${(hallsensor_group0_used &amp;&amp; hasExposedMember(&quot;tcpwm[0].group[0].motif[0]&quot;, &quot;hallInput1Pin&quot;)) || (hallsensor_group1_used &amp;&amp; hasExposedMember(&quot;tcpwm[0].group[1].motif[0]&quot;, &quot;hallInput1Pin&quot;)) || (hallsensor_group2_used &amp;&amp; hasExposedMember(&quot;tcpwm[0].group[2].motif[0]&quot;, &quot;hallInput1Pin&quot;)) || (hallsensor_group3_used &amp;&amp; hasExposedMember(&quot;tcpwm[0].group[3].motif[0]&quot;, &quot;hallInput1Pin&quot;))}`" visible="false" editable="false" desc="Indicates if Hall Sensor personality is instantiated in any MOTIF group." />

    <!-- Hall Sensor Configuration -->
    <ParamString id="hallsensor_mode" name="Hall Sensor Mode" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;mode&quot;) : &quot;Unknown&quot;}`" visible="false" editable="false" desc="Multi-Channel Pattern (Hall) operating mode." />
    <ParamBool id="hallsensor_enable" name="Hall Sensor Enable" group="Hall Sensor" default="`${hallsensor_used}`" visible="false" editable="false" desc="Hall Sensor block is present in design." />
    <ParamString id="hallsensor_input1_pin" name="Hall Sensor Input 1 Pin" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;hallInput1Pin&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="Hall Input 1 pin resource path." />
    <ParamString id="hallsensor_input2_pin" name="Hall Sensor Input 2 Pin" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;hallInput2Pin&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="Hall Input 2 pin resource path." />
    <ParamString id="hallsensor_input3_pin" name="Hall Sensor Input 3 Pin" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;hallInput3Pin&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="Hall Input 3 pin resource path." />
    <ParamString id="hallsensor_input_sample_delay_pin" name="Hall Sensor Input Sample Delay Pin" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;hallSampleDelayPin&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="Hall pattern sample delay pin resource path." />
    <ParamString id="hallsensor_input_external_wrong_event_pin" name="Hall Sensor Input External Wrong Event Pin" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;hallExternalWrongEventPin&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="External wrong hall event input pin resource path." />
    <ParamString id="hallsensor_input_mcp_next_pattern_pin" name="Hall Sensor Input MCP Next Pattern Pin" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;hallMcpNextPatternPin&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="MCP next pattern update input pin resource path." />
    <ParamString id="hallsensor_input_mcp_sync_pin" name="Hall Sensor Input MCP Sync Pin" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;hallMcpSyncPin&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="MCP pattern update synchronization input pin resource path." />
    <ParamString id="hallsensor_tcpwm_version" name="Hall Sensor TCPWM Version" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;TCPWM_version&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="TCPWM hardware version from Hall Sensor personality." />
    <ParamString id="hallsensor_mcp_mode" name="Hall Sensor MCP Mode" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;mcp_mode&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="Multi Channel Pattern mode." />
    <ParamString id="hallsensor_low_pass_filter" name="Hall Sensor Low Pass Filter" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;LowPassFilter&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="Low pass filter setting." />
    <ParamBool id="hallsensor_ppcompare" name="Hall Sensor Previous Pattern Compare" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;ppcompare&quot;) : false}`" visible="false" editable="false" desc="Previous pattern compare enable." />
    <ParamString id="hallsensor_correct_event_selection" name="Hall Sensor Correct Event Selection" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;correct_event_selection&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="Correct event selection mode." />
    <ParamString id="hallsensor_fault_event_selection" name="Hall Sensor Fault Event Selection" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;fault_event_selection&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="Fault event selection mode." />
    <ParamBool id="hallsensor_sync_bypass" name="Hall Sensor Sync Bypass" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;sync_bypass&quot;) : false}`" visible="false" editable="false" desc="Sync bypass setting." />
    <ParamBool id="hallsensor_delay_bypass" name="Hall Sensor Delay Bypass" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;delay_bypass&quot;) : false}`" visible="false" editable="false" desc="Delay bypass setting." />
    <ParamBool id="hallsensor_debounce_bypass" name="Hall Sensor Debounce Bypass" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;debounce_bypass&quot;) : false}`" visible="false" editable="false" desc="Debounce bypass setting." />
    <ParamBool id="hallsensor_fault_clear" name="Hall Sensor Fault Clear" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;fault_clear&quot;) : false}`" visible="false" editable="false" desc="Clear MCP on hall fault." />
    <ParamBool id="hallsensor_ewhe_emulation" name="Hall Sensor EWHE Emulation" group="Hall Sensor" default="`${hallsensor_used ? (getExposedMember(hallsensor_resource_path, &quot;ewhe_emulation&quot;) &amp;&amp; (getExposedMember(hallsensor_resource_path, &quot;hallExternalWrongEventPin&quot;) ne &quot;&quot;)) : false}`" visible="false" editable="false" desc="External wrong hall event emulation." />
    <ParamBool id="hallsensor_ewhe_level_selector" name="Hall Sensor EWHE Level Selector" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;ewhe_level_selector&quot;) : false}`" visible="false" editable="false" desc="EWHE level selector." />
    <ParamString id="hallsensor_sampling_trigger_edge_mode" name="Hall Sensor Sampling Trigger Edge Mode" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;sampling_trigger_edge_mode&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="Sampling trigger edge mode." />
    <ParamString id="hallsensor_mset_trigger_edge_mode" name="Hall Sensor MSET Trigger Edge Mode" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;mset_trigger_edge_mode&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="MSET trigger edge mode." />
    <ParamString id="hallsensor_msync_trigger_edge_mode" name="Hall Sensor MSYNC Trigger Edge Mode" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;msync_trigger_edge_mode&quot;) : &quot;&quot;}`" visible="false" editable="false" desc="MSYNC trigger edge mode." />
    <ParamBool id="hallsensor_lut_enable" name="Hall Sensor LUT Enable" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;lut_enable&quot;) : false}`" visible="false" editable="false" desc="LUT mode enabled." />
    <ParamRange id="hallsensor_hlut_data_pos0" name="Hall Sensor Hall LUT Data 0" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;hlut_data_pos0&quot;) : 0}`" min="0" max="4294967295" resolution="1" visible="false" editable="false" desc="Hall LUT data position 0." />
    <ParamRange id="hallsensor_hlut_data_pos1" name="Hall Sensor Hall LUT Data 1" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;hlut_data_pos1&quot;) : 0}`" min="0" max="4294967295" resolution="1" visible="false" editable="false" desc="Hall LUT data position 1." />
    <ParamRange id="hallsensor_hlut_data_pos2" name="Hall Sensor Hall LUT Data 2" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;hlut_data_pos2&quot;) : 0}`" min="0" max="4294967295" resolution="1" visible="false" editable="false" desc="Hall LUT data position 2." />
    <ParamRange id="hallsensor_hlut_data_pos3" name="Hall Sensor Hall LUT Data 3" group="Hall Sensor" default="`${hallsensor_used ? getExposedMember(hallsensor_resource_path, &quot;hlut_data_pos3&quot;) : 0}`" min="0" max="4294967295" resolution="1" visible="false" editable="false" desc="Hall LUT data position 3." />
