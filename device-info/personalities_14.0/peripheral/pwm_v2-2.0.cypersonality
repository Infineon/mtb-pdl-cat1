      <Member name="compare3" value="`${pCntCC1 ? (pHrpwmActive ? (Compare3 * pHrpwmElements + Compare3_hrpwm) : Compare3) : &quot;CY_TCPWM_GRP_CNT_CC0_BUFF_DEFAULT&quot;}`" />
      <Member name="enableCompare1Swap" value="`${EnableCompare1Swap}`" />
      <Member name="compare0MatchUp" value="`${(PwmAlignment eq CY_TCPWM_PWM_CUSTOM_ALIGN) ? ((Cc0MatchEnable eq 1) || (Cc0MatchEnable eq 3)) : Compare0MatchUp}`" />
      <Member name="compare0MatchDown" value="`${(PwmAlignment eq CY_TCPWM_PWM_CUSTOM_ALIGN) ? ((Cc0MatchEnable eq 2) || (Cc0MatchEnable eq 3)) : Compare0MatchDown}`" />
      <Member name="compare1MatchUp" value="`${(PwmAlignment eq CY_TCPWM_PWM_CUSTOM_ALIGN) ? ((Cc1MatchEnable eq 1) || (Cc1MatchEnable eq 3)) : Compare1MatchUp}`" />
